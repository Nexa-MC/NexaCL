/* Default primitive presentation. Product styles override these defaults. */
Button { Weight: 0; HorizontalAlignment: Stretch; VerticalAlignment: Stretch; TransitionOffsetX: 0; TransitionOffsetY: 0; }
ContentHost { Weight: 0; HorizontalAlignment: Stretch; VerticalAlignment: Stretch; TransitionOffsetX: 0; TransitionOffsetY: 0; }
Dialog { Weight: 0; HorizontalAlignment: Stretch; VerticalAlignment: Stretch; Orientation: Vertical; Spacing: 0; }
HorizontalPager { Weight: 0; HorizontalAlignment: Stretch; VerticalAlignment: Stretch; }
Image { Weight: 0; HorizontalAlignment: Stretch; VerticalAlignment: Stretch; }
Navigation { Width: 48; Weight: 0; HorizontalAlignment: Stretch; VerticalAlignment: Stretch; Orientation: Vertical; Spacing: 6; }
NavigationItem { Height: 42; Weight: 0; HorizontalAlignment: Stretch; VerticalAlignment: Stretch; }
Notification { Weight: 0; HorizontalAlignment: Stretch; VerticalAlignment: Stretch; Orientation: Horizontal; Spacing: 0; }
Page { Weight: 0; HorizontalAlignment: Stretch; VerticalAlignment: Stretch; }
Progress { Weight: 0; HorizontalAlignment: Stretch; VerticalAlignment: Stretch; }
Shell { Weight: 0; HorizontalAlignment: Stretch; VerticalAlignment: Stretch; Orientation: Vertical; Spacing: 0; }
StackPanel { Weight: 0; HorizontalAlignment: Stretch; VerticalAlignment: Stretch; Orientation: Vertical; Spacing: 0; TransitionOffsetX: 0; TransitionOffsetY: 0; }
Text { Weight: 0; HorizontalAlignment: Stretch; VerticalAlignment: Stretch; TransitionOffsetX: 0; TransitionOffsetY: 0; }
TextInput { Height: 40; Weight: 0; }
TitleBar { Height: 52; Weight: 0; HorizontalAlignment: Stretch; VerticalAlignment: Stretch; TransitionOffsetX: 0; TransitionOffsetY: 0; Orientation: Horizontal; Spacing: 0; }
VerticalPager { Weight: 0; HorizontalAlignment: Stretch; VerticalAlignment: Stretch; }
