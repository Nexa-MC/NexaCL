<Project>
  <PropertyGroup>
    <IsAotCompatible>true</IsAotCompatible>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NativeLib>Shared</NativeLib>
    <NexaAutomaticFunctionPatches>true</NexaAutomaticFunctionPatches>
    <NexaLocalPatchRuntime>true</NexaLocalPatchRuntime>
    <DefineConstants>$(DefineConstants);NEXA_NATIVE_ENGINE</DefineConstants>
    <Version>1.0.0</Version>
    <InformationalVersion>1.0.0</InformationalVersion>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <!-- A Host-only commit must not rewrite an unchanged engine's binary/debug identity. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <EnableSourceLink>false</EnableSourceLink>
    <EnableSourceControlManagerQueries>false</EnableSourceControlManagerQueries>
    <EmbedUntrackedSources>false</EmbedUntrackedSources>
    <PublishRepositoryUrl>false</PublishRepositoryUrl>
    <NexaEngineSourceRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..'))/</NexaEngineSourceRoot>
    <PathMap>$(NexaEngineSourceRoot)=/_/</PathMap>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)NativeInstrumentation.cs" Link="Instrumentation/NativeInstrumentation.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)../Nexa.Core/Patching/Patch.cs" Link="Instrumentation/Patch.cs" />
    <AssemblyMetadata Include="Nexa.NativeEngineAbi" Value="1" />
    <SourceRoot Include="$(NexaEngineSourceRoot)" MappedPath="/_/" />
  </ItemGroup>
  <Target Name="ConfigureDeterministicNativeEngineLink" BeforeTargets="LinkNative" Condition="'$(PublishAot)' == 'true' and '$(_targetOS)' == 'win'">
    <ItemGroup>
      <LinkerArg Include="/Brepro" />
      <LinkerArg Include="/PDBALTPATH:%_PDB%" />
    </ItemGroup>
  </Target>
</Project>
