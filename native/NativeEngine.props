<Project>
  <PropertyGroup>
    <IsAotCompatible>true</IsAotCompatible>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NativeLib>Shared</NativeLib>
    <NexaAutomaticFunctionPatches>true</NexaAutomaticFunctionPatches>
    <NexaLocalPatchRuntime>true</NexaLocalPatchRuntime>
    <DefineConstants>$(DefineConstants);NEXA_NATIVE_ENGINE</DefineConstants>
    <Version>1.0.0</Version>
    <InformationalVersion>1.0.0</InformationalVersion>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <!-- A Host-only commit must not rewrite an unchanged engine's binary/debug identity. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <EnableSourceLink>false</EnableSourceLink>
    <EnableSourceControlManagerQueries>false</EnableSourceControlManagerQueries>
    <EmbedUntrackedSources>false</EmbedUntrackedSources>
    <PublishRepositoryUrl>false</PublishRepositoryUrl>
    <NexaEngineSourceRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..'))/</NexaEngineSourceRoot>
    <PathMap>$(NexaEngineSourceRoot)=/_/</PathMap>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)NativeInstrumentation.cs" Link="Instrumentation/NativeInstrumentation.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)../Nexa.Core/Patching/Patch.cs" Link="Instrumentation/Patch.cs" />
    <AssemblyMetadata Include="Nexa.NativeEngineAbi" Value="1" />
    <SourceRoot Include="$(NexaEngineSourceRoot)" MappedPath="/_/" />
  </ItemGroup>
  <Target Name="ConfigureDeterministicNativeEngineLink" BeforeTargets="LinkNative" Condition="'$(PublishAot)' == 'true'">
    <ItemGroup>
      <LinkerArg Include="/Brepro" Condition="'$(_targetOS)' == 'win'" />
      <LinkerArg Include="/PDBALTPATH:%_PDB%" Condition="'$(_targetOS)' == 'win'" />
      <LinkerArg Include="-Wl,-reproducible" Condition="'$(_targetOS)' == 'osx'" />
      <!-- Reuse the ordinary objc_msgSend stub instead of emitting a duplicate, tie-ordered GOT entry. -->
      <LinkerArg Include="-Wl,-objc_stubs_small" Condition="'$(_targetOS)' == 'osx' and '$(_targetArchitecture)' == 'arm64'" />
    </ItemGroup>
  </Target>
  <!-- Match LinkNative's incremental condition: do not delete symbols when linking is skipped. -->
  <Target Name="ResetNativeEnginePdbBeforeRelink" BeforeTargets="LinkNative"
          Inputs="$(NativeObject);@(NativeLibrary)" Outputs="$(NativeBinary)"
          Condition="'$(PublishAot)' == 'true' and '$(_targetOS)' == 'win'">
    <Delete Files="$([System.IO.Path]::ChangeExtension('$(NativeBinary)', '.pdb'))" />
  </Target>
</Project>
