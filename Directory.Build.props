<Project>
  <PropertyGroup>
    <NexaRepositoryRoot>$(MSBuildThisFileDirectory)</NexaRepositoryRoot>
    <NexaSourceRoot>$([MSBuild]::NormalizeDirectory('$(NexaRepositoryRoot)', 'src'))</NexaSourceRoot>
    <NexaProductSource Condition="$([System.String]::Copy('$(MSBuildProjectDirectory)').StartsWith('$(NexaSourceRoot)'))">true</NexaProductSource>
    <NexaRenderingRoot>$([MSBuild]::NormalizeDirectory('$(NexaSourceRoot)', 'rendering'))</NexaRenderingRoot>
    <NexaRenderingSource Condition="$([System.String]::Copy('$(MSBuildProjectDirectory)').StartsWith('$(NexaRenderingRoot)'))">true</NexaRenderingSource>
  </PropertyGroup>
  <Import Project="$(MSBuildThisFileDirectory)eng/xsr/Xsr.Version.props" />

  <PropertyGroup>
    <DefineConstants Condition="'$(NexaNativeServices)' == 'true'">$(DefineConstants);NEXA_NATIVE_SERVICES</DefineConstants>
    <TargetFramework Condition="'$(TargetFramework)' == ''">net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
</Project>
