<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>Nexa.Bootstrap</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <OptimizationPreference>Size</OptimizationPreference>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationIcon>../Nexa.Desktop/Assets/icon.ico</ApplicationIcon>
    <Description>Native bootstrap for the Nexa Host module.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Nexa.Core/Nexa.Core.csproj" />
  </ItemGroup>
</Project>
