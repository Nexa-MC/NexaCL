using System.Runtime.CompilerServices;
using Nexa.Core.Patching;
using Nexa.Xsr;
using Nexa.Xsr.Runtime;
using Nexa.Xsr.State;
using Nexa.Sidecar.Host;
using Nexa.Sidecar.Host.Data;
using Nexa.Sidecar.Transport;
using Nexa.Sidecar.Protocol;
using Nexa.Xsr.Renderer.Nxml;

await Check.Run();
Console.WriteLine("PASS: package consumer routes/state/catalogs/automatic-patch install-retire");

static class Check
{
    [MethodImpl(MethodImplOptions.NoInlining)]
    public static int Add(int a, int b) => a + b;
    public static async Task Run()
    {
        var nxml = new NxmlExtensionProgram("page.nxml", new Dictionary<string, string>
        {
            ["page.nxml"] = "<Page Key=\"ConsumerPage\"><StackPanel><Text Content=\"{data title}\" /><Button Key=\"Save\" Content=\"Save\" Command=\"consumer.save\" /></StackPanel></Page>"
        }).Compile(new Dictionary<string, string> { ["title"] = "Package-only view" });
        if (nxml.Root.Root.Key != "ConsumerPage" || nxml.Commands.Single().Value != "consumer.save") throw new Exception("NXML assets or compiler missing");
        var form = SidecarUiForms.Decode(SidecarUiForms.Encode("save", new Dictionary<string, string> { ["draft"] = "package input" }));
        if (form.Fields.Single().Key != "draft") throw new Exception("form codec missing");
        // A package-only client must instantiate without service implementation assemblies,
        // and cannot invoke any Host operation before authenticated discovery.
        using var requests = new SidecarHostRequestClient((_, _) => throw new Exception("Unexpected IPC before discovery"));
        var business = new SidecarBusinessClient(requests, new Observer());
        if (!business.Commands.TryResolve(MinecraftLibraryRoutes.Select, out var select)) throw new Exception("client route missing");
        var rejected = await business.Commands.Dispatch(select, new MinecraftLibrarySelectCommand("/games", "test")).Completion;
        if (rejected.Error?.Code.Value != "xsr.route_not_found") throw new Exception("undiscovered client accepted call");
        var effects = new SidecarEffectsClient(requests, new Observer());
        if (!effects.Commands.TryResolve(Nexa.Sidecar.Host.Effects.Data.SidecarEffectsRoutes.AccountRefresh, out var refresh)) throw new Exception("effects route missing");
        var denied = await effects.Commands.Dispatch(refresh, new Nexa.Sidecar.Host.Effects.Data.HostAccountRequest(0, 1)).Completion;
        if (denied.Error?.Code.Value != "xsr.route_not_found") throw new Exception("undiscovered effects accepted call");
        var presentation = new SidecarPresentationClient(requests, new Observer());
        if (!presentation.Commands.TryResolve(Nexa.Sidecar.Host.Presentation.Data.SidecarPresentationRoutes.Replace, out var replace)) throw new Exception("presentation route missing");
        var hidden = await presentation.Commands.Dispatch(replace, new Nexa.Sidecar.Host.Presentation.Data.HostPresentationReplace(0, [])).Completion;
        if (hidden.Error?.Code.Value != "xsr.route_not_found") throw new Exception("undiscovered presentation accepted call");
        var shell = new SidecarShellClient(requests, new Observer());
        if (!shell.Queries.TryResolve(Nexa.Sidecar.Host.Shell.Data.SidecarShellRoutes.Displays, out var displays)) throw new Exception("shell route missing");
        if ((await shell.Queries.QueryAsync<Nexa.Sidecar.Host.Shell.Data.HostShellEmpty, Nexa.Sidecar.Host.Shell.Data.HostDisplays>(displays, new())).IsSuccess) throw new Exception("undiscovered shell admitted");
        var themeOptions = new SidecarThemeOptionsClient(requests, new Observer());
        if (!themeOptions.Commands.TryResolve(Nexa.Sidecar.Host.ThemeOptions.Data.SidecarThemeOptionsRoutes.Reset, out var resetOptions)) throw new Exception("theme options route missing");
        if ((await themeOptions.Commands.Dispatch(resetOptions, new Nexa.Sidecar.Host.ThemeOptions.Data.ThemeOptionsResetCommand("builtin", 0)).Completion).IsSuccess) throw new Exception("undiscovered theme options admitted");
        var decisions = new SidecarConfirmationClient(requests, new Observer());
        if (!decisions.Queries.TryResolve(Nexa.Sidecar.Host.Confirmation.Data.SidecarConfirmationRoutes.Ask, out var askDecision)) throw new Exception("confirmation route missing");
        if ((await decisions.Queries.QueryAsync<Nexa.Sidecar.Host.Confirmation.Data.HostConfirmationRequest, Nexa.Sidecar.Host.Confirmation.Data.HostConfirmationDecision>(askDecision, new("Test", [65]))).IsSuccess) throw new Exception("undiscovered confirmation admitted");
        var pages = new SidecarPageControlClient(requests, new Observer());
        if (!pages.Commands.TryResolve(Nexa.Sidecar.Host.PageControl.Data.SidecarPageControlRoutes.Open, out var openPage)) throw new Exception("page-control route missing");
        if ((await pages.Commands.Dispatch(openPage, new Nexa.Sidecar.Host.PageControl.Data.HostPageChange(0, 0)).Completion).IsSuccess) throw new Exception("undiscovered page control admitted");
        var viewState = new SidecarViewStateClient(requests, new Observer());
        if (!viewState.Commands.TryResolve(Nexa.Sidecar.Host.ViewState.Data.SidecarViewStateRoutes.Replace, out var setView)) throw new Exception("view-state route missing");
        var undiscovered = await viewState.Commands.Dispatch(setView, new Nexa.Sidecar.Host.ViewState.Data.HostViewReplace(0, [], [])).Completion;
        if (undiscovered.Error?.Code.Value != "xsr.route_not_found") throw new Exception("undiscovered view-state accepted call");
        if (Add(1, 2) != 3) throw new Exception("original");
        var target = Patch.Catalog.Single(x => x.Signature.Contains("Check::Add``", StringComparison.Ordinal));
        if (target.Status != PatchTargetStatus.Instrumented) throw new Exception("not instrumented");
        using (Patch.Install(target, PatchPhase.Return, frame => frame.Result = 99))
            if (Add(1, 2) != 99) throw new Exception("patch not applied");
        if (Add(1, 2) != 3) throw new Exception("patch not retired");

        var gate = new TaskCompletionSource(TaskCreationOptions.RunContinuationsAsynchronously);
        var builder = new XsrCommandRouterBuilder();
        var name = XsrSemanticId.Parse("packages.probe.command");
        var states = new XsrStateStoreBuilder();
        states.Cell<int>(name, "Probe");
        var store = states.Build();
        var state = store.Resolve(name);
        builder.Register<int>(name, async (value, ct) =>
        {
            await gate.Task.WaitAsync(ct);
            store.Publish(state, value);
            return XsrResult.Success();
        });
        var router = builder.Build(new Observer());
        if (!router.TryResolve(name, out var id)) throw new Exception("route missing");
        var pending = router.Dispatch(id, 42);
        if (!pending.Acceptance.IsSuccess || pending.Completion.IsCompleted || store.Read<int>(state).HasValue)
            throw new Exception("acceptance not separate");
        gate.SetResult();
        if (!(await pending.Completion.WaitAsync(TimeSpan.FromSeconds(10))).IsSuccess) throw new Exception("completion");
        store.MarkAvailability(state, XsrStateAvailability.Stale);
        if (store.Read<int>(state).Value != 42 || store.Read<int>(state).Availability != XsrStateAvailability.Stale)
            throw new Exception("stale semantics");
    }
}
sealed class Observer : IXsrDispatchObserver { public void OnCompleted(XsrDispatchObservation observation) { } }
