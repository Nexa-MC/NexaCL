using System.Runtime.CompilerServices;
using Nexa.Core.Patching;
using Nexa.Xsr;
using Nexa.Xsr.Runtime;
using Nexa.Xsr.State;
using Nexa.Sidecar.Host;
using Nexa.Sidecar.Host.Data;
using Nexa.Sidecar.Transport;

await Check.Run();
Console.WriteLine("PASS: package consumer routes/state/catalogs/automatic-patch install-retire");

static class Check
{
    [MethodImpl(MethodImplOptions.NoInlining)]
    public static int Add(int a, int b) => a + b;
    public static async Task Run()
    {
        // A package-only client must instantiate without service implementation assemblies,
        // and cannot invoke any Host operation before authenticated discovery.
        using var requests = new SidecarHostRequestClient((_, _) => throw new Exception("Unexpected IPC before discovery"));
        var business = new SidecarBusinessClient(requests, new Observer());
        if (!business.Commands.TryResolve(MinecraftLibraryRoutes.Select, out var select)) throw new Exception("client route missing");
        var rejected = await business.Commands.Dispatch(select, new MinecraftLibrarySelectCommand("/games", "test")).Completion;
        if (rejected.Error?.Code.Value != "xsr.route_not_found") throw new Exception("undiscovered client accepted call");
        var effects = new SidecarEffectsClient(requests, new Observer());
        if (!effects.Commands.TryResolve(Nexa.Sidecar.Host.Effects.Data.SidecarEffectsRoutes.AccountRefresh, out var refresh)) throw new Exception("effects route missing");
        var denied = await effects.Commands.Dispatch(refresh, new Nexa.Sidecar.Host.Effects.Data.HostAccountRequest(0, 1)).Completion;
        if (denied.Error?.Code.Value != "xsr.route_not_found") throw new Exception("undiscovered effects accepted call");
        if (Add(1, 2) != 3) throw new Exception("original");
        var target = Patch.Catalog.Single(x => x.Signature.Contains("Check::Add``", StringComparison.Ordinal));
        if (target.Status != PatchTargetStatus.Instrumented) throw new Exception("not instrumented");
        using (Patch.Install(target, PatchPhase.Return, frame => frame.Result = 99))
            if (Add(1, 2) != 99) throw new Exception("patch not applied");
        if (Add(1, 2) != 3) throw new Exception("patch not retired");

        var gate = new TaskCompletionSource(TaskCreationOptions.RunContinuationsAsynchronously);
        var builder = new XsrCommandRouterBuilder();
        var name = XsrSemanticId.Parse("packages.probe.command");
        var states = new XsrStateStoreBuilder();
        states.Cell<int>(name, "Probe");
        var store = states.Build();
        var state = store.Resolve(name);
        builder.Register<int>(name, async (value, ct) =>
        {
            await gate.Task.WaitAsync(ct);
            store.Publish(state, value);
            return XsrResult.Success();
        });
        var router = builder.Build(new Observer());
        if (!router.TryResolve(name, out var id)) throw new Exception("route missing");
        var pending = router.Dispatch(id, 42);
        if (!pending.Acceptance.IsSuccess || pending.Completion.IsCompleted || store.Read<int>(state).HasValue)
            throw new Exception("acceptance not separate");
        gate.SetResult();
        if (!(await pending.Completion.WaitAsync(TimeSpan.FromSeconds(10))).IsSuccess) throw new Exception("completion");
        store.MarkAvailability(state, XsrStateAvailability.Stale);
        if (store.Read<int>(state).Value != 42 || store.Read<int>(state).Availability != XsrStateAvailability.Stale)
            throw new Exception("stale semantics");
    }
}
sealed class Observer : IXsrDispatchObserver { public void OnCompleted(XsrDispatchObservation observation) { } }
