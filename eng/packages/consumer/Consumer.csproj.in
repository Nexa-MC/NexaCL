<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework><OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors><IsAotCompatible>true</IsAotCompatible>
    <NexaAutomaticFunctionPatches>true</NexaAutomaticFunctionPatches>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Nexa.Xsr.Runtime" Version="[@VERSION@]" />
    <PackageReference Include="Nexa.Xsr.BuildTools" Version="[@VERSION@]" PrivateAssets="all" />
  </ItemGroup>
</Project>
