<Project>
  <PropertyGroup>
    <_NexaPatchDotnet Condition="'$(DOTNET_HOST_PATH)' != ''">$(DOTNET_HOST_PATH)</_NexaPatchDotnet>
    <_NexaPatchDotnet Condition="'$(_NexaPatchDotnet)' == ''">dotnet</_NexaPatchDotnet>
    <_NexaPatchCompilerProject>$([MSBuild]::NormalizePath('$(MSBuildThisFileDirectory)', '..', '..', 'tools', 'Nexa.Xsr.Patch.Compiler', 'Nexa.Xsr.Patch.Compiler.csproj'))</_NexaPatchCompilerProject>
  </PropertyGroup>
  <!-- IntermediateOutputPath is finalized by SDK targets after this import is evaluated. -->
  <Target Name="InitializeNexaFunctionPatchPaths">
    <!-- Resolve the same managed tool identity as the build-only project reference.
         Its output may live in ArtifactsPath or a caller-specified output directory. -->
    <MSBuild Projects="$(_NexaPatchCompilerProject)" Targets="GetTargetPath"
             RemoveProperties="PublishAot;PublishTrimmed;PublishSingleFile;PublishReadyToRun;SelfContained;RuntimeIdentifier">
      <Output TaskParameter="TargetOutputs" ItemName="_NexaPatchCompilerOutputs" />
    </MSBuild>
    <Error Condition="'@(_NexaPatchCompilerOutputs->Count())' != '1'"
           Text="NXRP001: exactly one managed Function Patch compiler output is required." />
    <PropertyGroup>
      <_NexaPatchCompiler>@(_NexaPatchCompilerOutputs->'%(FullPath)')</_NexaPatchCompiler>
      <_NexaPatchIntermediate>$([System.String]::Copy('$(IntermediateOutputPath)').Replace('\', '/'))</_NexaPatchIntermediate>
      <_NexaPatchedSource>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(_NexaPatchIntermediate)', 'NexaPatches', 'ResourceCaptions.g.cs'))</_NexaPatchedSource>
    </PropertyGroup>
  </Target>
  <Target Name="GenerateNexaFunctionPatches" DependsOnTargets="ResolveProjectReferences;InitializeNexaFunctionPatchPaths"
          Inputs="@(NexaFunctionPatchSource);$(_NexaPatchCompiler)"
          Outputs="$(_NexaPatchedSource)">
    <Error Condition="'@(NexaFunctionPatchSource->Count())' != '1'" Text="NXRP001: exactly one explicit Function Patch source file is required." />
    <Exec Command="&quot;$(_NexaPatchDotnet)&quot; &quot;$(_NexaPatchCompiler)&quot; --input &quot;@(NexaFunctionPatchSource)&quot; --output &quot;$(_NexaPatchedSource)&quot;" />
  </Target>
  <!-- Item replacement must also execute when the incremental generator target is skipped. -->
  <Target Name="UseNexaFunctionPatches" BeforeTargets="CoreCompile" DependsOnTargets="GenerateNexaFunctionPatches">
    <ItemGroup>
      <Compile Remove="@(NexaFunctionPatchSource)" MatchOnMetadata="FullPath" MatchOnMetadataOptions="PathLike" />
      <Compile Include="$(_NexaPatchedSource)" />
    </ItemGroup>
  </Target>
</Project>
