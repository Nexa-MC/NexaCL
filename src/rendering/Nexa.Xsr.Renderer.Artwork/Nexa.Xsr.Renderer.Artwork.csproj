<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>
    <Description>Read-only product artwork ownership and native resource adapter.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../foundation/Nexa.Core/Nexa.Core.csproj" />
  </ItemGroup>
  <PropertyGroup Condition="'$(NexaExternalModules)' == 'true'">
    <DefineConstants>$(DefineConstants);NEXA_EXTERNAL_MODULES</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(NexaExternalModules)' == 'true'">
    <Compile Include="../../interop/buffers/NativeResultClient.cs" Link="NativeResultClient.cs" />
  </ItemGroup>
  <Import Project="../../../eng/build/ArtworkResources.props" Condition="'$(NexaExternalModules)' != 'true'" />
  <ItemGroup Condition="'$(NexaExternalModules)' != 'true'">
    <Compile Include="../../engines/artwork/Nexa.Native.Artwork/ArtworkCatalog.cs" Link="ArtworkCatalog.cs" />
  </ItemGroup>
</Project>
