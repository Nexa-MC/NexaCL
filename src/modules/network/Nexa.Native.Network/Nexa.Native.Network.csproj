<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><NexaLocalPatchRuntime>false</NexaLocalPatchRuntime></PropertyGroup>
  <Import Project="../../../../eng/build/NativeEngine.props" />
  <Import Project="../../../interop/services/ServiceProtocol.props" />
  <PropertyGroup><DefineConstants>$(DefineConstants);NEXA_EXTERNAL_MODULES;NEXA_NETWORK_SERVICE_OWNER</DefineConstants></PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Nexa.Services.Network.Contracts/Nexa.Services.Network.Contracts.csproj" />
    <ProjectReference Include="../../common/Nexa.Services.Common/Nexa.Services.Common.csproj" />
    <Compile Include="../../../interop/NativeEngineClient.cs" Link="NativeEngineClient.cs" />
    <Compile Include="../../../interop/ui/NativeUiAsyncResources.cs" Link="NativeUiAsyncResources.cs" />
    <Compile Include="../Nexa.Services.Network/Network/*.cs" Exclude="../Nexa.Services.Network/Network/DnsOverHttpsResolver.cs" Link="Implementation/%(Filename)%(Extension)" />
    <Compile Include="../protocol/*.cs" Exclude="../protocol/NetworkHttpStreamHandler.cs" Link="Wire/%(Filename)%(Extension)" />
    <Compile Include="../protocol/downloads/*.cs" Exclude="../protocol/downloads/HostWorkLeaseServer.cs;../protocol/downloads/DownloadProgressSink.cs;../protocol/downloads/NativeNetworkClient.Downloads.cs" Link="Downloads/%(Filename)%(Extension)" />
    <Compile Include="../Nexa.Services.Network/Network/DnsOverHttpsResolver.cs" Link="DnsOverHttpsResolver.cs" />
  </ItemGroup>
</Project>
