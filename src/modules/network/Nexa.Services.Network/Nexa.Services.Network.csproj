<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Owned Network service boundary.</Description>
    <IsAotCompatible>true</IsAotCompatible>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>Nexa.Services</RootNamespace>
  </PropertyGroup>
  <PropertyGroup Condition="'$(NexaExternalModules)' == 'true'">
    <DefineConstants>$(DefineConstants);NEXA_EXTERNAL_MODULES</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Network/DnsOverHttpsResolver.cs" Condition="'$(NexaExternalModules)' == 'true' and '$(NexaNetworkTestInternals)' != 'true'" />
    <Compile Include="../../../interop/NativeEngineClient.cs" Link="NativeEngineClient.cs" />
    <ProjectReference Include="../../../engines/pac/Nexa.Native.Pac/Nexa.Native.Pac.csproj" Condition="'$(NexaExternalModules)' != 'true'" />
    <ProjectReference Include="../Nexa.Native.Network/Nexa.Native.Network.csproj" Condition="'$(NexaExternalModules)' != 'true'" />
    <None Update="ThirdPartyNotices.txt" Link="licenses/Network.ThirdPartyNotices.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <EmbeddedResource Include="Network/Pac.Substitutions.xml" LogicalName="Nexa.Services.Network.Pac.PublicationPolicy.xml" />
    <ProjectReference Include="../Nexa.Services.Network.Contracts/Nexa.Services.Network.Contracts.csproj" />
    <ProjectReference Include="../../../foundation/Nexa.Contracts/Nexa.Contracts.csproj" />
    <ProjectReference Include="../../../foundation/Nexa.Core/Nexa.Core.csproj" />
    <ProjectReference Include="../../../foundation/Nexa.Domain/Nexa.Domain.csproj" />
    <ProjectReference Include="../../../runtime/Nexa.Xsr.Abstractions/Nexa.Xsr.Abstractions.csproj" />
    <ProjectReference Include="../../../runtime/Nexa.Xsr.State/Nexa.Xsr.State.csproj" />
    <InternalsVisibleTo Include="Nexa.Desktop.Tests" />
    <InternalsVisibleTo Include="Nexa.Services" />
    <InternalsVisibleTo Include="Nexa.Services.Composition" />
    <InternalsVisibleTo Include="Nexa.Services.Tests" />
    <InternalsVisibleTo Include="Nexa.Native.Network.Tests" />
  </ItemGroup>
</Project>
