<nxml-dynamic>
  <StackPanel Background="#F4F6FA" Surface="Solid" CornerRadius="12">
    <StackPanel Margin="16" Spacing="10">
      <StackPanel Orientation="Horizontal" Spacing="16">
        <StackPanel Weight="1" Spacing="6">
          <Text Key="SidecarUpdateName" Content="{data name}" Localize="false" Class="settings-custom-update-result" />
          <Text Content="已安装 · {data current}" Class="settings-custom-update-note" />
          <Text Content="可用更新 · {data available}" IsVisible="{data hasOffer}" Class="settings-custom-update-note" />
        </StackPanel>
        <StackPanel Width="180" Spacing="6">
          <ProgressRing Width="20" Height="20" IsVisible="{data busy}" />
          <Text Key="SidecarUpdateStatus" Content="{data status}" Localize="false" Class="settings-custom-update-note" />
          <Text Content="{data progress}" IsVisible="{data busy}" Localize="false" Class="settings-custom-update-note" />
        </StackPanel>
      </StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="12">
        <Button Key="SidecarInstall" Content="{data action}" Label="安装 Sidecar 更新" Argument="{data id}" IsVisible="{data install}" Enabled="{data canInstall}" Command="ui.settings.sidecar.install" Class="settings-catalog-action" Width="160" Height="44" />
        <Button Key="SidecarRestart" Content="重新启动" Label="重新启动以应用 Sidecar 更新" Argument="{data id}" IsVisible="{data restart}" Enabled="{data canRestart}" Command="ui.settings.sidecar.restart" Class="settings-catalog-action" Width="160" Height="44" />
      </StackPanel>
    </StackPanel>
  </StackPanel>
</nxml-dynamic>
