<nxml-dynamic><StackPanel Key="{data key}" Class="settings-recovery-change"><StackPanel Class="settings-recovery-change-identity"><Text Content="{data kind}" Label="{data kind}" Localize="false" Class="settings-recovery-change-kind" /><Text Content="{data path}" Label="{data path}" Localize="false" Class="settings-recovery-change-path" /></StackPanel><Button Key="{data restore}" Content="回滚此项" Command="ui.settings.management.action" Enabled="{data enabled}" Class="settings-recovery-button settings-recovery-change-restore" /></StackPanel></nxml-dynamic>
