<nxml-dynamic>
  <StackPanel Key="ServersWorkspace" Class="world-stack" Weight="{data loadingWeight}" MinHeight="124">
    <StackPanel IsVisible="{data !loading}" Weight="1" Spacing="12">
      <Text Content="{data error}" Class="world-hint" IsVisible="{data hasError}" Localize="false" />
      <StackPanel IsVisible="{data loaded}" Class="world-stack">
        <StackPanel Orientation="{data actionDirection}" Class="world-actions">
          <Text Content="{data count} 个服务器" Class="world-counter" Localize="false" />
          <Button Key="Management.添加服务器" Content="添加服务器" Command="ui.settings.management.action" Class="settings-catalog-action world-button-wide" />
        </StackPanel>
        <StackPanel Class="world-card-body">
          <Text Content="局域网游戏" Class="world-title" />
          <Text Content="{data lanStatus}" Localize="false" Class="world-hint" />
          <Button Key="Servers.LanScan" Content="发现局域网游戏" Enabled="{data lanIdle}" Command="ui.settings.management.action" Class="settings-catalog-action world-button-wide" />
          <Dynamic Key="Servers.LanRows" Class="world-rows" />
        </StackPanel>
        <Dynamic Key="Servers.Editor" Class="world-stack" />
        <Dynamic Key="Servers.Rows" Class="world-rows" />
      </StackPanel>
    </StackPanel>
    <LoadingView IsVisible="{data loading}">
      <Text Content="正在读取服务器列表…" Class="loading-hint" LiveSetting="Polite" />
    </LoadingView>
  </StackPanel>
</nxml-dynamic>
