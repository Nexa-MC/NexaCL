<nxml-dynamic><StackPanel Key="{data key}" Class="settings-recovery-category"><Text Content="{data label}" Label="{data label}" Localize="false" Class="settings-recovery-category-label" /><Button Key="{data restore}" Content="恢复此类" Command="ui.settings.management.action" Enabled="{data enabled}" Class="settings-recovery-button settings-recovery-category-restore" /></StackPanel></nxml-dynamic>
