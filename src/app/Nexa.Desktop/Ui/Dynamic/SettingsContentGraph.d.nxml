<nxml-dynamic>
<StackPanel Key="ContentGraph" Class="settings-content-workspace"><StackPanel Key="ContentGraphToolbar" Class="settings-content-graph-tools"><TextInput Key="ContentGraphSearch" Label="搜索依赖" Placeholder="搜索模组或依赖" Class="settings-content-search" /><Button Key="GraphZoomOut" Content="缩小" Label="缩小" Command="ui.settings.management.action" Enabled="{data enabled}" Width="60" Class="settings-content-button" /><Button Key="GraphZoomIn" Content="放大" Label="放大" Command="ui.settings.management.action" Enabled="{data enabled}" Width="60" Class="settings-content-button" /><Button Key="GraphFit" Content="适应" Label="适应" Command="ui.settings.management.action" Enabled="{data enabled}" Width="60" Class="settings-content-button" /><Button Key="Management.刷新" Height="36" Label="刷新" Command="ui.settings.management.action" Enabled="{data enabled}" Width="36" Class="settings-content-button" Icon="pcl/refresh" /></StackPanel><Text Content="{data count}" Localize="false" Class="settings-content-graph-caption" /><Node Key="ContentGraphCanvas" Label="依赖图，拖动平移，点击节点查看关系" Role="Content" Command="ui.settings.management.action" Clickable="true" Focusable="true" Class="settings-content-graph-canvas" Recipe="Element" Kind="SettingsContentContent" /><Dynamic Key="ContentGraphSelection" Class="settings-content-graph-selection" /><Text Content="{data notice}" Localize="false" IsVisible="{data hasNotice}" MaxLines="0" Class="settings-content-rule" /><Text Content="{data unknown}" Localize="false" IsVisible="{data hasUnknown}" Class="settings-content-graph-caption" /></StackPanel>
</nxml-dynamic>
