<nxml-dynamic>
<StackPanel Class="settings-custom-actions"><Button Key="InstanceNoteAdd" Content="添加备注行" Label="添加备注行" Command="ui.settings.instance-identity.action" Enabled="{data enabled}"  Class="settings-catalog-action settings-custom-action" /><Button Key="InstanceNotePrevious" Content="上一页" Label="上一页" Command="ui.settings.instance-identity.action" Enabled="{data enabled}" IsVisible="{data pages}" Class="settings-catalog-action settings-custom-action" /><Button Key="InstanceNoteNext" Content="下一页" Label="下一页" Command="ui.settings.instance-identity.action" Enabled="{data enabled}" IsVisible="{data pages}" Class="settings-catalog-action settings-custom-action" /><Text Content="{data page} / {data total}" Localize="false" IsVisible="{data pages}" Class="settings-custom-caption" /></StackPanel>
</nxml-dynamic>
