<nxml-dynamic>
  <SettingsForm Key="LaunchProfiles" Weight="{data loadingWeight}" MinHeight="124">
    <StackPanel IsVisible="{data !loading}" Weight="1" Spacing="12">
      <Text Content="启动配置与临时覆盖" Class="settings-form-label" />
      <StackPanel Class="settings-form-surface">
        <StackPanel Class="settings-form-body">
          <Text Content="{data error}" Localize="false" IsVisible="{data failed}" Class="settings-custom-caption" />
          <Button Key="LaunchProfilesRetry" Content="重新读取启动配置" Label="重新读取启动配置" Command="ui.settings.launch-profile.action" IsVisible="{data failed}" Enabled="{data retryEnabled}" Class="settings-catalog-action settings-custom-action" />
          <StackPanel IsVisible="{data ready}" Class="settings-custom-column">
            <Text Content="{data layer}" Localize="false" Class="settings-custom-status" />
            <Button Key="LaunchProfileBase" Content="使用实例设置" Label="使用实例设置" Command="ui.settings.launch-profile.action" Enabled="{data enabled}" Class="settings-catalog-action settings-custom-action" />
            <Dynamic Key="LaunchProfileChoices" Class="settings-custom-column" />
            <StackPanel Class="settings-custom-field">
              <Text Content="配置名称" Class="settings-custom-label" />
              <TextInput Key="LaunchProfileName" Label="配置名称" Placeholder="配置名称" MaximumLength="4096" Class="settings-custom-input" />
            </StackPanel>
            <StackPanel Class="settings-custom-field">
              <Text Content="临时模组目录（完整路径；空白不覆盖）" Class="settings-custom-label" />
              <TextInput Key="LaunchOverlayMods" Label="临时模组目录（完整路径；空白不覆盖）" Placeholder="临时模组目录（完整路径；空白不覆盖）" MaximumLength="4096" Class="settings-custom-input" />
            </StackPanel>
            <StackPanel Class="settings-custom-field">
              <Text Content="临时资源包目录（完整路径）" Class="settings-custom-label" />
              <TextInput Key="LaunchOverlayResourcePacks" Label="临时资源包目录（完整路径）" Placeholder="临时资源包目录（完整路径）" MaximumLength="4096" Class="settings-custom-input" />
            </StackPanel>
            <StackPanel Class="settings-custom-field">
              <Text Content="临时光影目录（完整路径）" Class="settings-custom-label" />
              <TextInput Key="LaunchOverlayShaders" Label="临时光影目录（完整路径）" Placeholder="临时光影目录（完整路径）" MaximumLength="4096" Class="settings-custom-input" />
            </StackPanel>
            <StackPanel Class="settings-custom-field">
              <Text Content="临时配置目录（完整路径）" Class="settings-custom-label" />
              <TextInput Key="LaunchOverlayConfig" Label="临时配置目录（完整路径）" Placeholder="临时配置目录（完整路径）" MaximumLength="4096" Class="settings-custom-input" />
            </StackPanel>
            <StackPanel Class="settings-custom-actions">
              <Button Key="LaunchProfileCreate" Content="保存为新配置" Label="保存为新配置" Command="ui.settings.launch-profile.action" Enabled="{data enabled}" Class="settings-catalog-action settings-custom-action" />
              <Button Key="LaunchProfileSave" Content="保存名称与覆盖" Label="保存名称与覆盖" Command="ui.settings.launch-profile.action" Enabled="{data enabled}" IsVisible="{data selected}" Class="settings-catalog-action settings-custom-action" />
              <Button Key="LaunchTemporaryBegin" Content="启用临时覆盖" Label="启用临时覆盖" Command="ui.settings.launch-profile.action" Enabled="{data enabled}" IsVisible="{data permanent}" Class="settings-catalog-action settings-custom-action" />
              <Button Key="LaunchTemporarySave" Content="保存临时目录" Label="保存临时目录" Command="ui.settings.launch-profile.action" Enabled="{data enabled}" IsVisible="{data temporary}" Class="settings-catalog-action settings-custom-action" />
              <Button Key="LaunchTemporaryEnd" Content="撤销临时覆盖" Label="撤销临时覆盖" Command="ui.settings.launch-profile.action" Enabled="{data enabled}" IsVisible="{data temporary}" Class="settings-catalog-action settings-custom-action" />
            </StackPanel>
          </StackPanel>
        </StackPanel>
      </StackPanel>
    </StackPanel>
    <LoadingView IsVisible="{data loading}">
      <Text Content="正在读取启动配置…" Class="loading-hint" LiveSetting="Polite" />
    </LoadingView>
  </SettingsForm>
</nxml-dynamic>
