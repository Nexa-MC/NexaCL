<nxml-dynamic>
<StackPanel Key="ContentUpdateActions" Class="settings-content-toolbar"><Node Key="ContentSelectionCount" Role="Status" Label="{data caption}" Content="{data caption}" Localize="false" LiveSetting="Polite" Class="settings-content-selection-count" Recipe="Text" Kind="SettingsContentStatus" /><Button Key="ContentSelectionClear" Content="清除选择" Label="清除选择" Command="ui.settings.management.action" Enabled="{data clearEnabled}" Width="84" Class="settings-content-button" IsVisible="true" /><Button Key="Management.更新已选择" Content="更新已选择" Label="更新已选择" Command="ui.settings.management.action" Enabled="{data updateEnabled}" Width="106" Class="settings-content-button" /><Button Key="Management.更新全部已识别" Content="更新全部已识别" Label="更新全部已识别" Command="ui.settings.management.action" Enabled="{data enabled}" Width="136" Class="settings-content-button" /></StackPanel>
</nxml-dynamic>
