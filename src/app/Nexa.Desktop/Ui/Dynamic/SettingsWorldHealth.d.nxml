<nxml-dynamic>
  <StackPanel Key="WorldHealth" Class="world-stack" Weight="{data loadingWeight}" MinHeight="124">
    <StackPanel IsVisible="{data !checking}" Weight="1" Spacing="12">
      <Button Key="Management.检查世界健康" Content="检查世界健康" Command="ui.settings.management.action" Class="settings-catalog-action world-button-health" IsVisible="{data available}" Enabled="{data enabled}" />
      <Text Content="{data error}" Class="world-hint" IsVisible="{data hasError}" Localize="false" />
      <Text Content="已完成检查，未发现结构损坏。" Class="world-message" IsVisible="{data healthy}" />
      <Text Content="检查发现存档结构问题，原文件已保留。" Class="world-hint" IsVisible="{data damaged}" />
      <Text Content="检查不完整，不能确认世界健康。" Class="world-hint" IsVisible="{data incomplete}" />
      <StackPanel Class="world-fact" IsVisible="{data hasHealth}">
        <Text Content="已检查 region" Class="world-label" />
        <Text Content="{data regions}" Class="world-value" Localize="false" />
      </StackPanel>
      <StackPanel Class="world-fact" IsVisible="{data hasHealth}">
        <Text Content="已检查区块" Class="world-label" />
        <Text Content="{data chunks}" Class="world-value" Localize="false" />
      </StackPanel>
      <Dynamic Key="WorldHealth.Issues" Class="world-rows" />
      <Text Content="还有更多问题；未修改存档，请先保留备份。" Class="world-hint" IsVisible="{data more}" />
    </StackPanel>
    <LoadingView IsVisible="{data checking}">
      <Text Content="正在检查 region 分配与区块 NBT…" Class="loading-hint" LiveSetting="Polite" />
    </LoadingView>
  </StackPanel>
</nxml-dynamic>
