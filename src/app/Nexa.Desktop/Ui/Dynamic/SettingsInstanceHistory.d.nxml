<nxml-dynamic>
  <StackPanel Key="InstanceDiagnostics.History" Class="instance-diagnostics-stack">
    <StackPanel Key="InstanceDiagnostics.HistoryStatus" IsVisible="{data showStatus}" Class="settings-diagnostics-card">
      <StackPanel Class="instance-diagnostics-body">
        <Text Content="持久诊断历史" Class="instance-diagnostics-title" />
        <LoadingView IsVisible="{data pending}">
          <Text Content="正在读取此实例的持久运行历史…" Class="loading-hint" LiveSetting="Polite" />
        </LoadingView>
        <Text Content="{data error}" Localize="false" IsVisible="{data hasError}" Class="instance-diagnostics-hint" />
      </StackPanel>
    </StackPanel>
    <StackPanel Key="InstanceDiagnostics.LaunchHistory" IsVisible="{data LaunchVisible}" Class="settings-diagnostics-card">
      <StackPanel Class="instance-diagnostics-body">
        <Text Content="启动历史" Class="instance-diagnostics-title" />
        <Dynamic Key="InstanceDiagnostics.LaunchHistory.Rows" Class="instance-diagnostics-rows" />
        <StackPanel Class="instance-diagnostics-toolbar" IsVisible="{data LaunchPaging}">
          <Text Key="InstanceDiagnostics.LaunchHistory.Counter" Content="第 {data LaunchPage} / {data LaunchPages} 页" Localize="false" Class="instance-diagnostics-counter" />
          <Button Key="InstanceDiagnostics.LaunchHistory.Next" Content="下一页" Command="ui.settings.management.action" Class="settings-catalog-action instance-diagnostics-page" />
        </StackPanel>
      </StackPanel>
    </StackPanel>
    <StackPanel Key="InstanceDiagnostics.CrashHistory" IsVisible="{data CrashVisible}" Class="settings-diagnostics-card">
      <StackPanel Class="instance-diagnostics-body">
        <Text Content="崩溃历史" Class="instance-diagnostics-title" />
        <Dynamic Key="InstanceDiagnostics.CrashHistory.Rows" Class="instance-diagnostics-rows" />
        <StackPanel Class="instance-diagnostics-toolbar" IsVisible="{data CrashPaging}">
          <Text Key="InstanceDiagnostics.CrashHistory.Counter" Content="第 {data CrashPage} / {data CrashPages} 页" Localize="false" Class="instance-diagnostics-counter" />
          <Button Key="InstanceDiagnostics.CrashHistory.Next" Content="下一页" Command="ui.settings.management.action" Class="settings-catalog-action instance-diagnostics-page" />
        </StackPanel>
      </StackPanel>
    </StackPanel>
    <StackPanel Key="InstanceDiagnostics.OperationHistory" IsVisible="{data OperationVisible}" Class="settings-diagnostics-card">
      <StackPanel Class="instance-diagnostics-body">
        <Text Content="操作阶段历史" Class="instance-diagnostics-title" />
        <Dynamic Key="InstanceDiagnostics.OperationHistory.Rows" Class="instance-diagnostics-rows" />
        <StackPanel Class="instance-diagnostics-toolbar" IsVisible="{data OperationPaging}">
          <Text Key="InstanceDiagnostics.OperationHistory.Counter" Content="第 {data OperationPage} / {data OperationPages} 页" Localize="false" Class="instance-diagnostics-counter" />
          <Button Key="InstanceDiagnostics.OperationHistory.Next" Content="下一页" Command="ui.settings.management.action" Class="settings-catalog-action instance-diagnostics-page" />
        </StackPanel>
      </StackPanel>
    </StackPanel>
  </StackPanel>
</nxml-dynamic>
