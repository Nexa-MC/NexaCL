<nxml-dynamic>
<Node Recipe="CommandInput" Kind="ContentFile" Selected="{data selected}" Key="ManagementContentRow" Role="ListItem" Label="{data title}" Localize="false" Clickable="{data selectable}" Focusable="{data selectable}" Enabled="{data enabled}" Command="ui.settings.management.action" Height="{data height}" MaxWidth="{data width}" Margin="{data margin}" Class="{data selectedStyle}"><StackPanel Key="ManagementContentBody" Class="settings-content-card-body"><Image Key="ManagementContentIcon" Source="{data icon}" Class="settings-content-icon" /><StackPanel Class="settings-content-copy"><Text Key="ContentFile.Title" Content="{data title}" Localize="false" MaxLines="1" TrimOverflow="true" Class="settings-content-title" /><Text Key="ContentFile.Description" Content="{data description}" Localize="false" Height="{data descriptionHeight}" MaxLines="{data descriptionLines}" TrimOverflow="true" Class="settings-content-description" /><Text Content="{data update}" Localize="false" IsVisible="{data hasUpdate}" Class="settings-content-description" /></StackPanel><Text Content="{data version}" Localize="false" IsVisible="{data versionVisible}" Class="settings-content-version" /><StackPanel Key="{data actions}" Class="settings-content-pills"><Button Key="{data details}" Content="详情" Label="详情" Command="ui.settings.management.action" Enabled="{data enabled}" Width="76" Class="settings-content-button settings-content-pill" Icon="lucide/info" /><Button Key="{data toggle}" Content="{data toggleLabel}" Label="{data toggleLabel}" Command="ui.settings.management.action" Enabled="{data enabled}" Width="76" Class="settings-content-button settings-content-pill" Icon="{data toggleIcon}" IsVisible="{data canToggle}" /><Button Key="{data updateKey}" Content="更新" Label="更新" Command="ui.settings.management.action" Enabled="{data enabled}" Width="76" Class="settings-content-button settings-content-pill" Icon="lucide/download" IsVisible="{data canUpdate}" /><Button Key="{data remove}" Content="删除" Label="删除" Command="ui.settings.management.action" Enabled="{data enabled}" Width="76" Class="settings-content-button settings-content-pill" Icon="lucide/trash-2" IsVisible="{data canRemove}" /></StackPanel></StackPanel><Node Key="{data mark}" IsVisible="{data selected}" ModalLayer="false" Class="settings-content-selection-mark" Recipe="Element" Kind="ContentOverlay" /></Node>
</nxml-dynamic>
