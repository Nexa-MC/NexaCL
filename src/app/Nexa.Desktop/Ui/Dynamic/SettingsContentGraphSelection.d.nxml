<nxml-dynamic>
<StackPanel Class="settings-content-graph-selection"><Text Content="选择一个节点，查看依赖和被依赖关系。" IsVisible="{data empty}" Class="settings-content-message" /><StackPanel IsVisible="{data selected}" Class="settings-content-graph-selection"><Text Key="ContentGraph.SelectedTitle" Content="{data title}" Localize="false" MaxLines="0" Class="settings-content-graph-title" /><Text Content="{data state}" Localize="false" Class="settings-content-graph-caption" /><Text Content="依赖声明尚未完整识别。" IsVisible="{data incomplete}" Class="settings-content-graph-caption" /><Text Content="存在依赖循环。" IsVisible="{data cycle}" Class="settings-content-graph-caption" /><Dynamic Key="ContentGraph.Dependencies" Class="settings-content-graph-selection" /><Text Content="{data consumers}" Localize="false" Class="settings-content-message" /><Dynamic Key="ContentGraph.Consumers" Class="settings-content-graph-selection" /></StackPanel></StackPanel>
</nxml-dynamic>
