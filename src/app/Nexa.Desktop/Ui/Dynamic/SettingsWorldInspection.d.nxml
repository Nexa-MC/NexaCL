<nxml-dynamic>
  <StackPanel Class="world-card-body">
    <Text Content="文件内容与 NBT 查看器" Class="world-title" />
    <TextInput Key="Inspection.Path" Label="要查看的文件或目录" Class="world-input" />
    <Button Key="Inspection.Open" Content="查看文件" Command="ui.settings.management.action" Class="settings-catalog-action world-button-wide" />
    <Text Content="{data summary}" Localize="false" MaxLines="0" Class="world-hint" />
    <Text Content="{data location}" Localize="false" Class="world-hint" />
    <Image Source="lucide/image" Key="Inspection.Image" IsVisible="{data image}" Height="256" />
    <Text Content="{data text}" Localize="false" MaxLines="0" Class="world-hint" />
    <Dynamic Key="Inspection.Rows" Class="world-rows" />
    <StackPanel Class="world-actions">
      <Button Key="Inspection.Back" Content="返回上层" Enabled="{data back}" Command="ui.settings.management.action" Class="settings-catalog-action world-button-wide" />
      <Button Key="Inspection.Previous" Content="上一页" Enabled="{data previous}" Command="ui.settings.management.action" Class="settings-catalog-action world-button-wide" />
      <Text Content="{data count}" Localize="false" Class="world-hint" />
      <Button Key="Inspection.Next" Content="下一页" Enabled="{data next}" Command="ui.settings.management.action" Class="settings-catalog-action world-button-wide" />
    </StackPanel>
  </StackPanel>
</nxml-dynamic>
