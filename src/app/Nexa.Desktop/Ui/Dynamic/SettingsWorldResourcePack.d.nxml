<nxml-dynamic>
  <StackPanel Class="world-card-body">
    <Text Content="资源包兼容性与顺序" Class="world-title" />
    <Text Content="{data status}" Localize="false" Class="world-hint" />
    <StackPanel Class="world-actions">
      <Button Key="ResourcePack.Up" Content="提高优先级" Enabled="{data up}" Command="ui.settings.management.action" Class="settings-catalog-action world-button-wide" />
      <Button Key="ResourcePack.Down" Content="降低优先级" Enabled="{data down}" Command="ui.settings.management.action" Class="settings-catalog-action world-button-wide" />
    </StackPanel>
  </StackPanel>
</nxml-dynamic>
