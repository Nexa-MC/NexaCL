<nxml-dynamic><ContentHost Weight="1"><LoadingView IsVisible="{data loading}"><Text Content="{data message}" Localize="false" Class="loading-hint" LiveSetting="Polite" /></LoadingView><StackPanel IsVisible="{data !loading}" Spacing="16" VerticalAlignment="Center"><Text Content="{data message}" Localize="false" Class="settings-content-message" /><Button Key="Management.刷新" Height="36" Label="刷新" Command="ui.settings.management.action" Enabled="{data enabled}" Width="36" Class="settings-content-button" Icon="pcl/refresh" /></StackPanel></ContentHost></nxml-dynamic>
