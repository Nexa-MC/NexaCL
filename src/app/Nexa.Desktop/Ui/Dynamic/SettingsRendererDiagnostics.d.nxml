<nxml-dynamic>
<StackPanel Key="SettingsDiagnostics.Renderer" Class="settings-diagnostics-card">
  <StackPanel Class="settings-diagnostics-body">
  <StackPanel Key="SettingsDiagnostics.Renderer.Toolbar" Class="settings-diagnostics-toolbar">
    <Text Content="Renderer Diagnostics" Class="settings-diagnostics-title" />
    <Button Key="SettingsDiagnostics.Renderer.Refresh" Label="刷新渲染器诊断" Icon="pcl/refresh" Command="ui.settings.diagnostics.renderer.refresh" Class="settings-diagnostics-refresh" />
  </StackPanel>
  <Dynamic Key="SettingsDiagnostics.Renderer.Body" Class="settings-diagnostics-fields" />
  </StackPanel>
</StackPanel>
</nxml-dynamic>
