<nxml-dynamic>
  <StackPanel Key="SettingsUpdateCard" Class="settings-custom-update">
    <StackPanel Key="SettingsUpdateCard.Body" Class="settings-custom-update-body">
      <StackPanel Key="SettingsUpdateHeader" Class="settings-custom-update-header">
        <Text Content="更新中心" Class="settings-custom-update-title" />
        <Button Key="SettingsCheckUpdate" Label="检查所有更新" Content="检查更新" Command="ui.settings.update.check" Enabled="{data canCheck}" Class="settings-custom-update-check" />
      </StackPanel>
      <Text Content="通道 · {data channel}　上次检查：{data lastCheck}" Class="settings-custom-update-note" />
      <StackPanel Orientation="Horizontal" Spacing="12">
        <Button Key="SettingsInstallAllUpdates" Content="下载并安装全部" Command="ui.settings.update.all" Enabled="{data canInstallAll}" Width="160" Height="40" Class="settings-catalog-action" />
        <Button Key="SettingsRestartAllUpdates" Content="重新启动以完成更新" Command="ui.settings.update.restartAll" Enabled="{data canRestartAll}" Width="200" Height="40" Class="settings-catalog-action" />
      </StackPanel>
      <StackPanel Key="SettingsLauncherUpdateRow" Background="#F4F6FA" Surface="Solid" CornerRadius="12">
        <StackPanel Margin="16" Spacing="10">
          <StackPanel Orientation="Horizontal" Spacing="16">
            <StackPanel Weight="1" Spacing="6">
              <Text Content="NexaCL Firefly" Localize="false" Class="settings-custom-update-result" />
              <Text Content="已安装 · {data version}" Class="settings-custom-update-note" />
              <Text Content="可用更新 · {data offered}" IsVisible="{data hasOffer}" Class="settings-custom-update-note" />
            </StackPanel>
            <StackPanel Width="180" Spacing="6">
              <ProgressRing Width="20" Height="20" IsVisible="{data busy}" />
              <Text Key="SettingsUpdateStatus" Content="{data status}" Localize="false" Class="settings-custom-update-note" />
            </StackPanel>
          </StackPanel>
          <Dynamic Key="SettingsUpdateActions" Class="settings-custom-update-actions" />
        </StackPanel>
      </StackPanel>
      <Dynamic Key="SettingsSidecarUpdates" Class="settings-custom-column" />
      <Text Content="{data sidecarStatus}" IsVisible="{data showSidecarNotice}" Localize="false" Class="settings-custom-update-note" />
    </StackPanel>
  </StackPanel>
</nxml-dynamic>
