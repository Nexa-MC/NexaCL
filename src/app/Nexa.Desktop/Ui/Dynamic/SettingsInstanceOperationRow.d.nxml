<nxml-dynamic>
<StackPanel Key="{data row}" Class="instance-diagnostics-history-row">
<StackPanel Key="InstanceDiagnostics.OperationTimestamp" Class="instance-diagnostics-field"><Text Content="记录时间" Class="instance-diagnostics-label" /><Text Key="InstanceDiagnostics.OperationTimestamp.Value" Content="{data OperationTimestamp}" Label="{data OperationTimestamp}" Localize="false" MaxLines="1" TrimOverflow="true" Class="instance-diagnostics-value" /></StackPanel>
<StackPanel Key="InstanceDiagnostics.OperationSession" Class="instance-diagnostics-field"><Text Content="运行身份" Class="instance-diagnostics-label" /><Text Key="InstanceDiagnostics.OperationSession.Value" Content="{data OperationSession}" Label="{data OperationSession}" Localize="false" MaxLines="1" TrimOverflow="true" Class="instance-diagnostics-value" /></StackPanel>
<StackPanel Key="InstanceDiagnostics.OperationModule" Class="instance-diagnostics-field"><Text Content="模块" Class="instance-diagnostics-label" /><Text Key="InstanceDiagnostics.OperationModule.Value" Content="{data OperationModule}" Label="{data OperationModule}" Localize="false" MaxLines="1" TrimOverflow="true" Class="instance-diagnostics-value" /></StackPanel>
<StackPanel Key="InstanceDiagnostics.OperationName" Class="instance-diagnostics-field"><Text Content="操作" Class="instance-diagnostics-label" /><Text Key="InstanceDiagnostics.OperationName.Value" Content="{data OperationName}" Label="{data OperationName}" Localize="false" MaxLines="1" TrimOverflow="true" Class="instance-diagnostics-value" /></StackPanel>
<StackPanel Key="InstanceDiagnostics.OperationStage" Class="instance-diagnostics-field"><Text Content="阶段" Class="instance-diagnostics-label" /><Text Key="InstanceDiagnostics.OperationStage.Value" Content="{data OperationStage}" Label="{data OperationStage}" Localize="false" MaxLines="1" TrimOverflow="true" Class="instance-diagnostics-value" /></StackPanel>
<StackPanel Key="InstanceDiagnostics.OperationOutcome" Class="instance-diagnostics-field"><Text Content="阶段结果" Class="instance-diagnostics-label" /><Text Key="InstanceDiagnostics.OperationOutcome.Value" Content="{data OperationOutcome}" Label="{data OperationOutcome}" Localize="false" MaxLines="1" TrimOverflow="true" Class="instance-diagnostics-value" /></StackPanel>
</StackPanel>
</nxml-dynamic>
