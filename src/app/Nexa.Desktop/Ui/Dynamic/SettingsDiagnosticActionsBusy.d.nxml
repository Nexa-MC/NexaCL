<nxml-dynamic>
  <StackPanel Key="DiagnosticExportActions" Class="settings-about-actions" MinHeight="96">
    <LoadingView IsVisible="true" Weight="0" Class="loading-view loading-inline">
      <Text Content="正在导出…" Class="loading-hint" LiveSetting="Polite" />
    </LoadingView>
    <Button Key="Management.导出诊断包" Label="正在导出…" Content="" Command="ui.settings.management.action" Enabled="{data enabled}" Class="settings-catalog-action settings-diagnostic-export" IsVisible="false" VerticalAlignment="Center" />
    <Button Key="Management.取消诊断包导出" Label="取消导出" Content="取消导出" Command="ui.settings.management.action" IsVisible="true" Enabled="true" Class="settings-catalog-action settings-about-link" VerticalAlignment="Center" />
  </StackPanel>
</nxml-dynamic>
