<nxml-dynamic><StackPanel Key="{data key}" Class="world-actions"><CheckBox Key="{data choice}" Label="{data label}" Content="{data label}" Localize="false" Checked="{data selected}" Command="ui.settings.management.action" Class="world-category" /><Text Content="{data files} 个文件" Class="world-counter" Localize="false" /><Text Content="{data size} MiB" Class="world-counter" Localize="false" /></StackPanel></nxml-dynamic>
