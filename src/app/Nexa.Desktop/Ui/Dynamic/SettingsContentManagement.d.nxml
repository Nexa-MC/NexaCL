<nxml-dynamic>
<StackPanel Key="ContentManagement" Class="settings-content-workspace">
<StackPanel Key="ManagementToolbar" Class="settings-content-toolbar"><TextInput Key="ManagementContentSearch" Label="搜索内容" Placeholder="搜索名称、文件名或版本" Class="settings-content-search" /><Button Key="Management.打开文件夹" Content="打开文件夹" Label="打开文件夹" Command="ui.settings.management.action" Enabled="{data enabled}" Width="100" Class="settings-content-button" /><StackPanel IsVisible="{data screenshots}" Class="settings-content-pills"><Button Key="Management.时间线" Content="时间线" Label="时间线" Command="ui.settings.management.action" Enabled="{data enabled}" Width="84" Class="settings-content-button" IsVisible="{data timelineVisible}" /><Button Key="Management.画廊" Content="画廊" Label="画廊" Command="ui.settings.management.action" Enabled="{data enabled}" Width="84" Class="settings-content-button" IsVisible="{data galleryVisible}" /></StackPanel><Button Key="Management.刷新" Height="36" Label="刷新" Command="ui.settings.management.action" Enabled="{data enabled}" Width="36" Class="settings-content-button" Icon="pcl/refresh"/></StackPanel>
<Dynamic Key="ContentManagement.Categories" IsVisible="{data hasCategories}" /><StackPanel Key="ManagementLocation" Class="settings-content-location"><Text Content="{data directory}" Localize="false" MaxLines="1" TrimOverflow="true" Class="settings-content-path" /><Text Key="ManagementContentCount" Content="{data count}" Localize="false" Class="settings-content-count" /><Dynamic Key="ContentManagement.OnlineStatus" IsVisible="{data hasOnlineStatus}" Class="settings-content-online-status" /></StackPanel>
<Dynamic Key="ContentManagement.Updates" IsVisible="{data hasUpdates}" /><Text Content="{data error}" Localize="false" IsVisible="{data hasError}" Class="settings-content-message" />
<Dynamic Key="ManagementContentList" Class="settings-content-list" /><Dynamic Key="ContentManagement.Parking" IsVisible="false" /></StackPanel>
</nxml-dynamic>
