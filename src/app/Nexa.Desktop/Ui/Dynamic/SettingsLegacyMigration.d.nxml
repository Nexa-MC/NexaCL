<nxml-dynamic>
<SettingsForm Key="LegacyMigrationWorkspace"><Text Content="迁移助手" Class="settings-form-label" /><StackPanel Class="settings-form-surface"><StackPanel Class="settings-form-body">
<Button Key="ContentWorkspace.Migrate" Label="预览旧数据迁移" Content="预览旧数据迁移" Command="ui.settings.storage.workspace" Enabled="{data enabled}" Class="settings-catalog-action settings-workspace-action" />
</StackPanel></StackPanel></SettingsForm>
</nxml-dynamic>
