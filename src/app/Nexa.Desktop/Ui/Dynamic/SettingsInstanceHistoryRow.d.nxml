<nxml-dynamic>
<StackPanel Key="{data row}" Class="instance-diagnostics-history-row"><Text Key="InstanceDiagnostics.History.Timestamp" Content="{data timestamp}" Localize="false" Class="instance-diagnostics-caption" />
<StackPanel Key="InstanceDiagnostics.HistorySession" Class="instance-diagnostics-field"><Text Content="运行身份" Class="instance-diagnostics-label" /><Text Key="InstanceDiagnostics.HistorySession.Value" Content="{data HistorySession}" Label="{data HistorySession}" Localize="false" MaxLines="1" TrimOverflow="true" Class="instance-diagnostics-value" /></StackPanel>
<StackPanel Key="InstanceDiagnostics.HistoryResult" Class="instance-diagnostics-field"><Text Content="已记录结果" Class="instance-diagnostics-label" /><Text Key="InstanceDiagnostics.HistoryResult.Value" Content="{data HistoryResult}" Label="{data HistoryResult}" Localize="false" MaxLines="1" TrimOverflow="true" Class="instance-diagnostics-value" /></StackPanel>
<StackPanel Key="InstanceDiagnostics.HistoryEnded" Class="instance-diagnostics-field" IsVisible="{data hasEnded}"><Text Content="退出时间" Class="instance-diagnostics-label" /><Text Key="InstanceDiagnostics.HistoryEnded.Value" Content="{data HistoryEnded}" Label="{data HistoryEnded}" Localize="false" MaxLines="1" TrimOverflow="true" Class="instance-diagnostics-value" /></StackPanel>
<StackPanel Key="InstanceDiagnostics.HistoryExit" Class="instance-diagnostics-field" IsVisible="{data hasExit}"><Text Content="退出码" Class="instance-diagnostics-label" /><Text Key="InstanceDiagnostics.HistoryExit.Value" Content="{data HistoryExit}" Label="{data HistoryExit}" Localize="false" MaxLines="1" TrimOverflow="true" Class="instance-diagnostics-value" /></StackPanel>
<StackPanel Key="InstanceDiagnostics.HistoryFailure" Class="instance-diagnostics-field" IsVisible="{data hasFailure}"><Text Content="问题分类" Class="instance-diagnostics-label" /><Text Key="InstanceDiagnostics.HistoryFailure.Value" Content="{data HistoryFailure}" Label="{data HistoryFailure}" Localize="false" MaxLines="1" TrimOverflow="true" Class="instance-diagnostics-value" /></StackPanel>
<StackPanel Key="InstanceDiagnostics.HistoryLaunchDuration" Class="instance-diagnostics-field" IsVisible="{data hasDuration}"><Text Content="进程启动耗时" Class="instance-diagnostics-label" /><Text Key="InstanceDiagnostics.HistoryLaunchDuration.Value" Content="{data HistoryLaunchDuration}" Label="{data HistoryLaunchDuration}" Localize="false" MaxLines="1" TrimOverflow="true" Class="instance-diagnostics-value" /></StackPanel>
</StackPanel>
</nxml-dynamic>
