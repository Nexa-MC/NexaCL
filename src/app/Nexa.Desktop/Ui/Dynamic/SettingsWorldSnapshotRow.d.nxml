<nxml-dynamic><StackPanel Key="{data key}" Class="world-snapshot-row"><Text Content="{data created} · {data files} 个文件 · {data bytes} B" Class="world-hint" Localize="false" /><StackPanel Orientation="{data actionDirection}" Class="world-actions"><Button Key="{data verify}" Content="校验快照" Command="ui.settings.management.action" Class="settings-catalog-action world-button" Enabled="{data enabled}" /><Button Key="{data restore}" Content="恢复为新世界" Command="ui.settings.management.action" Class="settings-catalog-action world-button-health" Enabled="{data enabled}" /></StackPanel></StackPanel></nxml-dynamic>
