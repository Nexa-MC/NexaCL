<nxml-dynamic><StackPanel Key="ServerEditor" Class="world-card"><StackPanel Class="world-card-body"><Text Content="添加服务器" Class="world-title" IsVisible="{data adding}" /><Text Content="编辑服务器" Class="world-title" IsVisible="{data editing}" /><StackPanel Class="world-field"><Text Content="名称" Class="world-field-label"  /><TextInput Key="ServerName" Label="名称" Class="world-input" /></StackPanel><StackPanel Class="world-field"><Text Content="地址" Class="world-field-label"  /><TextInput Key="ServerAddress" Label="地址" Placeholder="example.org:25565" Class="world-input" /></StackPanel><StackPanel Orientation="{data actionDirection}" Class="world-actions"><Button Key="Management.取消" Content="取消" Command="ui.settings.management.action" Class="settings-catalog-action world-button-small"  /><Button Key="Management.保存" Content="保存" Command="ui.settings.management.action" Class="settings-catalog-action world-button-small"  /></StackPanel></StackPanel></StackPanel></nxml-dynamic>
