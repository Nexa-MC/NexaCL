<nxml-dynamic>
<StackPanel Key="InstanceIdentity.Ready" Class="settings-custom-column"><StackPanel Class="settings-custom-fact"><Text Content="认证配置" Class="settings-custom-fact-label" /><Text Content="{data authentication}" Localize="false" Class="settings-custom-fact-value" /></StackPanel><StackPanel Class="settings-custom-field"><Text Content="登录要求：0 不限 / 1 Microsoft / 2 第三方 / 3 两者之一" Class="settings-custom-label" /><TextInput Key="InstanceIdentityInput.login" Label="登录要求：0 不限 / 1 Microsoft / 2 第三方 / 3 两者之一" MaximumLength="1" PreserveTabs="true" Enabled="{data authenticationEnabled}" Class="settings-custom-input" /></StackPanel><StackPanel Class="settings-custom-field"><Text Content="认证服务器 HTTPS 地址" Class="settings-custom-label" /><TextInput Key="InstanceIdentityInput.auth" Label="认证服务器 HTTPS 地址" MaximumLength="2048" PreserveTabs="true" Enabled="{data authenticationEnabled}" Class="settings-custom-input" /></StackPanel><StackPanel Class="settings-custom-field"><Text Content="注册页面 HTTPS 地址" Class="settings-custom-label" /><TextInput Key="InstanceIdentityInput.register" Label="注册页面 HTTPS 地址" MaximumLength="2048" PreserveTabs="true" Enabled="{data authenticationEnabled}" Class="settings-custom-input" /></StackPanel><StackPanel Class="settings-custom-field"><Text Content="认证服务器名称" Class="settings-custom-label" /><TextInput Key="InstanceIdentityInput.auth-name" Label="认证服务器名称" MaximumLength="256" PreserveTabs="true" Enabled="{data authenticationEnabled}" Class="settings-custom-input" /></StackPanel><StackPanel Class="settings-custom-field"><Text Content="默认服务器" Class="settings-custom-label" /><TextInput Key="InstanceIdentityInput.default-server" Label="默认服务器" MaximumLength="512" PreserveTabs="true" Enabled="true" Class="settings-custom-input" /></StackPanel><StackPanel Class="settings-custom-field"><Text Content="服务器要求的 Minecraft 版本（空白不约束）" Class="settings-custom-label" /><TextInput Key="InstanceIdentityInput.game-version" Label="服务器要求的 Minecraft 版本（空白不约束）" MaximumLength="64" PreserveTabs="true" Enabled="true" Class="settings-custom-input" /></StackPanel><StackPanel Class="settings-custom-field"><Text Content="服务器要求的加载器（如 Fabric；空白不约束）" Class="settings-custom-label" /><TextInput Key="InstanceIdentityInput.loader" Label="服务器要求的加载器（如 Fabric；空白不约束）" MaximumLength="64" PreserveTabs="true" Enabled="true" Class="settings-custom-input" /></StackPanel><StackPanel Class="settings-custom-field"><Text Content="服务器必需模组 ID（逗号分隔）" Class="settings-custom-label" /><TextInput Key="InstanceIdentityInput.mods" Label="服务器必需模组 ID（逗号分隔）" MaximumLength="16384" PreserveTabs="true" Enabled="true" Class="settings-custom-input" /></StackPanel><Button Key="InstanceOfflinePolicy" Content="{data offlineLabel}" Label="{data offlineLabel}" Command="ui.settings.instance-identity.action" Enabled="{data enabled}" Localize="false" Class="settings-catalog-action settings-custom-action" /><Text Content="未声明服务器环境要求。" IsVisible="{data undeclared}" Class="settings-custom-status" /><Text Content="已声明的服务器环境要求与当前实例一致。" IsVisible="{data matched}" Class="settings-custom-status" /><Text Content="服务器环境不匹配：" IsVisible="{data mismatched}" Class="settings-custom-status" /><Dynamic Key="InstanceIdentity.Mismatches" Class="settings-custom-column" /><StackPanel Class="settings-custom-actions"><Button Key="InstanceIdentitySave" Content="保存更改" Label="保存更改" Command="ui.settings.instance-identity.action" Enabled="{data enabled}" Class="settings-catalog-action settings-custom-action" /><Button Key="InstanceIdentityReload" Content="重新读取" Label="重新读取" Command="ui.settings.instance-identity.action" Enabled="{data enabled}" Class="settings-catalog-action settings-custom-action" /></StackPanel></StackPanel>
</nxml-dynamic>
