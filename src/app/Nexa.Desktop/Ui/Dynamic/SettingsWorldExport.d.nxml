<nxml-dynamic>
  <StackPanel Key="ExportWorkspace" Class="world-stack" Weight="{data loadingWeight}" MinHeight="124">
    <StackPanel IsVisible="{data !loading}" Weight="1" Spacing="12">
      <StackPanel Key="ExportMetadata" Class="world-card">
        <StackPanel Class="world-card-body">
          <Text Content="整合包信息" Class="world-title" />
          <StackPanel Class="world-field">
            <Text Content="导出格式" Class="world-field-label" />
            <SettingsChoiceTrack Key="Export.Format" Label="导出格式" SegmentThumb="Export.FormatThumb" Width="432" Class="settings-catalog-selector">
              <ContentHost Key="Export.FormatThumb" TransitionKey="selection" IsVisible="false" Class="settings-catalog-thumb" />
              <SettingsChoice Key="Export.Mrpack" Content="mrpack" Label="mrpack" Selected="{data mrpack}" Width="60" Command="ui.settings.management.action" Class="settings-catalog-option" />
              <SettingsChoice Key="Export.Zip" Content="zip" Label="zip" Selected="{data zip}" Width="44" Command="ui.settings.management.action" Class="settings-catalog-option" />
              <SettingsChoice Key="Export.CurseForge" Content="CurseForge" Label="CurseForge" Selected="{data curseforge}" Width="96" Command="ui.settings.management.action" Class="settings-catalog-option" />
              <SettingsChoice Key="Export.Mcbbs" Content="MCBBS / HMCL" Label="MCBBS / HMCL" Selected="{data mcbbs}" Width="126" Command="ui.settings.management.action" Class="settings-catalog-option" />
              <SettingsChoice Key="Export.MultiMC" Content="MultiMC" Label="MultiMC" Selected="{data multimc}" Width="100" Command="ui.settings.management.action" Class="settings-catalog-option" />
            </SettingsChoiceTrack>
          </StackPanel>
          <StackPanel Key="Export.ZipOptions" IsVisible="{data zip}" Class="world-rows">
            <CheckBox Key="Export.GameCore" Content="包含游戏核心（含原版）" Label="包含游戏核心（含原版）" Checked="{data core}" Command="ui.settings.management.action" Class="world-category" />
            <CheckBox Key="Export.Libraries" Content="包含当前平台运行库" Label="包含当前平台运行库" Checked="{data libraries}" Command="ui.settings.management.action" Class="world-category" />
            <CheckBox Key="Export.Assets" Content="包含资源文件（声音、语言等）" Label="包含资源文件（声音、语言等）" Checked="{data assets}" Command="ui.settings.management.action" Class="world-category" />
            <Text Content="随包携带启动器（可选，填写完整发布包目录）" Class="world-field-label" />
            <TextInput Key="ExportLauncher" Label="启动器发布包目录" Placeholder="留空则不携带启动器" Class="world-input" />
            <Text Content="随包携带 Java（可选，填写 Java 根目录）" Class="world-field-label" />
            <TextInput Key="ExportJava" Label="Java 根目录" Placeholder="留空则不携带 Java" Class="world-input" />
            <Text Content="ZIP 解压为游戏目录；未包含的依赖需由启动器补齐。" Class="world-hint" />
          </StackPanel>
          <StackPanel Class="world-fact">
            <Text Content="Minecraft" Class="world-label" />
            <Text Content="{data gameVersion}" Class="world-value" Localize="false" />
          </StackPanel>
          <StackPanel Class="world-fact">
            <Text Content="已记录版本" Class="world-label" />
            <Text Content="{data recordedVersion}" Class="world-value" Localize="false" />
          </StackPanel>
          <StackPanel Class="world-field">
            <Text Content="包名称" Class="world-field-label" />
            <TextInput Key="ExportName" Label="包名称" Class="world-input" />
          </StackPanel>
          <StackPanel Class="world-field">
            <Text Content="包版本" Class="world-field-label" />
            <TextInput Key="ExportVersion" Label="包版本" Class="world-input" />
          </StackPanel>
          <StackPanel Class="world-field">
            <Text Content="保存到" Class="world-field-label" />
            <TextInput Key="ExportPath" Label="保存到" Placeholder="完整 .mrpack 或 .zip 文件路径" Class="world-input" />
          </StackPanel>
          <StackPanel Class="world-field">
            <Text Content="简介" Class="world-field-label" />
            <TextInput Key="ExportSummary" Label="简介" Class="world-input" />
          </StackPanel>
          <Button Key="Management.选择保存目录" Content="选择保存目录" Command="ui.settings.management.action" Class="settings-catalog-action world-button-health" IsVisible="{data picker}" />
        </StackPanel>
      </StackPanel>
      <StackPanel IsVisible="{data preview}" Class="world-stack">
        <StackPanel Key="ExportCategories" Class="world-card">
          <StackPanel Class="world-card-body">
            <Text Content="包含的内容" Class="world-title" />
            <Dynamic Key="Export.Categories" Class="world-rows" />
            <StackPanel Class="world-actions">
              <Button Key="Export.All" Content="全选" Command="ui.settings.management.action" Class="settings-catalog-action world-button-health" />
              <Button Key="Export.None" Content="全不选" Command="ui.settings.management.action" Class="settings-catalog-action world-button-health" />
              <Button Key="Export.Reset" Content="恢复默认" Command="ui.settings.management.action" Class="settings-catalog-action world-button-health" />
            </StackPanel>
            <TextInput Key="ExportSearch" Label="搜索导出文件" Placeholder="搜索导出文件" Class="world-input" />
            <Dynamic Key="Export.Files" Class="world-rows" />
            <StackPanel Class="world-actions">
              <Button Key="Export.Previous" Content="上一页" Command="ui.settings.management.action" Class="settings-catalog-action world-button-health" />
              <Dynamic Key="Export.Count" />
              <Button Key="Export.Next" Content="下一页" Command="ui.settings.management.action" Class="settings-catalog-action world-button-health" />
            </StackPanel>
            <Text Content="账号、日志、密钥和临时文件不会导出。" Class="world-hint" />
          </StackPanel>
        </StackPanel>
        <StackPanel Class="world-card">
          <StackPanel Class="world-card-body">
            <Text Content="导出配置" Class="world-title" />
            <TextInput Key="ExportOptionsPath" Label="导出配置文件路径" Placeholder="完整 .json 文件路径" Class="world-input" />
            <StackPanel Class="world-actions">
              <Button Key="Export.LoadOptions" Content="导入配置" Command="ui.settings.management.action" Class="settings-catalog-action world-button-health" />
              <Button Key="Export.SaveOptions" Content="导出配置" Command="ui.settings.management.action" Class="settings-catalog-action world-button-health" Enabled="{data enabled}" />
            </StackPanel>
          </StackPanel>
        </StackPanel>
        <Button Key="Management.导出整合包" Content="导出整合包" Command="ui.settings.management.action" Class="settings-catalog-action world-button-health" Enabled="{data enabled}" />
      </StackPanel>
      <StackPanel Class="world-card-body">
        <Text Content="按实例导出启动脚本" Class="world-title" />
        <Text Content="脚本通过启动器刷新账户后启动此实例，不保存登录令牌。" Class="world-hint" />
        <TextInput Key="Script.Launcher" Label="启动器可执行文件" Placeholder="完整的 Nexa.Desktop 可执行文件路径" Class="world-input" />
        <TextInput Key="Script.Destination" Label="启动脚本保存路径" Placeholder="完整 .cmd、.bat 或 .sh 路径" Class="world-input" />
        <Button Key="Script.Export" Content="导出启动脚本" Enabled="{data enabled}" Command="ui.settings.management.action" Class="settings-catalog-action world-button-wide" />
      </StackPanel>
      <Text Content="{data error}" Class="world-hint" IsVisible="{data hasError}" Localize="false" />
    </StackPanel>
    <LoadingView IsVisible="{data loading}">
      <Text Content="正在统计可导出的文件…" Class="loading-hint" LiveSetting="Polite" />
    </LoadingView>
  </StackPanel>
</nxml-dynamic>
