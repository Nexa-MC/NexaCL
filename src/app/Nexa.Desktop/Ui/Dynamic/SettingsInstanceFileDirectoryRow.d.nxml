<nxml-dynamic><StackPanel Key="{data row}" Class="instance-tools-file-row"><Text Content="{data name}" Label="{data name}" Localize="false" MaxLines="1" TrimOverflow="true" Class="instance-tools-file-name" /><Text Content="文件夹" Class="instance-tools-file-size" /><Button Key="{data action}" Content="浏览" Command="ui.settings.management.action" Enabled="{data enabled}" Class="settings-catalog-action instance-tools-area" /></StackPanel></nxml-dynamic>
