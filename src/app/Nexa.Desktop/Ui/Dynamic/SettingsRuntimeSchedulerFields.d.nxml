<nxml-dynamic>
<StackPanel Class="settings-diagnostics-fields">
<StackPanel Key="SettingsRuntime.Scheduler.PendingState" Class="settings-diagnostics-field"><Text Content="待合并状态数量" Class="settings-runtime-label" /><Text Key="SettingsRuntime.Scheduler.PendingState.Value" Content="{data PendingState}" Label="{data PendingState}" Localize="false" MaxLines="1" TrimOverflow="true" Class="settings-diagnostics-value" /></StackPanel>
<StackPanel Key="SettingsRuntime.Scheduler.ActiveTracks" Class="settings-diagnostics-field"><Text Content="原生活动动画轨道" Class="settings-runtime-label" /><Text Key="SettingsRuntime.Scheduler.ActiveTracks.Value" Content="{data ActiveTracks}" Label="{data ActiveTracks}" Localize="false" MaxLines="1" TrimOverflow="true" Class="settings-diagnostics-value" /></StackPanel>
<StackPanel Key="SettingsRuntime.Scheduler.ClockRunning" Class="settings-diagnostics-field"><Text Content="动画时钟" Class="settings-runtime-label" /><Text Key="SettingsRuntime.Scheduler.ClockRunning.Value" Content="{data ClockRunning}" Label="{data ClockRunning}" Localize="false" MaxLines="1" TrimOverflow="true" Class="settings-diagnostics-value" /></StackPanel>
<StackPanel Key="SettingsRuntime.Scheduler.TargetRate" Class="settings-diagnostics-field"><Text Content="动画时钟目标频率" Class="settings-runtime-label" /><Text Key="SettingsRuntime.Scheduler.TargetRate.Value" Content="{data TargetRate} Hz" Label="{data TargetRate} Hz" Localize="false" MaxLines="1" TrimOverflow="true" Class="settings-diagnostics-value" /></StackPanel>
<StackPanel Key="SettingsRuntime.Scheduler.ObservedRate" Class="settings-diagnostics-field"><Text Content="最近两秒时钟观测频率" Class="settings-runtime-label" /><Text Key="SettingsRuntime.Scheduler.ObservedRate.Value" Content="{data ObservedRate}" Label="{data ObservedRate}" Localize="false" MaxLines="1" TrimOverflow="true" Class="settings-diagnostics-value" /></StackPanel>
<StackPanel Key="SettingsRuntime.Scheduler.MotionPolicy" Class="settings-diagnostics-field"><Text Content="动态策略" Class="settings-runtime-label" /><Text Key="SettingsRuntime.Scheduler.MotionPolicy.Value" Content="{data MotionPolicy}" Label="{data MotionPolicy}" Localize="false" MaxLines="1" TrimOverflow="true" Class="settings-diagnostics-value" /></StackPanel>
</StackPanel>
</nxml-dynamic>
