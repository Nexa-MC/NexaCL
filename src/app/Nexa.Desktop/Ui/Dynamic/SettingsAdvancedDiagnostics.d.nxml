<nxml-dynamic>
<StackPanel Key="AdvancedWorkspace.Diagnostics" Class="settings-diagnostics-card"><StackPanel Class="settings-advanced-body"><Text Content="高级运行事实" Class="settings-advanced-title" />
<Button Key="AdvancedWorkspace.Capture" Content="捕获高级状态" Command="ui.settings.management.action" Class="settings-catalog-action settings-advanced-action" />
<StackPanel Class="settings-diagnostics-field"><Text Content="开发者模式" Class="settings-advanced-label" /><Text Key="AdvancedWorkspace.Fact.developer" Content="{data developer}" Label="{data developer}" Localize="false" MaxLines="1" TrimOverflow="true" Class="settings-advanced-fact" /></StackPanel><StackPanel Class="settings-diagnostics-field"><Text Content="场景节点数量" Class="settings-advanced-label" /><Text Key="AdvancedWorkspace.Fact.nodes" Content="{data nodes}" Label="{data nodes}" Localize="false" MaxLines="1" TrimOverflow="true" Class="settings-advanced-fact" /></StackPanel><StackPanel Class="settings-diagnostics-field"><Text Content="原生活动动画轨道" Class="settings-advanced-label" /><Text Key="AdvancedWorkspace.Fact.tracks" Content="{data tracks}" Label="{data tracks}" Localize="false" MaxLines="1" TrimOverflow="true" Class="settings-advanced-fact" /></StackPanel><StackPanel Class="settings-diagnostics-field"><Text Content="动画时钟" Class="settings-advanced-label" /><Text Key="AdvancedWorkspace.Fact.clock" Content="{data clock}" Label="{data clock}" Localize="false" MaxLines="1" TrimOverflow="true" Class="settings-advanced-fact" /></StackPanel><StackPanel Class="settings-diagnostics-field"><Text Content="图像准入预算字节" Class="settings-advanced-label" /><Text Key="AdvancedWorkspace.Fact.budget" Content="{data budget}" Label="{data budget}" Localize="false" MaxLines="1" TrimOverflow="true" Class="settings-advanced-fact" /></StackPanel>
</StackPanel></StackPanel>
</nxml-dynamic>
