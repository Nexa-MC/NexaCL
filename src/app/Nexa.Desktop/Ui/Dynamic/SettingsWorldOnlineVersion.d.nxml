<nxml-dynamic><StackPanel Key="{data key}" Class="world-actions"><Image Source="lucide/circle-check" IsVisible="{data release}" Class="world-version-icon" /><Image Source="lucide/flask-conical" IsVisible="{data beta}" Class="world-version-icon" /><Image Source="lucide/test-tube" IsVisible="{data other}" Class="world-version-icon" /><Text Content="{data number} · {data channel}" Class="world-version-name" Localize="false" /><Button Key="{data changelog}" Content="更新日志" Command="ui.settings.management.action" Class="settings-catalog-action world-button" IsVisible="{data canChangelog}" /><Button Key="{data reinstall}" Content="重新安装" Command="ui.settings.management.action" Class="settings-catalog-action world-button" IsVisible="{data canReinstall}" /><Button Key="{data install}" Content="安装此版本" Command="ui.settings.management.action" Class="settings-catalog-action world-button" IsVisible="{data canInstall}" /></StackPanel></nxml-dynamic>
