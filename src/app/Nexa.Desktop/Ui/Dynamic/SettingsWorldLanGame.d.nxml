<nxml-dynamic>
  <StackPanel Key="{data key}" Class="world-card">
    <StackPanel Class="world-card-body">
      <StackPanel Orientation="{data actionDirection}" Class="world-actions">
        <StackPanel Class="world-server-identity">
          <Text Key="{data nameKey}" Content="{data name}" Localize="false" Class="world-server-name" MaxLines="1" TrimOverflow="true" />
          <Text Content="{data address}" Localize="false" Class="world-hint" MaxLines="1" TrimOverflow="true" />
        </StackPanel>
        <Button Key="{data join}" Content="加入" Command="ui.settings.management.action" Class="settings-catalog-action world-button-small" IsVisible="{data canJoin}" />
      </StackPanel>
    </StackPanel>
  </StackPanel>
</nxml-dynamic>
