<nxml-dynamic>
  <StackPanel Key="WorldSnapshots" Class="world-card">
    <StackPanel Class="world-card-body">
      <Text Content="世界快照" Class="world-title" />
      <StackPanel Orientation="{data actionDirection}" Class="world-actions">
        <Button Key="Management.读取快照历史" Content="读取快照历史" Command="ui.settings.management.action" Class="settings-catalog-action world-button-health" Enabled="{data enabled}" />
        <Button Key="Management.创建世界快照" Content="创建世界快照" Command="ui.settings.management.action" Class="settings-catalog-action world-button-health" Enabled="{data enabled}" />
      </StackPanel>
      <LoadingView IsVisible="{data busy}">
        <Text Content="正在处理世界快照…" Class="loading-hint" LiveSetting="Polite" />
      </LoadingView>
      <Dynamic Key="WorldSnapshots.Rows" Class="world-rows" />
      <Text Content="显示最近 16 个世界快照。" Class="world-hint" IsVisible="{data truncated}" />
      <Text Content="{data message}" Class="world-hint" IsVisible="{data hasMessage}" Localize="false" />
    </StackPanel>
  </StackPanel>
</nxml-dynamic>
