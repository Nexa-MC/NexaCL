<nxml-dynamic><StackPanel Key="FileWorkspace.SavePreview" Class="instance-tools-stack"><Text Content="保存预览：{data previousBytes} → {data updatedBytes} bytes，{data previousLines} → {data updatedLines} 行。原件将保留为 .nexa-backup。" Localize="false" MaxLines="3" Class="instance-tools-hint" /><Button Key="FileWorkspace.Save" Content="确认保存配置" Enabled="{data canSave}" Command="ui.settings.management.action" Class="settings-catalog-action instance-tools-back" /></StackPanel></nxml-dynamic>
