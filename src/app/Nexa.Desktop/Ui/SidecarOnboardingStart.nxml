<Page Key="VersionedOnboardingStart" Label="欢迎回来">
  <StackPanel Margin="40" Spacing="24" MaxWidth="680" HorizontalAlignment="Center" VerticalAlignment="Center">
    <Image Source="lucide/star" Width="56" Height="56" Foreground="#0B5BCB" />
    <Text Content="让我们完成新的设置" FontSize="30" FontWeight="600" Foreground="#343D4A" />
    <Text Content="这次只会显示你尚未完成的新引导。之前的设置会保留。" FontSize="16" Foreground="#606C7C" WrapText="true" />
    <Button Key="VersionedOnboardingBegin" Content="开始" Label="开始引导" Command="ui.onboarding.begin" Width="160" Height="44" Background="#0B5BCB" Foreground="#FFFFFF" CornerRadius="12" TextAlignment="Center" />
  </StackPanel>
</Page>
