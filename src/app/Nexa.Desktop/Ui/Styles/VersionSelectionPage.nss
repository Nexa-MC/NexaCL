/* VersionSelectionPage layout. */
.layout-VersionSelectionPage-LibraryContent { Orientation: Vertical; Weight: 1; Spacing: 10; }
.layout-VersionSelectionPage-LibraryDirectoryBar { Orientation: Horizontal; Height: 40; Spacing: 8; }
.layout-VersionSelectionPage-LibraryDirectoryCaption { Width: 76; VerticalAlignment: Center; }
.layout-VersionSelectionPage-LibraryChooseDirectory { Weight: 1; Height: 40; }
.layout-VersionSelectionPage-6 { Orientation: Horizontal; Spacing: 12; Margin: 14,0,12,0; }
.layout-VersionSelectionPage-LibraryDirectoryName { Weight: 1; VerticalAlignment: Center; }
.layout-VersionSelectionPage-LibraryDirectoryPath { Weight: 2; VerticalAlignment: Center; }
.layout-VersionSelectionPage-LibraryDirectoryChevron { Width: 16; Height: 16; VerticalAlignment: Center; }
.layout-VersionSelectionPage-LibraryAddDirectory { Width: 120; Height: 40; }
.layout-VersionSelectionPage-LibraryRefresh { Width: 40; Height: 40; }
.layout-VersionSelectionPage-LibraryVersions { Orientation: Vertical; Weight: 1; }
.layout-VersionSelectionPage-13 { Orientation: Horizontal; Height: 36; Spacing: 12; Margin: 2,0,2,10; }
.layout-VersionSelectionPage-LibraryCount { Weight: 1; VerticalAlignment: Center; }
.layout-VersionSelectionPage-LibrarySearch { Width: 208; Height: 36; }
.layout-VersionSelectionPage-LibraryVersionRows { Orientation: Vertical; Weight: 1; Spacing: 0; }
.layout-VersionSelectionPage-LibraryEmpty { Height: 56; Margin: 18,16,18,0; }
