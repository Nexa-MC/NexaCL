.plugin-workspace { Orientation: Vertical; Spacing: 16; Padding: 24; }
.plugin-title { Height: 36; FontSize: 24; FontWeight: 600; }
.plugin-copy { Height: 44; FontSize: 13; WrapText: true; }
.plugin-name { Height: 28; FontSize: 16; FontWeight: 600; }
.plugin-row { Orientation: Vertical; Spacing: 8; Padding: 12; }
.plugin-button { Width: 160; Height: 40; }
.plugin-link { Height: 44; }
.plugin-list { Weight: 1; Spacing: 12; }
.plugin-dialog { Width: 720; Height: 560; Padding: 24; Spacing: 12; Background: #FF202832; }
