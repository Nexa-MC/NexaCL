.account-form-slot { Weight: 1; }
.account-base { Surface: Solid; Background: #00000000; Foreground: #343D4A; CornerRadius: 12; FontSize: 14; FontWeight: 400; TextAlignment: Start; }
.account-button { Background: #F4F6FA; Hover: #739EDC23; FontWeight: 600; TextAlignment: Center; }
.account-input { Background: #F4F6FA; Border: #DAE1EB; BorderWidth: 1; }
.account-primary { Background: #0B5BCB; Foreground: #FFFFFF; }
.account-code { FontSize: 22; FontWeight: 600; TextAlignment: Center; }
.account-help { FontSize: 12; WrapText: true; }
