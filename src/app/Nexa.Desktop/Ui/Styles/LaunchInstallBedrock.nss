/* Bedrock official handoff preserves the existing typography and capsule palette. */
.launch-install-bedrock-base { Foreground: #343D4A; Background: #00000000; Hover: #CFE1FE; FontSize: 14; CornerRadius: 0; WrapText: true; TextAlignment: Start; }
.launch-install-bedrock-workspace-slot, .launch-install-bedrock-host { Weight: 1; }
