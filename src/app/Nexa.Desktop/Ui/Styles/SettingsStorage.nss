/* General observation and storage/transfer settings. */
.settings-runtime-groups { Orientation: Vertical; Spacing: 18; }
.settings-storage-location { Height: 26; FontSize: 12; Foreground: #2b3340; }
.settings-storage-hint { Height: 34; FontSize: 11; Foreground: #5e6e82; WrapText: true; }
.settings-storage-move { Width: 112; }
.settings-storage-action { Width: 84; }
.settings-storage-cleanup-row { Orientation: Horizontal; Spacing: 12; Padding: 0,6,0,6; }
.settings-storage-labels { Orientation: Vertical; Spacing: 3; Weight: 1; }
.settings-storage-label { Height: 22; FontSize: 14; FontWeight: 500; Foreground: #2b3340; }
.settings-storage-cleanup-description { Height: 32; FontSize: 11; Foreground: #5e6e82; WrapText: true; }
.settings-storage-path-row { Orientation: Horizontal; Spacing: 16; Padding: 0,9,0,9; }
.settings-storage-path-label { Width: 136; FontSize: 13; FontWeight: 500; Foreground: #2b3340; WrapText: true; }
.settings-storage-paths { Orientation: Vertical; Spacing: 5; Weight: 1; }
.settings-storage-path { FontSize: 12; Foreground: #5e6e82; WrapText: true; TextAlignment: End; }
.settings-storage-state { Height: 30; FontSize: 12; Foreground: #5e6e82; }
.settings-transfer-row { Orientation: Horizontal; Spacing: 16; Padding: 0,6,0,6; }
.settings-transfer-description { Height: 22; FontSize: 11; Foreground: #5e6e82; }
 .settings-storage-rows { Orientation: Vertical; Spacing: 0; }
