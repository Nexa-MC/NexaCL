/* Complete resource discovery, retained rows, detail and dependency confirmation. */
.resource-base { Background: #00000000; Foreground: #2B3340; CornerRadius: 0; FontSize: 13; FontWeight: 400; Hover: #cfe1fe; Surface: Solid; }
.resource-workspace-slot, .resource-workspace { Weight: 1; }
.resource-button { Height: 40; VerticalAlignment: Center; Background: #f1f5fa; Foreground: #0b5bcb; CornerRadius: 10; TextAlignment: Center; }
.resource-search-surface { Orientation: Vertical; Weight: 1; Background: #f1f5fa; Foreground: #2b3340; CornerRadius: 10; }
.resource-search { Height: 40; Padding: 12,0,12,0; }
.resource-search-button { Width: 56; }
.resource-current { Width: 76; }
.resource-reset { Width: 48; }
.resource-track { Orientation: Horizontal; Spacing: 0; MaxWidth: 960; Background: #f1f5fa; Foreground: #2b3340; CornerRadius: 10; }
.resource-track-fill { Weight: 1; }
.resource-option { Height: 34; VerticalAlignment: Center; TextAlignment: Center; CornerRadius: 8; }
.resource-option-small { Height: 28; }
.resource-thumb { Background: #ffffff; Foreground: #2b3340; CornerRadius: 8; }
.resource-status { Height: 28; Weight: 1; FontSize: 12; Foreground: #5e6e82; }
.resource-page-button { Width: 76; Height: 28; }
.resource-check { Width: 84; Height: 28; FontSize: 12; Foreground: #5e6e82; CornerRadius: 6; TextAlignment: Center; VerticalAlignment: Center; }
.resource-extension { Background: #f1f5fa; CornerRadius: 10; }
.resource-detail-body { Orientation: Vertical; Weight: 1; Padding: 0,0,0,8; Spacing: 2; }
.resource-column { Orientation: Vertical; Spacing: 2; }
.resource-row { Orientation: Horizontal; Spacing: 12; }
.resource-copy { Orientation: Vertical; Spacing: 2; Weight: 1; }
.resource-card { Orientation: Vertical; Spacing: 2; Background: #ffffff; CornerRadius: 10; }
.resource-card-body { Orientation: Horizontal; Margin: 16,12,16,12; Spacing: 12; }
.resource-project { Orientation: Vertical; Height: 168; Background: #ffffff; Border: #e4e9f0; BorderWidth: 1; CornerRadius: 14; }
.resource-grid-row { Orientation: Horizontal; }
.resource-project-body { Orientation: Vertical; Margin: 16,14,16,14; Spacing: 8; Weight: 1; }
.resource-project-heading { Orientation: Horizontal; Height: 42; Spacing: 10; }
.resource-project-actions { Orientation: Horizontal; Height: 30; Spacing: 6; }
.resource-project-action-fill { Weight: 1; }
.resource-project-action { Height: 30; }
.resource-project-icon { Width: 42; Height: 42; VerticalAlignment: Center; Background: #f1f5fa; Foreground: #5e6e82; CornerRadius: 10; }
.resource-project-title { Height: 22; FontSize: 15; FontWeight: 600; }
.resource-project-description { Height: 42; FontSize: 13; Foreground: #5e6e82; WrapText: true; }
.resource-project-metadata { Height: 18; FontSize: 11; Foreground: #5e6e82; }
.resource-icon-button { Width: 76; HoverExpand: true; }
.resource-message { Height: 54; FontSize: 14; Foreground: #5e6e82; }
.resource-retry { Width: 80; }
.resource-detail-icon { Width: 64; Height: 64; Background: #f1f5fa; Foreground: #5e6e82; CornerRadius: 14; }
.resource-detail-title { Height: 36; FontSize: 25; FontWeight: 650; }
.resource-detail-author { Height: 24; FontSize: 12; Foreground: #5e6e82; }
.resource-detail-description { Height: 68; FontSize: 14; Foreground: #5e6e82; }
.resource-detail-notice { Height: 24; FontSize: 12; Foreground: #5e6e82; }
.resource-detail-info { Height: 34; Weight: 1; FontSize: 12; Foreground: #5e6e82; }
.resource-website { Width: 110; }
.resource-detail-versions-title { Height: 36; FontSize: 16; FontWeight: 600; }
.resource-detail-empty { Height: 48; FontSize: 14; Foreground: #5e6e82; }
.resource-version-type { Width: 22; Height: 22; VerticalAlignment: Center; }
.resource-version-release { Foreground: #28875a; }
.resource-version-beta { Foreground: #0b5bcb; }
.resource-version-alpha, .resource-favorite-active { Foreground: #bc7d2a; }
.resource-version-title { Height: 28; FontSize: 15; FontWeight: 550; }
.resource-version-metadata { Height: 34; FontSize: 12; Foreground: #5e6e82; }
.resource-version-page { Width: 68; }
.resource-version-page-text { Height: 34; FontSize: 12; Foreground: #5e6e82; }
.resource-optional-title { Height: 38; FontSize: 24; FontWeight: 650; }
.resource-optional-summary { Height: 36; FontSize: 13; Foreground: #5e6e82; }
.resource-optional-name { Height: 32; Weight: 1; FontSize: 14; }
.resource-optional-toggle { Width: 86; }
.resource-optional-cancel { Width: 76; }
.resource-extension-title { Height: 22; FontSize: 14; FontWeight: 600; }
.resource-extension-body { FontSize: 13; Foreground: #5e6e82; WrapText: true; }
.resource-extension-stack { Orientation: Vertical; Spacing: 2; }
.resource-extension-row { Orientation: Horizontal; Spacing: 12; }
.resource-extension-button { Width: 150; }
.resource-extension-text { Height: 28; }
.resource-extension-image { Width: 160; Height: 120; }
.resource-extension-label { Height: 22; FontSize: 12; Foreground: #5e6e82; }
.resource-extension-input-surface { Width: 220; Weight: 0; }
.resource-extension-submit { Width: 68; }
/* Finite viewport metrics and text-width estimates. */
.resource-metric-virtual { Height: 168; Spacing: 12; Width: 48; MinWidth: 280; Padding: 4; MaxHeight: 600; MaxWidth: 100000; }
.resource-metric-selector { Width: 13; Height: 7; Padding: 20; }
.resource-metric-overlay { MaxHeight: 340; MinHeight: 80; Height: 120; Margin: 220,0,0,0; Padding: 16; Width: 34; Spacing: 40; }
