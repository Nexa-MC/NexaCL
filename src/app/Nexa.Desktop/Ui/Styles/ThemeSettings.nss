/* Finite host-authored NTP/1 management and option editors. */
.theme-surface { Orientation: Vertical; Spacing: 12; Padding: 16; }
.theme-rows { Orientation: Vertical; Spacing: 0; }
.theme-actions { Orientation: Horizontal; Spacing: 8; MinHeight: 34; VerticalAlignment: Center; }
.theme-entry { Orientation: Vertical; Background: #f5f6f8; CornerRadius: 9; Surface: Solid; }
.theme-entry-body { Orientation: Vertical; Spacing: 8; Padding: 12; }
.theme-entry-header { Orientation: Horizontal; Spacing: 12; VerticalAlignment: Center; }
.theme-name { MinHeight: 22; FontSize: 15; FontWeight: 600; Foreground: #2b3340; Weight: 1; }
.theme-version { MinHeight: 22; FontSize: 11; Foreground: #5e6e82; }
.theme-selected { Height: 22; Width: 56; FontSize: 11; Foreground: #0b5bcb; }
.theme-description { MinHeight: 18; FontSize: 11; Foreground: #5e6e82; WrapText: true; }
.theme-error { MinHeight: 20; FontSize: 12; Foreground: #d03b47; WrapText: true; }
.theme-action { Width: 92; Height: 34; Background: #f2f5f9; Foreground: #0b5bcb; CornerRadius: 8; FontSize: 12; TextAlignment: Center; Surface: Solid; Hover: #cfe1fe; }
.theme-action-small { Width: 56; Height: 34; Background: #f2f5f9; Foreground: #0b5bcb; CornerRadius: 8; FontSize: 12; TextAlignment: Center; Surface: Solid; Hover: #cfe1fe; }
.theme-watch { Width: 106; Height: 34; FontSize: 12; Foreground: #2b3340; }
.theme-option { Orientation: Vertical; Spacing: 0; }
.theme-option-row { Orientation: Horizontal; Spacing: 16; MinHeight: 44; Padding: 0,6,0,6; VerticalAlignment: Center; }
.theme-option-editor { Orientation: Vertical; Spacing: 6; Weight: 1; VerticalAlignment: Center; }
.theme-group { Height: 32; FontSize: 13; FontWeight: 600; Foreground: #5e6e82; VerticalAlignment: Center; }
.theme-option-label { Width: 184; MinHeight: 34; FontSize: 14; FontWeight: 500; Foreground: #2b3340; VerticalAlignment: Center; WrapText: true; }
.theme-option-divider { Height: 1; Background: #e8ecf2; Surface: Solid; }
.theme-input { Height: 34; MinWidth: 120; Weight: 1; Padding: 10,0,10,0; Background: #f5f6f8; Foreground: #2b3340; CornerRadius: 8; FontSize: 13; Surface: Solid; Hover: #cfe1fe; }
.theme-range-input { Width: 104; Weight: 0; }
.theme-range { Orientation: Horizontal; Spacing: 12; VerticalAlignment: Center; }
.theme-slider { Height: 30; MinWidth: 80; Weight: 1; Background: #cbd4e0; Foreground: #0b5bcb; CornerRadius: 2; Surface: None; }
.theme-step { Width: 34; Height: 34; FontSize: 16; Foreground: #0b5bcb; Background: #f2f5f9; CornerRadius: 8; TextAlignment: Center; Surface: Solid; Hover: #cfe1fe; }
.theme-color-swatch { Width: 34; Height: 34; CornerRadius: 8; Border: #cbd4e0; BorderWidth: 1; Surface: Solid; }
.theme-selector-surface { Height: 40; }
.theme-binary-selector { Width: 126; HorizontalAlignment: End; }
.theme-choices { Orientation: Horizontal; HorizontalAlignment: End; Spacing: 0; Padding: 3; Height: 40; Background: #f1f5fa; Foreground: #2b3340; CornerRadius: 9; Surface: Solid; }
.theme-selector-thumb { Background: #ffffff; Foreground: #2b3340; CornerRadius: 7; Surface: Solid; }
.theme-choice { Height: 34; FontSize: 12; FontWeight: 500; Foreground: #0b5bcb; CornerRadius: 7; TextAlignment: Center; Hover: #cfe1fe; Surface: Solid; VerticalAlignment: Center; }
.theme-binary-choice { Width: 60; }
.theme-switch { Width: 56; Height: 34; HorizontalAlignment: End; Foreground: #0b5bcb; Surface: None; }
.theme-checkbox { Width: 34; Height: 34; HorizontalAlignment: End; Foreground: #0b5bcb; Surface: None; }
.theme-option-value { MinHeight: 22; FontSize: 13; Foreground: #2b3340; }
.theme-picker { Width: 108; }
.theme-path { MinHeight: 18; FontSize: 11; Foreground: #5e6e82; }
.theme-file-path { MinHeight: 28; Weight: 1; FontSize: 12; Foreground: #2b3340; WrapText: true; }
