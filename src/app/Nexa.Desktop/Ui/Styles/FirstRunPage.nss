.layout-FirstRunPage-SetupStart { Width: 148; Height: 42; }
.layout-FirstRunPage-SetupDirectory { Orientation: Vertical; Spacing: 10; }
.layout-FirstRunPage-SetupDirectoryLabel { Height: 24; }
.layout-FirstRunPage-12 { Orientation: Horizontal; Spacing: 10; }
.layout-FirstRunPage-SetupPathSurface { Weight: 1; Height: 64; }
.layout-FirstRunPage-SetupPath { Height: 40; Padding: 12; }
.layout-FirstRunPage-SetupBrowse { Width: 80; Height: 40; VerticalAlignment: Center; }
.layout-FirstRunPage-SetupConsent { Orientation: Vertical; Spacing: 10; }
.layout-FirstRunPage-SetupPrivate { Height: 44; }
.layout-FirstRunPage-SetupShare { Height: 44; }
.layout-FirstRunPage-SetupSummarySurface { Height: 166; }
.layout-FirstRunPage-SetupSummary { Height: 134; Padding: 16; }
.layout-FirstRunPage-SetupFooter { Orientation: Horizontal; Height: 42; Spacing: 12; }
