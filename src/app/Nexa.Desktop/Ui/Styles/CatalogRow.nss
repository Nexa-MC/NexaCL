/* CatalogRow layout. */
.layout-CatalogRow-CatalogRow { Height: 48; }
.layout-CatalogRow-2 { Orientation: Horizontal; Spacing: 12; Weight: 1; Margin: 12,0,12,0; }
.layout-CatalogRow-CatalogCheck { Width: 18; Height: 18; VerticalAlignment: Center; }
.layout-CatalogRow-CatalogName { Weight: 1; Height: 24; VerticalAlignment: Center; }
.layout-CatalogRow-CatalogDetail { Width: 160; Height: 20; VerticalAlignment: Center; }
