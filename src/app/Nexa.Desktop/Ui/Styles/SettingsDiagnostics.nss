/* Read-only developer diagnostics; no fixed presentation in controllers. */
.settings-diagnostics-card { Orientation: Vertical; Spacing: 0; Background: #ffffff; CornerRadius: 12; Surface: Solid; }
.settings-diagnostics-body { Orientation: Vertical; Padding: 20,14,20,14; Spacing: 8; }
.settings-diagnostics-toolbar { Orientation: Horizontal; Spacing: 12; }
.settings-diagnostics-title { Weight: 1; Height: 36; FontSize: 14; FontWeight: 600; Foreground: #2b3340; }
.settings-diagnostics-refresh { Width: 36; Height: 36; Background: #f2f5f9; Foreground: #0b5bcb; CornerRadius: 10; Surface: Solid; }
.settings-diagnostics-hint { Height: 24; FontSize: 11; Foreground: #5e6e82; }
.settings-diagnostics-fields { Orientation: Vertical; Spacing: 4; }
.settings-diagnostics-field { Orientation: Horizontal; Spacing: 12; }
.settings-diagnostics-label { Width: 144; Height: 26; FontSize: 12; Foreground: #5e6e82; }
.settings-diagnostics-value-slot { Weight: 1; }
.settings-diagnostics-value { Weight: 1; Height: 26; FontSize: 12; Foreground: #2b3340; }
.settings-diagnostics-page { Width: 76; }
.settings-diagnostics-rows { Orientation: Vertical; Spacing: 6; }
.settings-diagnostics-entry { Orientation: Vertical; Spacing: 2; }
.settings-diagnostics-summary { Height: 26; FontSize: 12; Foreground: #5e6e82; }
.settings-diagnostics-id { Height: 24; FontSize: 12; Foreground: #2b3340; }
.settings-diagnostics-metadata { Height: 36; FontSize: 11; Foreground: #5e6e82; WrapText: true; }
