/* VersionSelectionRow layout. */
.layout-VersionSelectionRow-LibraryRow { Height: 72; }
.layout-VersionSelectionRow-2 { Orientation: Horizontal; Spacing: 12; Margin: 16,12,16,12; }
.layout-VersionSelectionRow-3 { Width: 18; VerticalAlignment: Center; }
.layout-VersionSelectionRow-LibraryRowCheck { Width: 18; Height: 18; }
.layout-VersionSelectionRow-LibraryRowIcon { Width: 28; Height: 28; VerticalAlignment: Center; }
.layout-VersionSelectionRow-6 { Orientation: Vertical; Weight: 1; VerticalAlignment: Center; }
.layout-VersionSelectionRow-7 { Orientation: Horizontal; Spacing: 6; Height: 24; }
.layout-VersionSelectionRow-LibraryRowName { Height: 24; Weight: 1; }
.layout-VersionSelectionRow-LibraryRowDetail { Height: 20; }
.layout-VersionSelectionRow-LibraryRowModify { Width: 76; Height: 32; VerticalAlignment: Center; }
.layout-VersionSelectionRow-LibraryRowSettings { Width: 76; Height: 32; VerticalAlignment: Center; }
.layout-VersionSelectionRow-LibraryRowDelete { Width: 76; Height: 32; VerticalAlignment: Center; }
