/* AccountProfileRow layout. */
.layout-AccountProfileRow-AccountRow { Height: 56; }
.layout-AccountProfileRow-2 { Orientation: Horizontal; Spacing: 10; Margin: 10,8,10,8; }
.layout-AccountProfileRow-ProfileAvatar { Width: 40; Height: 40; VerticalAlignment: Center; }
.layout-AccountProfileRow-4 { Orientation: Vertical; Spacing: 2; Weight: 1; VerticalAlignment: Center; }
.layout-AccountProfileRow-ProfileName { Height: 20; }
.layout-AccountProfileRow-ProfileDetail { Height: 16; }
.layout-AccountProfileRow-ProfileDelete { Width: 28; Height: 28; VerticalAlignment: Center; }
