/* Official acquisition pages use the host's palette in light, dark and custom themes. */
.official-download-layout { Orientation: Vertical; Width: 820; Spacing: 16; HorizontalAlignment: Center; VerticalAlignment: Center; }
.official-download-card { Orientation: Vertical; Background: #FFFFFF; Foreground: #343D4A; Border: #E0EAFD; BorderWidth: 1; CornerRadius: 20; Surface: Solid; }
.official-download-card-body { Orientation: Vertical; Padding: 28; Spacing: 20; }
.official-download-header { Orientation: Horizontal; Spacing: 20; }
.official-download-icon-well { Width: 72; Height: 72; CornerRadius: 18; Surface: Solid; }
.official-download-java { Background: #E5EFFF; Foreground: #1C61D2; }
.official-download-bedrock { Background: #EBF4E9; Foreground: #396945; }
.official-download-java-ink { Foreground: #1C61D2; }
.official-download-bedrock-ink { Foreground: #396945; }
.official-download-icon { Width: 36; Height: 36; HorizontalAlignment: Center; VerticalAlignment: Center; }
.official-download-heading { Orientation: Vertical; Weight: 1; Spacing: 4; VerticalAlignment: Center; }
.official-download-eyebrow { FontSize: 11; FontWeight: 600; Foreground: #7A8A99; MinHeight: 16; }
.official-download-title { FontSize: 28; FontWeight: 650; Foreground: #343D4A; MinHeight: 38; WrapText: true; }
.official-download-description { FontSize: 14; Foreground: #606C7C; MinHeight: 40; WrapText: true; }
.official-download-actions { Orientation: Horizontal; Height: 44; Spacing: 12; }
.official-download-button { Height: 44; FontSize: 14; FontWeight: 600; CornerRadius: 12; TextAlignment: Center; WrapText: false; Surface: Solid; }
.official-download-primary { Width: 228; Background: #0B5BCB; Foreground: #FFFFFF; Hover: #1370F3; }
.official-download-secondary { Width: 152; Background: #F4F6FA; Foreground: #343D4A; Hover: #E0EAFD; }
.official-download-action-hint { Weight: 1; VerticalAlignment: Center; FontSize: 12; Foreground: #7A8A99; WrapText: true; }
.official-download-notes { Orientation: Vertical; Background: #F4F6FA; Foreground: #606C7C; CornerRadius: 14; Surface: Solid; }
.official-download-notes-body { Orientation: Vertical; Padding: 20,16,20,16; Spacing: 6; }
.official-download-note-title { FontSize: 13; FontWeight: 600; Foreground: #343D4A; MinHeight: 20; }
.official-download-note { FontSize: 12; Foreground: #606C7C; MinHeight: 18; WrapText: true; }
