/* VersionDirectoryRow layout. */
.layout-VersionDirectoryRow-LibraryRow { Height: 48; }
.layout-VersionDirectoryRow-2 { Orientation: Horizontal; Margin: 10,0,16,0; Spacing: 8; }
.layout-VersionDirectoryRow-LibraryDirectoryRowName { Weight: 1; VerticalAlignment: Center; }
.layout-VersionDirectoryRow-LibraryDirectoryRowPath { Weight: 2; VerticalAlignment: Center; }
.layout-VersionDirectoryRow-LibraryDirectoryRowCheck { Width: 16; Height: 16; VerticalAlignment: Center; }
.layout-VersionDirectoryRow-LibraryDirectoryRename { Width: 28; Height: 28; VerticalAlignment: Center; }
.layout-VersionDirectoryRow-LibraryDirectoryForget { Width: 28; Height: 28; VerticalAlignment: Center; }
