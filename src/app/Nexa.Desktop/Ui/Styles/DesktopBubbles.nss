/* Top margin declares the inter-bubble gap; right/bottom margins are the base dock inset. */
.desktop-bubble { Height: 48; MaxWidth: 420; Margin: 0,10,18,18; HorizontalAlignment: End; VerticalAlignment: End; Surface: Solid; CornerRadius: 24; HoverExpand: true; FontSize: 13; WrapText: false; }
.task-bubble-track { Width: 12; Height: 12; Margin: 16,0,0,1; HorizontalAlignment: Start; VerticalAlignment: End; Background: #00000000; }
.task-bubble-fill { Foreground: #206ee0; }
