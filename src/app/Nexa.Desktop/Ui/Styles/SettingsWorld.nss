/* Owned world/server/export/online workspaces. */
.world-stack { Orientation: Vertical; Spacing: 12; }
.world-rows { Orientation: Vertical; Spacing: 8; }
.world-actions { Orientation: Horizontal; Spacing: 10; VerticalAlignment: Center; }
.world-fact { Orientation: Horizontal; Spacing: 12; }
.world-label { Width: 120; Height: 30; Foreground: #5e6e82; FontSize: 13; }
.world-value { Weight: 1; MinHeight: 30; Foreground: #2b3340; FontSize: 13; TextAlignment: End; WrapText: true; }
.world-title { Height: 30; FontSize: 16; FontWeight: 600; Foreground: #2b3340; }
.world-hint { MinHeight: 28; FontSize: 12; Foreground: #5e6e82; WrapText: true; }
.world-message { MinHeight: 30; FontSize: 13; Foreground: #2b3340; WrapText: true; }
.world-button { Width: 96; }
.world-button-small { Width: 64; }
.world-button-wide { Width: 116; }
.world-button-health { Width: 128; }
.world-pack-name { Weight: 1; MinHeight: 36; FontSize: 13; Foreground: #2b3340; WrapText: true; }
.world-card { Orientation: Vertical; Background: #ffffff; Foreground: #2b3340; CornerRadius: 12; Surface: Solid; }
.world-card-body { Orientation: Vertical; Spacing: 8; Padding: 16,10,16,10; }
.world-snapshot-row { Orientation: Vertical; Spacing: 6; }
.world-counter { Height: 36; FontSize: 12; Foreground: #5e6e82; }
.world-field { Orientation: Horizontal; Spacing: 12; }
.world-field-label { Width: 100; Height: 36; FontSize: 13; Foreground: #5e6e82; }
.world-input { Weight: 1; Height: 36; Padding: 12,0,12,0; Background: #f1f5fa; Foreground: #2b3340; CornerRadius: 9; FontSize: 13; Surface: Solid; }
.world-server-identity { Orientation: Vertical; Spacing: 2; Weight: 1; }
.world-server-name { Height: 26; FontSize: 15; Foreground: #2b3340; }
.world-online-name { Height: 30; FontSize: 19; Foreground: #2b3340; }
.world-online-icon { Width: 48; Height: 48; }
.world-version-icon { Width: 18; Height: 24; Foreground: #5e6e82; }
.world-version-name { MinHeight: 24; FontSize: 13; Foreground: #2b3340; WrapText: true; }
.world-category { Weight: 1; Height: 32; FontSize: 13; Foreground: #2b3340; Border: #0b5bcb; }
.world-online-list-status { Width: 268; Height: 24; FontSize: 11; Foreground: #5e6e82; TextAlignment: End; }

.world-responsive-metric { MinWidth: 960; }
