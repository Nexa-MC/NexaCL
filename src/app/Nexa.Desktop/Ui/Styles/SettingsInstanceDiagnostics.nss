/* Captured instance facts: surfaces own padded bodies; all values remain literal. */
.instance-diagnostics-stack { Orientation: Vertical; Spacing: 12; }
.instance-diagnostics-body { Orientation: Vertical; Padding: 20,14,20,14; Spacing: 6; }
.instance-diagnostics-toolbar { Orientation: Horizontal; Spacing: 10; VerticalAlignment: Center; }
.instance-diagnostics-spacer { Weight: 1; }
.instance-diagnostics-title { Height: 30; FontSize: 14; FontWeight: 600; Foreground: #2b3340; }
.instance-diagnostics-hint { MinHeight: 28; FontSize: 11; Foreground: #5e6e82; WrapText: true; }
.instance-diagnostics-mode { Width: 124; }
.instance-diagnostics-field { Orientation: Horizontal; Spacing: 12; }
.instance-diagnostics-label { Width: 164; Height: 28; FontSize: 12; Foreground: #5e6e82; }
.instance-diagnostics-value { Weight: 1; Height: 28; FontSize: 12; Foreground: #2b3340; TextAlignment: End; }
.instance-diagnostics-caption { Height: 28; FontSize: 13; FontWeight: 500; Foreground: #2b3340; }
.instance-diagnostics-rows { Orientation: Vertical; Spacing: 4; }
.instance-diagnostics-history-row { Orientation: Vertical; Spacing: 3; Padding: 0,8,0,8; }
.instance-diagnostics-event { MinHeight: 24; FontSize: 12; Foreground: #5e6e82; WrapText: true; }
.instance-diagnostics-page { Width: 96; }
.instance-diagnostics-counter { Weight: 1; Height: 30; FontSize: 12; Foreground: #5e6e82; TextAlignment: End; }
.instance-launch-tabs { Orientation: Horizontal; Spacing: 5; Height: 46; }
.instance-launch-tab { Height: 34; MinWidth: 94; Padding: 10,0,10,0; }
.instance-launch-tab-selected { Foreground: #0b5bcb; Background: #ffffff; FontWeight: 600; }
.instance-launch-line { Height: 26; FontSize: 12; Foreground: #2b3340; }
