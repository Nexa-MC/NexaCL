<nxml-component>
  <Node Kind="ContentHost" Recipe="Element" Key="DialogLayer" Clickable="true" OverlayMotion="DialogScrim" DismissCommand="ui.feedback.dialog.cancel" Class="feedback-dialog-scrim">
    <Dialog Key="DialogCard" Label="{data narration}" Localize="false" OverlayMotion="Dialog" LiveSetting="Assertive" Class="layout-Dialog-DialogCard feedback-dialog-card">
      <StackPanel Key="DialogHeader" Class="layout-Dialog-DialogHeader">
        <Node Kind="Image" Recipe="Image" Key="DialogIcon" Source="lucide/info" Class="layout-Dialog-DialogIcon feedback-dialog-icon" />
        <Node Kind="Text" Recipe="Text" Key="DialogTitle" Content="{data title}" Localize="false" Class="layout-Dialog-DialogTitle feedback-dialog-title" />
      </StackPanel>
      <StackPanel Key="DialogMessageViewport" Scroll="true" ScrollGesture="true" ShowsVerticalIndicator="true" Class="layout-Dialog-DialogMessageViewport">
        <ProgressRing IsVisible="{data loading}" Margin="0,12,0,16" />
        <Node Kind="Text" Recipe="Text" Key="DialogMessage" Content="{data message}" Localize="false" Class="layout-Dialog-DialogMessage feedback-dialog-message" />
      </StackPanel>
      <StackPanel Key="DialogActions" HorizontalAlignment="{data action-alignment}" Class="layout-Dialog-DialogActions">
        <Button Key="DialogCancel" Label="{data cancel}" Content="{data cancel}" Localize="false" IsVisible="{data has-cancel}" Enabled="{data enabled}" Command="ui.feedback.dialog.cancel" Class="layout-Dialog-DialogCancel feedback-dialog-secondary" />
        <StackPanel Key="DialogActionSpacer" IsVisible="{data has-alternate}" Class="layout-Dialog-DialogActionSpacer" />
        <Button Key="DialogAlternate" Label="{data alternate}" Content="{data alternate}" Localize="false" IsVisible="{data has-alternate}" Enabled="{data enabled}" Command="ui.feedback.dialog.alternate" Class="layout-Dialog-DialogAlternate feedback-dialog-secondary" />
        <Button Key="DialogAccept" Label="{data accept}" Content="{data accept}" Localize="false" Enabled="{data enabled}" Command="ui.feedback.dialog.accept" Class="layout-Dialog-DialogAccept feedback-dialog-primary" />
      </StackPanel>
    </Dialog>
  </Node>
</nxml-component>
