/* NSS/1 has no arithmetic expressions. Map the declared integer percentage
   directly, without an appearance slot or a host-generated background rule. */
Shell { BackgroundImage: asset("assets/liuli.svg"); BackgroundImageFit: cover; BackgroundImageOpacity: 0.38; }
@when option(wallpaper-opacity) = 0 { Shell { BackgroundImageOpacity: 0.00; } }
@when option(wallpaper-opacity) = 1 { Shell { BackgroundImageOpacity: 0.01; } }
@when option(wallpaper-opacity) = 2 { Shell { BackgroundImageOpacity: 0.02; } }
@when option(wallpaper-opacity) = 3 { Shell { BackgroundImageOpacity: 0.03; } }
