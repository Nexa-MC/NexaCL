@when option(wallpaper-opacity) = 69 { Shell { BackgroundImageOpacity: 0.69; } }
@when option(wallpaper-opacity) = 70 { Shell { BackgroundImageOpacity: 0.70; } }

/* Dark wallpaper is intentionally quieter: even the maximum setting leaves
   enough contrast for status text rendered directly over it. */
@when mode = dark {
  @when option(wallpaper-opacity) = 0 { Shell { BackgroundImageOpacity: 0.0000; } }
  @when option(wallpaper-opacity) = 1 { Shell { BackgroundImageOpacity: 0.0025; } }
  @when option(wallpaper-opacity) = 2 { Shell { BackgroundImageOpacity: 0.0050; } }
