<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Owned Updates service boundary.</Description>
    <IsAotCompatible>true</IsAotCompatible>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>Nexa.Services</RootNamespace>
  </PropertyGroup>
  <PropertyGroup Condition="'$(NexaExternalModules)' == 'true'">
    <DefineConstants>$(DefineConstants);NEXA_EXTERNAL_MODULES</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../native/NativeEngineClient.cs" Link="NativeEngineClient.cs" />
    <ProjectReference Include="../native/Nexa.Native.Crypto/Nexa.Native.Crypto.csproj" Condition="'$(NexaExternalModules)' != 'true'" />
    <ProjectReference Include="../Nexa.Services.Common/Nexa.Services.Common.csproj" />
    <ProjectReference Include="../Nexa.Contracts/Nexa.Contracts.csproj" />
    <ProjectReference Include="../Nexa.Core/Nexa.Core.csproj" />
    <ProjectReference Include="../Nexa.Domain/Nexa.Domain.csproj" />
    <ProjectReference Include="../Nexa.Xsr.Abstractions/Nexa.Xsr.Abstractions.csproj" />
    <ProjectReference Include="../Nexa.Xsr.State/Nexa.Xsr.State.csproj" />
    <ProjectReference Include="../Nexa.Services.Rollouts/Nexa.Services.Rollouts.csproj" />
    <ProjectReference Include="../Nexa.Services.Updates.Contracts/Nexa.Services.Updates.Contracts.csproj" />
    <InternalsVisibleTo Include="Nexa.Desktop.Tests" />
    <InternalsVisibleTo Include="Nexa.Services" />
    <InternalsVisibleTo Include="Nexa.Services.Composition" />
    <InternalsVisibleTo Include="Nexa.Services.Tests" />
    <PackageReference Include="ZstdSharp.Port" Version="0.8.6" />
    <ProjectReference Include="../Nexa.Platform.Runtime/Nexa.Platform.Runtime.csproj" />
  </ItemGroup>
</Project>
