/* TaskCard layout. */
.layout-TaskCard-TaskCard { Orientation: Vertical; }
.layout-TaskCard-TaskCardContent { Orientation: Horizontal; Spacing: 16; Padding: 24,20,24,20; }
.layout-TaskCard-TaskCardIndicator { Width: 32; VerticalAlignment: Start; Margin: 0,2,0,0; }
.layout-TaskCard-TaskCardBody { Orientation: Vertical; Weight: 1; Spacing: 8; }
.layout-TaskCard-TaskCardHeader { Orientation: Horizontal; }
.layout-TaskCard-TaskCardIcon { Width: 32; Height: 32; }
.layout-TaskCard-TaskCardTitle { MinHeight: 26; Weight: 1; WrapText: true; }
.layout-TaskCard-TaskCardAction { Width: 36; Height: 36; }
.layout-TaskCard-TaskCardStatus { Orientation: Horizontal; }
.layout-TaskCard-TaskCardStage { MinHeight: 20; Weight: 1; WrapText: true; }
.layout-TaskCard-TaskCardPercent { Width: 64; Height: 20; Margin: 12,0,0,0; }
.layout-TaskCard-TaskCardTrack { Width: 32; Height: 32; }
.layout-TaskCard-TaskCardMeta { Orientation: Horizontal; }
.layout-TaskCard-TaskCardFiles { MinHeight: 20; Weight: 1; WrapText: true; }
.layout-TaskCard-TaskCardSpeed { Height: 20; Margin: 12,0,0,0; }
.layout-TaskCard-TaskCardError { MinHeight: 20; }
.layout-TaskCard-TaskCardRetry { MinWidth: 92; MinHeight: 40; Padding: 12,6,12,6; HorizontalAlignment: Start; }
.layout-TaskCard-TaskCardDetails { Width: 92; Height: 28; HorizontalAlignment: Start; }
.layout-TaskCard-TaskCardSteps { Orientation: Vertical; Spacing: 2; }

.layout-TaskCard-TaskCard { Background: #ffffff; Foreground: #28303c; Border: #e4e9f0; BorderWidth: 1; CornerRadius: 16; Surface: Solid; }
.layout-TaskCard-TaskCardIcon { Foreground: #1370f3; }
.layout-TaskCard-TaskCardTitle { Foreground: #28303c; FontSize: 17; FontWeight: 600; }
.layout-TaskCard-TaskCardStage { Foreground: #5e6e82; FontSize: 13; }
.layout-TaskCard-TaskCardPercent { Foreground: #28303c; FontSize: 13; FontWeight: 600; }
.layout-TaskCard-TaskCardFill { Background: #1370f3; Foreground: #00000000; CornerRadius: 2; Surface: Solid; }
.layout-TaskCard-TaskCardFiles { Foreground: #5e6e82; FontSize: 12; }
.layout-TaskCard-TaskCardSpeed { Foreground: #5e6e82; FontSize: 12; }
.layout-TaskCard-TaskCardError { Foreground: #c44036; FontSize: 12; WrapText: true; }
.layout-TaskCard-TaskCardRetry { Background: #eff4fb; Foreground: #305791; Surface: Solid; CornerRadius: 8; Hover: #1370f316; FontSize: 13; FontWeight: 550; TextAlignment: Center; }
.layout-TaskCard-TaskCardDetails { Foreground: #5e6e82; CornerRadius: 6; Hover: #1370f316; FontSize: 12; }
.layout-TaskCard-TaskCardTrack { Background: #00000000; }
.layout-TaskCard-TaskCardAction { Foreground: #5e6e82; CornerRadius: 15; Hover: #1370f316; }
.task-step { Height: 22; FontSize: 12; }
.task-running { Foreground: #1370f3; }
.task-finished { Foreground: #228054; }
.task-failed { Foreground: #c44036; }
.task-canceled { Foreground: #5e6e82; }
.task-fill-running { Background: #1370f3; }
.task-fill-finished { Background: #228054; }
.task-fill-failed { Background: #c44036; }
.task-fill-canceled { Background: #5e6e82; }
