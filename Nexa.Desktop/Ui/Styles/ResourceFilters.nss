/* Compact resource filters and anchored option lists. */
.resource-filter-row { Orientation: Horizontal; Height: 34; Spacing: 6; }
.resource-filter-choice { Width: 124; Height: 34; TextAlignment: Start; Background: #f1f5fa; Foreground: #2b3340; CornerRadius: 10; FontSize: 13; Padding: 8,0,8,0; }
.resource-filter-card { Orientation: Vertical; VerticalAlignment: Start; Background: #ffffff; Border: #e3ebf7; BorderWidth: 1; CornerRadius: 12; }
.resource-filter-padding { Orientation: Vertical; Weight: 1; Padding: 8; Spacing: 6; }
.resource-filter-search { Height: 34; }
.resource-filter-options { Orientation: Vertical; Spacing: 2; Weight: 1; }
.resource-filter-option { Height: 32; TextAlignment: Start; Background: #ffffff; Foreground: #2b3340; Hover: #f1f5fa; CornerRadius: 7; FontSize: 13; Padding: 8,0,8,0; }
.resource-filter-dismiss { Background: #00000000; Hover: #00000000; }
