/* Complete custom settings workspaces. */
.settings-custom-column { Orientation: Vertical; Spacing: 4; }
.settings-custom-field { Orientation: Vertical; Spacing: 0; }
.settings-custom-label { Height: 24; FontSize: 12; Foreground: #717c8c; }
.settings-custom-caption { Height: 26; FontSize: 12; Foreground: #717c8c; }
.settings-custom-note { Height: 34; FontSize: 11; Foreground: #717c8c; WrapText: true; }
.settings-custom-status { Height: 26; FontSize: 12; Foreground: #0b5bcb; }
.settings-custom-input { Height: 30; Padding: 8,0,8,0; Background: #f4f7fb; Foreground: #2b3340; CornerRadius: 6; FontSize: 12; Surface: Solid; Hover: #cfe1fe; }
.settings-custom-actions { Orientation: Horizontal; Spacing: 6; }
.settings-custom-action { Width: 180; }
.settings-custom-fact { Orientation: Horizontal; Spacing: 12; MinHeight: 28; }
.settings-custom-fact-label { Width: 210; Height: 28; FontSize: 12; Foreground: #717c8c; }
.settings-custom-fact-value { Weight: 1; Height: 28; FontSize: 12; Foreground: #2b3340; TextAlignment: End; }
.settings-custom-icon { Width: 64; Height: 64; }
.settings-custom-update { Orientation: Vertical; Spacing: 0; Padding: 0; Background: #ffffff; Foreground: #2b3340; CornerRadius: 18; Surface: Solid; }
.settings-custom-update-header { Orientation: Horizontal; Spacing: 12; }
.settings-custom-update-title { Weight: 1; Height: 28; FontSize: 19; FontWeight: 600; Foreground: #2b3340; }
.settings-custom-update-check { Width: 34; Height: 34; Padding: 7; Background: #f2f5f9; Foreground: #0b5bcb; CornerRadius: 9; Hover: #cfe1fe; Surface: Solid; }
.settings-custom-update-note { Height: 22; FontSize: 13; Foreground: #717c8c; }
.settings-custom-update-actions { Orientation: Horizontal; Spacing: 10; }
.settings-custom-update-action { Width: 112; }
.settings-custom-update-action-wide { Width: 144; }

.settings-custom-update-body { Orientation: Vertical; Spacing: 10; Padding: 20,18,20,18; }
