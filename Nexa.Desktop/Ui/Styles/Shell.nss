/* Shell layout. */
.layout-Shell-2 { Height: 52; }
.layout-Shell-TitleNavigation { Orientation: Horizontal; Weight: 1; }
.layout-Shell-TitleBrand { Margin: 20,0,0,0; Width: 320; VerticalAlignment: Center; }
.layout-Shell-TitleMain { Height: 25; TransitionOffsetX: 0; }
.layout-Shell-TitleBack { Width: 30; Height: 30; Margin: 12,0,0,0; VerticalAlignment: Center; TransitionOffsetX: 0; }
.layout-Shell-TitleSubpage { Height: 30; Margin: 6,0,0,0; Weight: 1; VerticalAlignment: Center; TransitionOffsetX: 0; }
.layout-Shell-8 { Orientation: Horizontal; }
.layout-Shell-9 { Width: 48; }
.layout-Shell-14 { Padding: 20,16,20,16; }
