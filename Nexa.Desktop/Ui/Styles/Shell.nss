/* Shell layout. */
.layout-Shell-2 { Height: 52; }
.layout-Shell-TitleNavigation { Orientation: Horizontal; Weight: 1; }
.layout-Shell-TitleBrand { Margin: 20,0,0,0; Width: 320; VerticalAlignment: Center; }
.layout-Shell-TitleMain { Height: 25; TransitionOffsetX: 12; }
.layout-Shell-TitleBack { Width: 30; Height: 30; Margin: 12,0,0,0; VerticalAlignment: Center; TransitionOffsetX: 12; }
.layout-Shell-TitleSubpage { Height: 30; Margin: 6,0,0,0; Weight: 1; VerticalAlignment: Center; TransitionOffsetX: 12; }
.layout-Shell-8 { Orientation: Horizontal; }
.layout-Shell-9 { Width: 48; }
.layout-Shell-14 { Padding: 20,16,20,16; TransitionOffsetX: 16; }

/* Product navigation captions share the title hierarchy. */
.layout-Shell-TitleMain, .layout-Shell-TitleBack, .layout-Shell-TitleSubpage { Foreground: #ffffff; FontSize: 17; FontWeight: 600; }
.layout-Shell-TitleBack { Hover: #ffffff32; CornerRadius: 15; }
