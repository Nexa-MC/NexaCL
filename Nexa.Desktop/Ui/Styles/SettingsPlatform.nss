/* Platform observations and readonly, snapshot-scoped preflight. */
.platform-toolbar { Orientation: Horizontal; Spacing: 12; }
.platform-status-slot { Weight: 1; }
.platform-status { Height: 32; FontSize: 12; Foreground: #717c8c; }
.platform-refresh { Width: 36; Height: 36; Background: #f2f5f9; Foreground: #0b5bcb; CornerRadius: 10; Surface: Solid; }
.platform-group { Orientation: Vertical; Spacing: 18; }
.platform-group-title { Height: 24; FontSize: 12; FontWeight: 600; Foreground: #717c8c; }
.platform-card { Orientation: Vertical; Spacing: 0; Background: #ffffff; Foreground: #2b3340; CornerRadius: 12; Surface: Solid; }
.platform-card-body { Orientation: Vertical; Padding: 16,6,16,6; Spacing: 0; }
.platform-capability { Orientation: Vertical; Padding: 0,7,0,7; Spacing: 1; }
.platform-headline { Orientation: Horizontal; Spacing: 12; }
.platform-capability-label { Height: 28; Weight: 1; FontSize: 14; Foreground: #2b3340; }
.platform-badge { Height: 28; MinWidth: 96; MaxWidth: 330; HorizontalAlignment: End; FontSize: 12; Foreground: #717c8c; Background: #f5f7fa; CornerRadius: 6; TextAlignment: Center; Surface: Solid; }
.platform-badge-available { Foreground: #2b3340; }
.platform-evidence { Height: 22; FontSize: 11; Foreground: #717c8c; }
.platform-list-row { Orientation: Horizontal; Padding: 0,7,0,7; Spacing: 12; }
.platform-right-list { Orientation: Vertical; Spacing: 2; HorizontalAlignment: End; }
.platform-list-entry { Height: 22; FontSize: 12; Foreground: #717c8c; TextAlignment: End; }
.platform-overall { Height: 26; FontSize: 13; FontWeight: 600; Foreground: #2b3340; }
.platform-issue { Orientation: Horizontal; Padding: 0,6,0,6; Spacing: 12; }
.platform-issue-title { Height: 28; Weight: 1; FontSize: 13; Foreground: #2b3340; }
.platform-remediation { Width: 110; }
.hardware-advice-body { Orientation: Vertical; Padding: 16,8,16,8; Spacing: 4; }
.hardware-advice-title { Height: 26; FontSize: 13; FontWeight: 600; Foreground: #2b3340; }
.hardware-advice-facts { Height: 42; FontSize: 12; Foreground: #2b3340; }
.hardware-advice-hint { Height: 42; FontSize: 11; Foreground: #717c8c; }
