.settings-disk-log-card { Orientation: Vertical; Spacing: 0; Background: #ffffff; Foreground: #2b3340; CornerRadius: 12; Surface: Solid; }
.settings-disk-log-body { Orientation: Vertical; Spacing: 10; Padding: 20,18,20,18; }
.settings-disk-log-description { Height: 48; FontSize: 13; Foreground: #717c8c; WrapText: true; }
.settings-disk-log-buttons { Orientation: Horizontal; Spacing: 12; }
.settings-disk-log-wide { Width: 136; }
.settings-disk-log-export { Width: 112; }
