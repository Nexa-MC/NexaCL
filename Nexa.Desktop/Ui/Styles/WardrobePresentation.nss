/* Complete wardrobe and public-library presentation. */
.wardrobe-base { Foreground: #2B3340; Background: #00000000; CornerRadius: 0; FontSize: 14; WrapText: true; TextAlignment: Start; }
.wardrobe-button { Background: #F1F5FA; CornerRadius: 10; WrapText: false; TextAlignment: Center; }
.layout-WardrobePage-WardrobeLocalLayer { Background: #00000064; }
.layout-WardrobePage-WardrobeLocalPanel { Background: #FFFFFF; CornerRadius: 18; Padding: 0; Spacing: 0; }
.layout-WardrobePage-WardrobeCurrentTitle { FontSize: 19; FontWeight: 600; }
.layout-WardrobePage-WardrobePageTitle { FontSize: 19; FontWeight: 600; }
.layout-WardrobePage-WardrobeSkinTitle { FontSize: 19; FontWeight: 600; }
.layout-WardrobePage-WardrobeCapeTitle { FontSize: 19; FontWeight: 600; }
.layout-WardrobePage-WardrobeLocalTitle { FontSize: 19; FontWeight: 600; }
.layout-WardrobePage-WardrobeCurrentSubtitle { FontSize: 12; Foreground: #606C7C; }
.layout-WardrobePage-WardrobeProfileKind { FontSize: 12; Foreground: #606C7C; TextAlignment: Center; }
.layout-WardrobePage-WardrobeSkinSubtitle { FontSize: 12; Foreground: #606C7C; }
.layout-WardrobePage-WardrobeCapeSubtitle { FontSize: 12; Foreground: #606C7C; }
.layout-WardrobePage-WardrobeSkinCount { FontSize: 12; Foreground: #606C7C; }
.layout-WardrobePage-WardrobeCapeCount { FontSize: 12; Foreground: #606C7C; }
.layout-WardrobePage-WardrobeStatus { FontSize: 12; Foreground: #606C7C; }
.layout-WardrobePage-WardrobeLocalStatus { FontSize: 12; Foreground: #606C7C; }
.layout-WardrobePage-WardrobeRailSurface { Background: #F4F7FB; }
.layout-WardrobePage-WardrobeCurrentCard { Background: #FFFFFF; CornerRadius: 22; }
.layout-WardrobePage-WardrobeIdentity { TextAlignment: Center; FontSize: 17; FontWeight: 600; }
.layout-WardrobePage-WardrobeBrowse { Background: #1370F3; Foreground: #FFFFFF; FontWeight: 600; CornerRadius: 12; }
.layout-WardrobePage-WardrobeLibrary { Background: #F1F5FA; Border: #909FB5; BorderWidth: 1; CornerRadius: 12; FontWeight: 600; }
.layout-WardrobePage-WardrobeCurrentView { Background: #00000000; }
.wardrobe-choice-active { Background: #E0EAFD; }
.wardrobe-card { Orientation: Vertical; Spacing: 0; Padding: 0; Background: #FFFFFF; CornerRadius: 18; Hover: #F1F5FA; }
.wardrobe-card-body { Weight: 1; Spacing: 12; Margin: 12,10,12,10; }
.wardrobe-card-details { Orientation: Vertical; Spacing: 6; VerticalAlignment: Center; }
.wardrobe-card-title { FontSize: 15; FontWeight: 600; WrapText: false; }
.wardrobe-card-source { FontSize: 12; WrapText: false; }
.wardrobe-card-text-start { TextAlignment: Start; }
.wardrobe-card-text-center { TextAlignment: Center; }
.wardrobe-card-view-layer { Width: 22; Height: 22; Margin: 0,4,4,0; HorizontalAlignment: End; VerticalAlignment: Start; }
.wardrobe-card-view { Width: 22; Height: 22; Background: #00000000; BorderWidth: 0; FontWeight: 600; }
.wardrobe-card-apply { Height: 32; Background: #F1F5FA; CornerRadius: 10; TextAlignment: Center; FontWeight: 600; Border: #909FB5; BorderWidth: 1; WrapText: false; }
.wardrobe-library-base { Foreground: #2B3340; Background: #00000000; CornerRadius: 0; FontSize: 13; WrapText: true; TextAlignment: Start; Hover: #E0EAFD; }
.wardrobe-library-button { Background: #F1F5FA; CornerRadius: 10; WrapText: false; TextAlignment: Center; }
.layout-WardrobeLibraryPage-WardrobeLibrarySiteName { FontSize: 20; FontWeight: 600; }
.wardrobe-library-selected { Background: #E0EAFD; Foreground: #0B5BCB; }
.wardrobe-library-site { Height: 60; WrapText: true; }
.wardrobe-library-site-idle { Background: #00000000; }
.wardrobe-library-row { Orientation: Horizontal; Height: 383; Spacing: 12; }
.wardrobe-library-card { Orientation: Vertical; Spacing: 3; Width: 208; Height: 383; Padding: 0; Background: #F7F9FC; CornerRadius: 18; }
.wardrobe-library-preview { Width: 84; Height: 168; HorizontalAlignment: Center; }
.wardrobe-library-name { Height: 28; WrapText: true; TextAlignment: Center; }
.wardrobe-library-metadata { Height: 26; WrapText: true; TextAlignment: Center; }
.wardrobe-library-card-button { Height: 31; }
/* Viewport metrics are compiled from WardrobeMetrics.nxml. */
.wardrobe-metric-view { MinWidth: 940; MaxWidth: 1380; Height: 650; }
.wardrobe-metric-rail { Width: 300; MinWidth: 268; MaxWidth: 326; Padding: 22,18,22,22; Spacing: 8; }
.wardrobe-metric-rail-compact { Padding: 18,14,18,16; }
.wardrobe-metric-content { MinWidth: 980; MaxWidth: 1500; Padding: 26,20,26,24; Spacing: 8; }
.wardrobe-metric-content-compact { Padding: 18,10,18,10; Spacing: 4; }
.wardrobe-metric-content-large { Padding: 38,20,38,24; }
.wardrobe-metric-content-narrow { Padding: 18,20,18,24; }
.wardrobe-metric-header { Height: 34; MinHeight: 30; }
.wardrobe-metric-status { Height: 40; MinHeight: 30; }
.wardrobe-metric-skin-subtitle { Height: 28; MinHeight: 22; }
.wardrobe-metric-cape-subtitle { Height: 30; MinHeight: 26; }
.wardrobe-metric-track { MinHeight: 112; MaxHeight: 270; MinWidth: 120; Margin: 32,10,0,0; }
.wardrobe-metric-estimate { Height: 330; MinHeight: 270; }
.wardrobe-metric-card-axis { Height: 240; }
.wardrobe-metric-image-aspect { Width: 65; Height: 100; }
.wardrobe-metric-horizontal-image { MinHeight: 72; MaxHeight: 150; Margin: 0,18,0,0; }
.wardrobe-metric-horizontal-card { MinWidth: 220; MaxWidth: 244; Padding: 140,0,0,0; }
.wardrobe-metric-vertical-card { MinWidth: 150; MaxWidth: 190; Padding: 88,90,0,0; }
.wardrobe-metric-vertical-image { MinHeight: 72; Margin: 0,90,0,56; }
.wardrobe-metric-current-card { MinHeight: 180; }
.wardrobe-metric-local { Width: 600; MinWidth: 260; Height: 500; MinHeight: 140; Margin: 24,50,24,50; }
.wardrobe-metric-card-labels { Height: 25; MinHeight: 20; Width: 22; MinWidth: 18; }
.wardrobe-metric-library-view { MinWidth: 960; MaxWidth: 1500; Height: 700; Margin: 48,0,0,0; }
.wardrobe-metric-library-rail { Width: 268; MinWidth: 238; MaxWidth: 294; Padding: 12,14,12,20; }
.wardrobe-metric-library-content { Padding: 28,18,28,20; Spacing: 12; MaxWidth: 1320; MinWidth: 208; }
.wardrobe-metric-library-compact { Padding: 18,10,18,12; Spacing: 6; }
.wardrobe-metric-library-grid { Width: 220; MinWidth: 1; MaxWidth: 5; Height: 383; Spacing: 12; }
.wardrobe-local-body { Orientation: Vertical; Margin: 20; Spacing: 10; }
.wardrobe-library-card-body { Orientation: Vertical; Weight: 1; Margin: 14,11,14,13; Spacing: 3; }
