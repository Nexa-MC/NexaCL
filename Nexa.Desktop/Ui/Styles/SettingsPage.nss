/* SettingsPage layout. */
.layout-SettingsPage-SettingsLayout { Orientation: Vertical; Weight: 1; Spacing: 8; Padding: 0; }
.layout-SettingsPage-SettingsToolbar { Orientation: Horizontal; Height: 44; Spacing: 12; }
.layout-SettingsPage-SettingsNavigation { Orientation: Horizontal; Height: 36; Weight: 1; Spacing: 2; Padding: 0; Margin: 4; }
.layout-SettingsPage-SettingsSaveStatus { Height: 18; VerticalAlignment: Center; }
.layout-SettingsPage-SettingsPager { Weight: 1; MinHeight: 180; }

.settings-section { Orientation: Vertical; Spacing: 18; VerticalAlignment: Stretch; Padding: 0,8,0,8; }

.settings-navigation-surface { Weight: 1; Height: 44; Background: #f1f5fa; Foreground: #2b3340; CornerRadius: 10; Surface: Solid; }

.layout-SettingsPage-SettingsNavigation { HorizontalAlignment: Stretch; Background: #00000000; Foreground: #2b3340; CornerRadius: 10; Surface: Solid; }
.settings-navigation-thumb { Background: #ffffff; Foreground: #2b3340; CornerRadius: 8; Surface: Solid; }
.settings-navigation-option { Height: 36; Foreground: #2b3340; FontSize: 13; FontWeight: 450; CornerRadius: 8; TextAlignment: Center; VerticalAlignment: Center; Hover: #cfe1fe; Surface: Solid; }
.settings-navigation-option-selected { Foreground: #0b5bcb; FontWeight: 600; }
.settings-save-status { Height: 18; VerticalAlignment: Center; Foreground: #717c8c; FontSize: 12; TextAlignment: End; }
.settings-instance-missing { Height: 28; Foreground: #717c8c; FontSize: 13; }
.settings-category-empty { Orientation: Vertical; Spacing: 18; }
.settings-category-title { Height: 30; Foreground: #2b3340; FontSize: 20; FontWeight: 600; }
.settings-category-description { Height: 24; Foreground: #717c8c; FontSize: 13; }
.settings-privacy-notice { Height: 72; Foreground: #717c8c; FontSize: 12; WrapText: true; }
