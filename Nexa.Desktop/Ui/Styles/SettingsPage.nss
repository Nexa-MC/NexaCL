/* SettingsPage layout. */
.layout-SettingsPage-SettingsLayout { Orientation: Vertical; Weight: 1; Spacing: 8; Padding: 0; }
.layout-SettingsPage-SettingsToolbar { Orientation: Horizontal; Height: 44; Spacing: 12; }
.layout-SettingsPage-SettingsNavigation { Orientation: Horizontal; Height: 36; Weight: 1; Spacing: 2; Padding: 0; Margin: 4; }
.layout-SettingsPage-SettingsSaveStatus { Height: 18; VerticalAlignment: Center; }
.layout-SettingsPage-SettingsPager { Weight: 1; MinHeight: 180; }

.settings-section { Orientation: Vertical; Spacing: 16; VerticalAlignment: Stretch; Padding: 0,8,0,8; }

.settings-navigation-surface { Weight: 1; Height: 44; Background: #f1f5fa; Foreground: #2b3340; CornerRadius: 10; Surface: Solid; }
