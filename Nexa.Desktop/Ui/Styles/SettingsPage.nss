/* SettingsPage layout. */
.layout-SettingsPage-SettingsLayout { Orientation: Vertical; Weight: 1; Spacing: 8; Padding: 0; }
.layout-SettingsPage-SettingsToolbar { Orientation: Horizontal; Height: 44; Spacing: 12; }
.layout-SettingsPage-SettingsNavigation { Orientation: Horizontal; Height: 44; Weight: 1; MaxWidth: 960; Spacing: 2; Padding: 4,0,4,0; }
.layout-SettingsPage-SettingsSaveStatus { Width: 96; Height: 18; VerticalAlignment: Center; }
.layout-SettingsPage-SettingsPager { Weight: 1; MinHeight: 180; }
