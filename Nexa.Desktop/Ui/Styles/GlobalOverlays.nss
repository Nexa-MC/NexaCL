/* Global overlays retain the existing physical layout and palettes. */
.feedback-notification-host { Width: 360; MaxHeight: 440; Margin: 18; HorizontalAlignment: Start; VerticalAlignment: End; Spacing: 10; }
.feedback-notification-message { Surface: None; Foreground: #343D4A; FontSize: 13; WrapText: true; }
.feedback-dialog-scrim { Surface: Solid; Background: #141C285C; Foreground: #343D4A; }
.feedback-dialog-card { Surface: Solid; Background: #FFFFFFFC; Foreground: #343D4A; Border: #DAE1EB; BorderWidth: 1; CornerRadius: 20; }
.feedback-dialog-icon { Surface: None; Foreground: #1370F3; }
.feedback-dialog-title { Surface: None; Foreground: #262F3C; FontSize: 20; FontWeight: 600; }
.feedback-dialog-message { Surface: None; Foreground: #5B697A; FontSize: 14; WrapText: true; }
.feedback-dialog-secondary { Surface: Solid; Background: #EEF2F7; Foreground: #343D4A; CornerRadius: 19; Hover: #E0E6EE; FontSize: 14; FontWeight: 600; TextAlignment: Center; }
.feedback-dialog-primary { Surface: Solid; Background: #0B5BCB; Foreground: #FFFFFF; CornerRadius: 19; Hover: #1370F3; FontSize: 14; FontWeight: 600; TextAlignment: Center; }
.command-palette-scrim { Surface: Solid; Background: #0000006E; Foreground: #343D4A; FontSize: 13; Hover: #D5E6FD; }
.command-palette-card { Width: 520; MaxWidth: 600; MaxHeight: 520; HorizontalAlignment: Center; VerticalAlignment: Start; Margin: 16,64,16,16; Padding: 16; Spacing: 8; Surface: Solid; Background: #FFFFFF; Foreground: #343D4A; CornerRadius: 12; FontSize: 13; Hover: #D5E6FD; }
.command-palette-title { Height: 28; Padding: 10,0,10,0; Surface: None; Foreground: #343D4A; FontSize: 13; }
.command-palette-search { Height: 36; Padding: 10,0,10,0; Surface: Solid; Background: #F4F7FB; Foreground: #343D4A; CornerRadius: 6; FontSize: 13; Hover: #D5E6FD; }
.command-palette-rows { Spacing: 8; }
.command-palette-row { Height: 32; Padding: 10,0,10,0; Surface: Solid; Background: #F4F7FB; Foreground: #343D4A; CornerRadius: 6; FontSize: 13; Hover: #D5E6FD; }
.command-palette-empty { Height: 30; Padding: 10,0,10,0; Surface: None; Foreground: #343D4A; FontSize: 13; }
.command-palette-close { Height: 32; Padding: 10,0,10,0; Surface: Solid; Background: #EEF2F7; Foreground: #0B5BCB; CornerRadius: 6; FontSize: 13; Hover: #D5E6FD; }
.feedback-notice-info { Surface: Solid; Background: #F4F8FFFC; Foreground: #343D4A; Border: #B8D6FF; BorderWidth: 1; CornerRadius: 16; Hover: #1370F318; }
.feedback-accent-info { Surface: Solid; Background: #1370F3; Foreground: #1370F3; CornerRadius: 2; }
.feedback-icon-info { Surface: None; Foreground: #1370F3; }
.feedback-level-info { Surface: None; Foreground: #1370F3; FontSize: 13; FontWeight: 600; }
.feedback-close-info { Surface: None; Foreground: #1370F3; CornerRadius: 15; Hover: #1370F318; }
.feedback-notice-warn { Surface: Solid; Background: #FFF9EBFC; Foreground: #343D4A; Border: #F5D389; BorderWidth: 1; CornerRadius: 16; Hover: #BE7C0018; }
.feedback-accent-warn { Surface: Solid; Background: #BE7C00; Foreground: #BE7C00; CornerRadius: 2; }
.feedback-icon-warn { Surface: None; Foreground: #BE7C00; }
.feedback-level-warn { Surface: None; Foreground: #BE7C00; FontSize: 13; FontWeight: 600; }
.feedback-close-warn { Surface: None; Foreground: #BE7C00; CornerRadius: 15; Hover: #BE7C0018; }
.feedback-notice-error { Surface: Solid; Background: #FFF4F5FC; Foreground: #343D4A; Border: #F4B8BC; BorderWidth: 1; CornerRadius: 16; Hover: #CF2F3618; }
.feedback-accent-error { Surface: Solid; Background: #CF2F36; Foreground: #CF2F36; CornerRadius: 2; }
.feedback-icon-error { Surface: None; Foreground: #CF2F36; }
.feedback-level-error { Surface: None; Foreground: #CF2F36; FontSize: 13; FontWeight: 600; }
.feedback-close-error { Surface: None; Foreground: #CF2F36; CornerRadius: 15; Hover: #CF2F3618; }
