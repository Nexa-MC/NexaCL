/* Top margin declares the inter-bubble gap; right/bottom margins are the base dock inset. */
.desktop-bubble { Height: 48; Margin: 0,10,18,18; HorizontalAlignment: End; VerticalAlignment: End; Surface: Solid; CornerRadius: 24; HoverExpand: true; FontSize: 13; }
.task-bubble { Width: 208; }
.process-bubble { Width: 280; }
.task-bubble-track { Width: 136; Height: 3; Margin: 16,35,0,0; HorizontalAlignment: Start; VerticalAlignment: Start; Background: #dce6f4; Foreground: #00000000; CornerRadius: 1.5; Surface: Solid; }
.task-bubble-fill { Background: #206ee0; Foreground: #00000000; CornerRadius: 1.5; Surface: Solid; }
