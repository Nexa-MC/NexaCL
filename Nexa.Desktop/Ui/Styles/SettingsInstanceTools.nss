/* Instance tools retain controls and only replace owned result rows. */
.instance-tools-stack { Orientation: Vertical; Spacing: 12; }
.instance-tools-body { Orientation: Vertical; Padding: 20,14,20,14; Spacing: 6; }
.instance-tools-title { Height: 30; FontSize: 14; FontWeight: 600; Foreground: #2b3340; }
.instance-tools-hint { MinHeight: 28; FontSize: 11; Foreground: #717c8c; WrapText: true; }
.instance-tools-toolbar { Orientation: Horizontal; Spacing: 10; VerticalAlignment: Center; }
.instance-tools-rows { Orientation: Vertical; Spacing: 6; }
.instance-tools-field { Orientation: Horizontal; Spacing: 12; }
.instance-tools-label { Width: 140; Height: 28; FontSize: 12; Foreground: #717c8c; }
.instance-tools-value { Weight: 1; MinHeight: 28; FontSize: 12; Foreground: #2b3340; TextAlignment: End; WrapText: true; }
.instance-tools-check { Width: 164; }
.instance-tools-area { Width: 106; }
.instance-tools-area-selected { Background: #0b5bcb; Foreground: #ffffff; FontWeight: 600; }
.instance-tools-folder { Width: 110; }
.instance-tools-back { Width: 134; }
.instance-tools-path { Weight: 1; Height: 36; FontSize: 12; Foreground: #717c8c; }
.instance-tools-file-row { Orientation: Horizontal; Spacing: 12; }
.instance-tools-file-name { Weight: 1; Height: 38; FontSize: 13; Foreground: #2b3340; }
.instance-tools-file-size { Width: 96; Height: 38; FontSize: 12; Foreground: #717c8c; TextAlignment: End; }
.instance-tools-caption-slot { Weight: 1; }
.instance-tools-caption { Height: 38; FontSize: 13; Foreground: #2b3340; }
.instance-tools-counter { Height: 36; FontSize: 12; Foreground: #717c8c; }
.instance-tools-line { MinHeight: 24; FontSize: 12; Foreground: #2b3340; WrapText: true; }
.instance-tools-input-label { Width: 100; Height: 36; FontSize: 13; Foreground: #717c8c; }
.instance-tools-editor { Weight: 1; Height: 36; Padding: 12,0,12,0; Background: #f1f5fa; Foreground: #2b3340; CornerRadius: 9; FontSize: 13; }
.instance-tools-line-number { Width: 100; Height: 36; Padding: 12,0,12,0; Background: #f1f5fa; Foreground: #2b3340; CornerRadius: 9; FontSize: 13; }
.instance-tools-timeline-row { Orientation: Vertical; Spacing: 3; }
.instance-tools-timeline-caption { Height: 28; FontSize: 12; Foreground: #2b3340; }
.instance-tools-timeline-delta { Height: 24; FontSize: 11; Foreground: #717c8c; }
