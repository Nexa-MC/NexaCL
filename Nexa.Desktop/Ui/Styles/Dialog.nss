/* Dialog layout. */
.layout-Dialog-DialogCard { Orientation: Vertical; Width: 520; MinHeight: 228; MaxHeight: 420; HorizontalAlignment: Center; VerticalAlignment: Center; }
.layout-Dialog-DialogHeader { Orientation: Horizontal; Height: 38; Margin: 24,22,24,0; }
.layout-Dialog-DialogIcon { Width: 24; Height: 24; VerticalAlignment: Center; }
.layout-Dialog-DialogTitle { Height: 30; Weight: 1; Margin: 12,0,0,0; VerticalAlignment: Center; }
.layout-Dialog-DialogMessageViewport { Orientation: Vertical; MinHeight: 76; MaxHeight: 242; Margin: 24,14,18,0; }
.layout-Dialog-DialogMessage { Width: 460; HorizontalAlignment: Start; }
.layout-Dialog-DialogActions { Orientation: Horizontal; Spacing: 10; HorizontalAlignment: End; Margin: 24,18,24,22; }
.layout-Dialog-DialogCancel { Width: 104; Height: 38; }
.layout-Dialog-DialogActionSpacer { Weight: 1; }
.layout-Dialog-DialogAlternate { Width: 112; Height: 38; }
.layout-Dialog-DialogAccept { Width: 112; Height: 38; }
