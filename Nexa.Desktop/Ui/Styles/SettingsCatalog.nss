/* Settings catalogue rows and editable values. */
.settings-catalog-row { Orientation: Horizontal; Spacing: 16; MinHeight: 40; Padding: 0,3,0,3; VerticalAlignment: Center; }
.settings-catalog-labels { Orientation: Vertical; Spacing: 3; Width: 176; VerticalAlignment: Center; }
.settings-catalog-labels-wide { Width: 240; }
.settings-catalog-labels-top { VerticalAlignment: Start; }
.settings-catalog-label { Height: 22; FontSize: 14; FontWeight: 500; Foreground: #2b3340; VerticalAlignment: Center; }
.settings-catalog-hint { Height: 32; FontSize: 11; Foreground: #717c8c; WrapText: true; VerticalAlignment: Center; }
.settings-catalog-controls { Orientation: Vertical; Spacing: 0; Weight: 1; VerticalAlignment: Center; }
.settings-catalog-action { Height: 34; Background: #f2f5f9; Foreground: #0b5bcb; CornerRadius: 9; FontSize: 12; FontWeight: 500; TextAlignment: Center; Surface: Solid; Hover: #cfe1fe; VerticalAlignment: Center; }
.settings-catalog-inherit { Width: 64; }
.settings-catalog-apply { Width: 44; }
.settings-catalog-unavailable { Width: 76; Height: 28; HorizontalAlignment: End; VerticalAlignment: Center; Background: #f5f6f8; Foreground: #717c8c; CornerRadius: 8; FontSize: 11; TextAlignment: Center; Surface: Solid; }
.settings-catalog-required { Height: 34; FontSize: 12; Foreground: #717c8c; }
.settings-catalog-divider { Height: 1; Background: #e8ecf2; Surface: Solid; }
.settings-catalog-input-row { Orientation: Horizontal; Spacing: 16; Weight: 1; VerticalAlignment: Center; }
.settings-catalog-input { Height: 34; Weight: 1; Padding: 10,0,10,0; Background: #f5f6f8; Foreground: #2b3340; CornerRadius: 9; FontSize: 13; Surface: Solid; Hover: #cfe1fe; VerticalAlignment: Center; }
.settings-catalog-mode { Orientation: Horizontal; Width: 112; Spacing: 0; Background: #f1f5fa; Foreground: #2b3340; CornerRadius: 9; Surface: Solid; VerticalAlignment: Center; }
.settings-catalog-mode-option { Width: 56; }
.settings-catalog-selector-surface { Height: 40; }
.settings-catalog-selector { Orientation: Horizontal; Spacing: 0; Padding: 3; HorizontalAlignment: End; VerticalAlignment: Center; Background: #f1f5fa; Foreground: #2b3340; CornerRadius: 9; Surface: Solid; }
.settings-catalog-thumb { Background: #ffffff; Foreground: #2b3340; CornerRadius: 7; Surface: Solid; }
.settings-catalog-option { Height: 34; FontSize: 12; FontWeight: 450; Foreground: #2b3340; CornerRadius: 7; TextAlignment: Center; Hover: #cfe1fe; Surface: Solid; VerticalAlignment: Center; }
.settings-catalog-option-selected { Foreground: #0b5bcb; FontWeight: 600; }
.settings-arguments { Orientation: Horizontal; Spacing: 8; Weight: 1; Padding: 0,6,0,6; VerticalAlignment: Center; }
.settings-hook { Orientation: Horizontal; Spacing: 8; Weight: 1; VerticalAlignment: Center; }
.settings-editor-rows { Orientation: Vertical; Spacing: 6; Weight: 1; VerticalAlignment: Center; }
.settings-editor-actions { Orientation: Vertical; Spacing: 6; VerticalAlignment: Start; }
.settings-editor-line { Orientation: Horizontal; Spacing: 6; VerticalAlignment: Center; }
.settings-editor-input { Height: 30; Weight: 1; Padding: 8,0,8,0; Background: #f4f7fb; Foreground: #2b3340; CornerRadius: 7; FontSize: 12; Surface: Solid; Hover: #cfe1fe; VerticalAlignment: Center; }
.settings-editor-remove { Width: 28; }
.settings-hook-apply { Width: 44; VerticalAlignment: Start; }
.settings-hook-add { Width: 72; }
.settings-hook-page { Width: 72; }
.settings-hook-counter { Height: 30; Foreground: #717c8c; FontSize: 12; VerticalAlignment: Center; }

.settings-inherit-slot { Width: 64; VerticalAlignment: Center; }
