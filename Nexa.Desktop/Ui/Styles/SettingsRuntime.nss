/* Captured metrics and bounded trace paging. */
.settings-runtime-label { Width: 220; Height: 26; FontSize: 12; Foreground: #717c8c; }
.settings-trace-toolbar { Orientation: Horizontal; Spacing: 8; }
.settings-trace-action { Width: 88; }
.settings-trace-hint { Height: 42; FontSize: 11; Foreground: #717c8c; WrapText: true; }
.settings-trace-rows { Orientation: Vertical; Spacing: 4; }
.settings-trace-identity { Height: 26; FontSize: 12; Foreground: #2b3340; }
.settings-trace-metadata { Height: 26; FontSize: 11; Foreground: #717c8c; }
