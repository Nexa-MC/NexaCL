/* Network preference presentation; controllers only own values and intent routing. */
.settings-form-group { Orientation: Vertical; Spacing: 8; VerticalAlignment: Center; }
.settings-form-label { Height: 24; FontSize: 14; FontWeight: 600; Foreground: #2b3340; VerticalAlignment: Center; Surface: Solid; }
.settings-form-surface { Orientation: Vertical; Spacing: 0; Background: #ffffff; Foreground: #2b3340; CornerRadius: 14; Surface: Solid; }
.settings-form-body { Orientation: Vertical; Spacing: 0; Padding: 16,8,16,8; }
.settings-network-note { Height: 24; FontSize: 11; Foreground: #5e6e82; VerticalAlignment: Center; Surface: Solid; }
.settings-proxy-toolbar { Orientation: Horizontal; Spacing: 8; VerticalAlignment: Center; }
.settings-proxy-track { HorizontalAlignment: Start; Orientation: Horizontal; Spacing: 0; Background: #f1f5fa; Foreground: #2b3340; CornerRadius: 9; Surface: Solid; }
.settings-proxy-thumb { Background: #ffffff; Foreground: #2b3340; CornerRadius: 7; Surface: Solid; }
.settings-proxy-option { Height: 34; Foreground: #2b3340; CornerRadius: 7; FontSize: 12; FontWeight: 450; TextAlignment: Center; VerticalAlignment: Center; Surface: Solid; }
.settings-proxy-option-selected { Foreground: #0b5bcb; CornerRadius: 7; FontSize: 12; FontWeight: 600; TextAlignment: Center; Surface: Solid; }
.settings-proxy-mode { Width: 84; }
.settings-proxy-protocol { Width: 66; }
.settings-proxy-action { Width: 84; Height: 34; Foreground: #0b5bcb; Background: #f2f5f9; CornerRadius: 10; FontSize: 12; TextAlignment: Center; VerticalAlignment: Center; Surface: Solid; }
.settings-proxy-manual { Orientation: Vertical; Spacing: 6; }
.settings-proxy-input-row { Orientation: Horizontal; Spacing: 12; }
.settings-proxy-input-label { Width: 84; Height: 34; FontSize: 13; Foreground: #2b3340; VerticalAlignment: Center; Surface: Solid; }
.settings-proxy-input { Height: 34; Weight: 1; Padding: 10,0,10,0; Background: #f5f6f8; Foreground: #2b3340; CornerRadius: 9; Surface: Solid; }

.settings-network-groups { Orientation: Vertical; Spacing: 18; }
.settings-network-description { Height: 32; FontSize: 11; Foreground: #5e6e82; VerticalAlignment: Center; Surface: Solid; }
.settings-network-observation { Height: 28; FontSize: 11; Foreground: #5e6e82; VerticalAlignment: Center; Surface: Solid; }
.settings-network-refresh { Width: 112; Height: 34; Foreground: #0b5bcb; Background: #f2f5f9; CornerRadius: 10; FontSize: 12; TextAlignment: Center; Surface: Solid; }
.settings-network-probe { Width: 132; Height: 34; Foreground: #0b5bcb; Background: #f2f5f9; CornerRadius: 10; FontSize: 12; TextAlignment: Center; Surface: Solid; }
