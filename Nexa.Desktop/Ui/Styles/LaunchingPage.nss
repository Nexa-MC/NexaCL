/* LaunchingPage layout. */
.layout-LaunchingPage-LaunchingCard { Orientation: Vertical; Width: 420; HorizontalAlignment: Center; VerticalAlignment: Center; Spacing: 0; }
.layout-LaunchingPage-LaunchingIcon { Width: 40; Height: 40; HorizontalAlignment: Center; Margin: 32,24,32,0; }
.layout-LaunchingPage-LaunchingTitle { Height: 30; HorizontalAlignment: Center; Margin: 32,12,32,0; }
.layout-LaunchingPage-LaunchingName { Height: 20; HorizontalAlignment: Center; Margin: 32,4,32,0; }
.layout-LaunchingPage-LaunchingBody { Orientation: Vertical; Margin: 32,14,32,0; }
.layout-LaunchingPage-LaunchProgressTrack { Height: 4; }
.layout-LaunchingPage-LaunchProgressFill { Height: 4; }
.layout-LaunchingPage-LaunchingStageRow { Orientation: Horizontal; Margin: 0,12,0,0; }
.layout-LaunchingPage-LaunchingStageLabel { Width: 64; Height: 16; }
.layout-LaunchingPage-LaunchingStageValue { Height: 16; Weight: 1; }
.layout-LaunchingPage-LaunchingMethodRow { Orientation: Horizontal; Margin: 0,6,0,0; }
.layout-LaunchingPage-LaunchingMethodLabel { Width: 64; Height: 16; }
.layout-LaunchingPage-LaunchingMethodValue { Height: 16; Weight: 1; }
.layout-LaunchingPage-LaunchingPercentRow { Orientation: Horizontal; Margin: 0,6,0,0; }
.layout-LaunchingPage-LaunchingPercentLabel { Width: 64; Height: 16; }
.layout-LaunchingPage-LaunchingPercentValue { Height: 16; Weight: 1; }
.layout-LaunchingPage-LaunchingSpeedRow { Orientation: Horizontal; Margin: 0,6,0,0; }
.layout-LaunchingPage-LaunchingSpeedLabel { Width: 64; Height: 16; }
.layout-LaunchingPage-LaunchingSpeedValue { Height: 16; Weight: 1; }
.layout-LaunchingPage-LaunchingHintBox { Height: 84; Margin: 0,12,0,0; }
.layout-LaunchingPage-23 { Orientation: Vertical; Spacing: 4; Margin: 12,12,12,12; }
.layout-LaunchingPage-LaunchingHintTitle { Height: 16; HorizontalAlignment: Center; }
.layout-LaunchingPage-LaunchingHintValue { Height: 32; HorizontalAlignment: Center; }
.layout-LaunchingPage-LaunchingCancelButton { Height: 40; Margin: 32,16,32,0; }
.layout-LaunchingPage-LaunchingBottomInset { Height: 24; }
