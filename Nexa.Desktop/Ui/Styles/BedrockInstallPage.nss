/* BedrockInstallPage layout. */
.layout-BedrockInstallPage-BedrockInstallCard { Orientation: Vertical; Width: 480; Height: 384; HorizontalAlignment: Center; VerticalAlignment: Center; Padding: 30; Spacing: 14; }
.layout-BedrockInstallPage-BedrockInstallIcon { Width: 40; Height: 40; HorizontalAlignment: Center; }
.layout-BedrockInstallPage-BedrockInstallHeader { Orientation: Vertical; Spacing: 6; }
.layout-BedrockInstallPage-BedrockInstallTitle { Height: 30; HorizontalAlignment: Center; }
.layout-BedrockInstallPage-BedrockInstallDescription { Height: 60; }
.layout-BedrockInstallPage-BedrockInstallStatus { Height: 48; }
.layout-BedrockInstallPage-BedrockInstallActions { Orientation: Horizontal; Height: 44; Spacing: 10; }
.layout-BedrockInstallPage-BedrockInstallStore { Weight: 1; Height: 44; }
.layout-BedrockInstallPage-BedrockInstallWebsite { Width: 142; Height: 44; }
.layout-BedrockInstallPage-BedrockInstallReturn { Height: 24; }
