/* Tools and captured diagnostics, kept separate from controller behaviour. */
.settings-advanced-body { Orientation: Vertical; Padding: 20,14,20,14; Spacing: 8; }
.settings-advanced-title { Height: 30; FontSize: 14; FontWeight: 600; Foreground: #2b3340; }
.settings-advanced-hint { Height: 38; FontSize: 11; Foreground: #717c8c; WrapText: true; }
.settings-advanced-value { Height: 28; FontSize: 12; Foreground: #2b3340; }
.settings-advanced-toolbar { Orientation: Horizontal; Spacing: 8; }
.settings-advanced-action { Width: 180; }
.settings-advanced-rows { Orientation: Vertical; Spacing: 6; }
.settings-advanced-route { Weight: 1; Height: 34; FontSize: 11; Foreground: #717c8c; VerticalAlignment: Center; }
.settings-advanced-label { Width: 220; Height: 28; FontSize: 12; Foreground: #717c8c; }
.settings-advanced-fact { Weight: 1; Height: 28; FontSize: 12; Foreground: #2b3340; TextAlignment: End; }
.settings-advanced-metadata { Height: 28; FontSize: 11; Foreground: #717c8c; }
