/* Backup and explicit diagnostic workspaces. */
.settings-workspace-column { Orientation: Vertical; Spacing: 8; }
.settings-workspace-actions { Orientation: Horizontal; Spacing: 8; }
.settings-workspace-action { Width: 116; }
.settings-workspace-backup { Orientation: Vertical; Spacing: 6; }
.settings-workspace-caption { Height: 28; FontSize: 12; Foreground: #2b3340; }
.settings-workspace-note { Height: 32; FontSize: 11; Foreground: #717c8c; WrapText: true; }
.settings-workspace-stats { Height: 48; FontSize: 11; Foreground: #717c8c; WrapText: true; }
.settings-workspace-intro { Height: 34; FontSize: 11; Foreground: #717c8c; WrapText: true; }
.settings-workspace-limit { Height: 28; FontSize: 11; Foreground: #717c8c; }
.settings-workspace-history { Height: 26; FontSize: 11; Foreground: #717c8c; }
.settings-workspace-message { Height: 60; FontSize: 11; Foreground: #717c8c; WrapText: true; }
.settings-workspace-migration-hint { Height: 40; FontSize: 11; Foreground: #717c8c; WrapText: true; }
.settings-workspace-ai-hint { Height: 42; FontSize: 11; Foreground: #717c8c; WrapText: true; }
.settings-workspace-field { Orientation: Horizontal; Spacing: 12; }
.settings-workspace-field-label { Width: 100; Height: 36; FontSize: 13; Foreground: #717c8c; }
.settings-workspace-input { Weight: 1; Height: 36; Padding: 12,0,12,0; Background: #f1f5fa; Foreground: #2b3340; CornerRadius: 9; FontSize: 13; Surface: Solid; }
