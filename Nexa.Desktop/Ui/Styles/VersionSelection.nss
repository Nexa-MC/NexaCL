/* Version selection: fixed tokens and finite content variants. */
.version-workspace-slot { Weight: 1; }
.version-base { Foreground: #263141; FontSize: 14; FontWeight: 400; CornerRadius: 12; }
.version-choose { Background: #FFFFFF; Border: #E3E9F2; BorderWidth: 1; Hover: #EDF3FD; }
.version-row { Margin: 0,0,0,8; Background: #FFFFFFF5; Border: #E3E9F2; BorderWidth: 1; Hover: #EDF3FD; }
.version-directory-row { Background: #FFFFFFF5; Border: #E3E9F2; BorderWidth: 1; Hover: #EDF3FD; }
.version-row-last { Margin: 0; }
.version-selected { Background: #E7F0FF; Border: #95BAEF; }
.version-title { FontSize: 16; FontWeight: 600; }
.version-detail { Foreground: #5E6E82; FontSize: 12; }
.version-path { TextAlignment: End; }
.version-empty { Foreground: #5E6E82; FontSize: 12; WrapText: true; }
.version-marker { Foreground: #0B5BCB; FontSize: 12; FontWeight: 600; }
.version-input { Background: #F0F4FA; FontSize: 13; Hover: #EDF3FD; }
.version-row-action { CornerRadius: 16; HoverExpand: true; FontSize: 13; TextAlignment: Center; }
.version-add { CornerRadius: 20; HoverExpand: true; FontSize: 13; FontWeight: 600; TextAlignment: Center; }
.version-refresh { CornerRadius: 20; FontSize: 13; }
.version-secondary { Background: #F0F4FA; FontSize: 13; TextAlignment: Center; Hover: #EDF3FD; }
.version-primary { Background: #0B5BCB; Foreground: #FFFFFF; FontSize: 13; TextAlignment: Center; Hover: #176EE1; }
.version-popup-dismiss { Background: #00000000; Hover: #00000000; }
.version-popup-metrics { MinHeight: 96; Margin: 0,0,0,160; }
