/* VersionDirectoryDropdown layout. */
.layout-VersionDirectoryDropdown-LibraryDropdownCard { Orientation: Vertical; VerticalAlignment: Start; Padding: 0; Spacing: 0; }
.layout-VersionDirectoryDropdown-LibraryDirectoryRows { Orientation: Vertical; Spacing: 4; Weight: 1; }
.layout-VersionDirectoryDropdown-LibraryNameEditor { Orientation: Horizontal; Height: 40; Spacing: 6; }
.layout-VersionDirectoryDropdown-LibraryNameInput { Height: 40; Weight: 1; }
.layout-VersionDirectoryDropdown-LibraryRenameSave { Width: 56; Height: 40; }
.layout-VersionDirectoryDropdown-LibraryRenameCancel { Width: 56; Height: 40; }
.layout-VersionDirectoryDropdown-LibraryPathEditor { Orientation: Horizontal; Height: 40; Spacing: 8; }
.layout-VersionDirectoryDropdown-LibraryDirectoryInput { Height: 40; Weight: 1; }
.layout-VersionDirectoryDropdown-LibraryAddPath { Width: 56; Height: 40; }

.layout-VersionDirectoryDropdown-Body { Orientation: Vertical; Weight: 1; Padding: 8; Spacing: 8; }
