/* VersionDirectoryDropdown layout. */
.layout-VersionDirectoryDropdown-LibraryDropdownCard { Orientation: Vertical; VerticalAlignment: Start; Padding: 4; Spacing: 8; }
.layout-VersionDirectoryDropdown-LibraryDirectoryRows { Orientation: Vertical; Spacing: 4; Weight: 1; }
.layout-VersionDirectoryDropdown-LibraryNameEditor { Orientation: Horizontal; Height: 36; Spacing: 6; }
.layout-VersionDirectoryDropdown-LibraryNameInput { Weight: 1; }
.layout-VersionDirectoryDropdown-LibraryRenameSave { Width: 56; Height: 36; }
.layout-VersionDirectoryDropdown-LibraryRenameCancel { Width: 56; Height: 36; }
.layout-VersionDirectoryDropdown-LibraryPathEditor { Orientation: Horizontal; Height: 36; Spacing: 8; }
.layout-VersionDirectoryDropdown-LibraryDirectoryInput { Weight: 1; }
.layout-VersionDirectoryDropdown-LibraryAddPath { Width: 56; Height: 36; }
