/* Owned launch-home and launching presentation variants. */
.launch-install-home-slot { Weight: 1; }
#LaunchHomeWorkspace { Weight: 1; }
.launch-install-launching-host { Weight: 1; }
.launch-install-home-widget-inactive { Height: 6; Background: #0b5bcb40; }
.launch-install-home-widget-active { Height: 16; Background: #0b5bcbff; }
.launch-install-home-profile { Height: 56; Background: #f4f6fa; Foreground: #343d4a; CornerRadius: 12; Hover: #eef2f7; Surface: Solid; }
.launch-install-home-profile-selected { Background: #e0eafd; Foreground: #0b5bcb; }
.launch-install-home-profile-name { Foreground: #343d4a; FontSize: 14; FontWeight: 600; }
.launch-install-home-profile-name-selected { Foreground: #0b5bcb; }
.launch-install-home-profile-detail { Foreground: #606c7c; FontSize: 12; FontWeight: 400; }
.launch-install-home-profile-delete { Background: transparent; Foreground: #606c7c; CornerRadius: 14; Hover: #ffe0e0; Surface: Solid; }
.layout-LaunchingPage-LaunchingCard { Background: #fffffff1; Foreground: #343d4a; Border: #e0eafd; BorderWidth: 1; Surface: Solid; CornerRadius: 16; }
.layout-LaunchingPage-LaunchingTitle { Foreground: #343d4a; FontSize: 22; FontWeight: 600; }
.layout-LaunchingPage-LaunchingName { Foreground: #606c7c; FontSize: 14; }
.layout-LaunchingPage-LaunchingStageLabel, .layout-LaunchingPage-LaunchingMethodLabel, .layout-LaunchingPage-LaunchingPercentLabel, .layout-LaunchingPage-LaunchingSpeedLabel { Foreground: #606c7c; FontSize: 12; }
.layout-LaunchingPage-LaunchingStageValue, .layout-LaunchingPage-LaunchingMethodValue, .layout-LaunchingPage-LaunchingPercentValue, .layout-LaunchingPage-LaunchingSpeedValue { Foreground: #343d4a; FontSize: 12; }
.layout-LaunchingPage-LaunchingHintTitle { Foreground: #606c7c; FontSize: 11; FontWeight: 600; TextAlignment: Center; }
.layout-LaunchingPage-LaunchingHintValue { Foreground: #606c7c; FontSize: 12; TextAlignment: Center; }
.layout-LaunchingPage-LaunchProgressTrack { Background: #e0eafd; Foreground: #343d4a; CornerRadius: 2; Surface: Solid; }
.layout-LaunchingPage-LaunchProgressFill { Background: #0b5bcb; Foreground: #0b5bcb; CornerRadius: 2; Surface: Solid; }
.layout-LaunchingPage-LaunchingHintBox { Background: #eef2f7; Foreground: #343d4a; CornerRadius: 12; Surface: Solid; }
.layout-LaunchingPage-LaunchingCancelButton { Background: #eef2f7; Foreground: #343d4a; CornerRadius: 20; FontSize: 14; FontWeight: 600; TextAlignment: Center; Surface: Solid; }
