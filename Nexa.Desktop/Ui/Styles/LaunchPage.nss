/* LaunchPage layout. */
.layout-LaunchPage-2 { Orientation: Horizontal; Spacing: 20; }
.layout-LaunchPage-CardAccount { Orientation: Vertical; Weight: 0.92; MinWidth: 240; MaxWidth: 360; }
.layout-LaunchPage-AccountContent { Orientation: Vertical; Weight: 1; Margin: 24,20,24,20; }
.layout-LaunchPage-AccountHeaderRow { Orientation: Horizontal; Spacing: 8; Height: 32; Margin: 0,0,0,12; }
.layout-LaunchPage-AccountBack { Width: 32; Height: 32; }
.layout-LaunchPage-AccountHeader { Weight: 1; VerticalAlignment: Center; TransitionOffsetY: 0; }
.layout-LaunchPage-AccountAdd { Width: 72; Height: 32; VerticalAlignment: Center; }
.layout-LaunchPage-AccountBody { Orientation: Vertical; Weight: 1; MinHeight: 160; }
.layout-LaunchPage-AccountSelected { Orientation: Vertical; Weight: 1; }
.layout-LaunchPage-AccountIdentity { Orientation: Vertical; Weight: 1; VerticalAlignment: Center; }
.layout-LaunchPage-AccountAvatarSurface { Width: 88; Height: 88; HorizontalAlignment: Center; }
.layout-LaunchPage-AccountAvatar { Width: 72; Height: 72; Weight: 1; HorizontalAlignment: Center; VerticalAlignment: Center; }
.layout-LaunchPage-AccountName { Height: 30; Margin: 0,16,0,0; }
.layout-LaunchPage-AccountKind { Height: 20; Margin: 0,4,0,0; }
.layout-LaunchPage-AccountActions { Orientation: Horizontal; Spacing: 8; HorizontalAlignment: End; Margin: 0,20,0,0; }
.layout-LaunchPage-AccountSwitch { Height: 36; Width: 110; }
.layout-LaunchPage-AccountWardrobe { Height: 36; Width: 96; }
.layout-LaunchPage-AccountPicker { Orientation: Vertical; Weight: 1; Spacing: 10; }
.layout-LaunchPage-AccountHint { Height: 36; }
.layout-LaunchPage-AccountRows { Orientation: Vertical; Weight: 1; MaxHeight: 300; Spacing: 6; }
.layout-LaunchPage-AccountImport { Height: 34; }
.layout-LaunchPage-RightColumn { Orientation: Vertical; Spacing: 12; Weight: 1.35; MinWidth: 280; }
.layout-LaunchPage-CardVersion { Orientation: Vertical; }
.layout-LaunchPage-VersionContent { Orientation: Vertical; Spacing: 10; Margin: 20,20,20,20; }
.layout-LaunchPage-VersionHeaderRow { Orientation: Horizontal; }
.layout-LaunchPage-VersionHeader { VerticalAlignment: Center; }
.layout-LaunchPage-InstanceListButton { Width: 98; Height: 36; HorizontalAlignment: End; }
.layout-LaunchPage-InstanceRow { Orientation: Vertical; }
.layout-LaunchPage-InstanceRowContent { Orientation: Horizontal; Spacing: 12; Margin: 12,10,12,10; }
.layout-LaunchPage-VersionName { Height: 48; Weight: 1; VerticalAlignment: Center; }
.layout-LaunchPage-VersionActions { Orientation: Horizontal; Spacing: 8; HorizontalAlignment: End; VerticalAlignment: Center; }
.layout-LaunchPage-InstanceModify { Width: 72; Height: 36; }
.layout-LaunchPage-InstanceSettings { Width: 72; Height: 36; }
.layout-LaunchPage-LaunchButton { Height: 48; }
.layout-LaunchPage-LaunchButtonText { VerticalAlignment: Center; HorizontalAlignment: Center; }
.layout-LaunchPage-CardAbout { Orientation: Vertical; Weight: 1; }
.layout-LaunchPage-AboutContent { Orientation: Horizontal; Spacing: 8; Weight: 1; Margin: 18,14,10,14; }
.layout-LaunchPage-40 { Orientation: Vertical; Spacing: 8; Weight: 1; }
.layout-LaunchPage-LaunchWidgetPager { Weight: 1; }
.layout-LaunchPage-AboutCopy { Orientation: Vertical; Spacing: 8; }
.layout-LaunchPage-AboutTitle { Height: 24; }
.layout-LaunchPage-AboutMessage { Height: 56; }
.layout-LaunchPage-46 { Orientation: Vertical; Spacing: 8; }
.layout-LaunchPage-TriviaTitle { Height: 24; }
.layout-LaunchPage-TriviaMessage { Height: 56; TransitionOffsetY: 0; }
.layout-LaunchPage-EchoPage { Orientation: Vertical; Spacing: 8; }
.layout-LaunchPage-EchoTitle { Height: 24; }
.layout-LaunchPage-EchoMessage { Height: 56; }
.layout-LaunchPage-WidgetIndicators { Orientation: Vertical; Width: 6; Spacing: 8; VerticalAlignment: Center; }
.layout-LaunchPage-WidgetAboutIndicator { Width: 6; Height: 16; }
.layout-LaunchPage-WidgetAboutDot { Width: 6; Height: 16; HorizontalAlignment: Center; VerticalAlignment: Center; }
.layout-LaunchPage-WidgetTriviaIndicator { Width: 6; Height: 6; }
.layout-LaunchPage-WidgetTriviaDot { Width: 6; Height: 6; HorizontalAlignment: Center; VerticalAlignment: Center; }
.layout-LaunchPage-WidgetEchoIndicator { Width: 6; Height: 6; }
.layout-LaunchPage-WidgetEchoDot { Width: 6; Height: 6; HorizontalAlignment: Center; VerticalAlignment: Center; }

#LaunchButtonProgress { Surface: Solid; Background: #0b5bcb; CornerRadius: 20; }
.layout-LaunchPage-LaunchButtonText { Foreground: #ffffff; FontSize: 15; FontWeight: 600; }
