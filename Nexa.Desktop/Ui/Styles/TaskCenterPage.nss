/* TaskCenterPage layout. */
.layout-TaskCenterPage-TaskCenterRoot { Orientation: Vertical; Weight: 1; Padding: 0; }
.layout-TaskCenterPage-TaskCenterHeader { Orientation: Horizontal; Margin: 0,0,0,8; }
.layout-TaskCenterPage-TaskCenterHeaderIcon { Width: 22; Height: 22; Margin: 0,2,10,0; }
.layout-TaskCenterPage-TaskCenterTitle { Height: 38; Weight: 1; }
.layout-TaskCenterPage-TaskCenterClear { Width: 124; Height: 36; VerticalAlignment: Center; }
.layout-TaskCenterPage-TaskCenterSummary { Height: 22; Margin: 0,0,0,12; }
.layout-TaskCenterPage-TaskCenterBody { Weight: 1; }
.layout-TaskCenterPage-TaskCenterEmpty { Orientation: Vertical; Spacing: 8; HorizontalAlignment: Center; VerticalAlignment: Center; }
.layout-TaskCenterPage-TaskCenterEmptyIcon { Width: 36; Height: 36; HorizontalAlignment: Center; }
.layout-TaskCenterPage-TaskCenterEmptyTitle { Height: 20; HorizontalAlignment: Center; }
.layout-TaskCenterPage-TaskCenterEmptyHint { Height: 16; HorizontalAlignment: Center; }
.layout-TaskCenterPage-TaskCenterList { Orientation: Vertical; Spacing: 8; }
