/* InstallPage layout. */
.layout-InstallPage-InstallChoices { Orientation: Horizontal; Weight: 1; Spacing: 12; Padding: 0; }
.layout-InstallPage-InstallJavaChoice { Weight: 1; Padding: 0; }
.layout-InstallPage-InstallJavaChoiceContent { Orientation: Vertical; Weight: 1; Padding: 16; }
.layout-InstallPage-InstallJavaArtwork { Weight: 1; }
.layout-InstallPage-InstallJavaTitle { Height: 42; HorizontalAlignment: Center; }
.layout-InstallPage-InstallBedrockChoice { Weight: 1; Padding: 0; }
.layout-InstallPage-InstallBedrockChoiceContent { Orientation: Vertical; Weight: 1; Padding: 16; }
.layout-InstallPage-InstallBedrockArtwork { Weight: 1; }
.layout-InstallPage-InstallBedrockTitle { Height: 42; HorizontalAlignment: Center; }
