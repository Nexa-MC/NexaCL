/* Runtime inventory, with behavior and registry operations projected by the controller. */
.settings-java-inventory { Orientation: Vertical; Spacing: 10; }
.settings-java-header { Orientation: Horizontal; Spacing: 16; VerticalAlignment: Center; }
.settings-java-title { Height: 28; Weight: 1; FontSize: 18; FontWeight: 600; Foreground: #2b3340; VerticalAlignment: Center; }
.settings-java-instance-title { FontSize: 14; }
.settings-java-add { Width: 84; }
.settings-java-delete { Width: 108; }
.settings-java-refresh { Width: 36; Height: 36; Background: #f2f5f9; Foreground: #0b5bcb; CornerRadius: 10; Surface: Solid; Hover: #cfe1fe; VerticalAlignment: Center; }
.settings-java-body { Orientation: Vertical; Spacing: 10; }
.settings-java-row { Orientation: Horizontal; Spacing: 16; VerticalAlignment: Center; }
.settings-java-labels { Orientation: Vertical; Spacing: 4; Weight: 1; }
.settings-java-name { Height: 22; FontSize: 14; FontWeight: 500; Foreground: #2b3340; }
.settings-java-path { Height: 32; FontSize: 11; Foreground: #717c8c; WrapText: true; }
.settings-java-origin { Height: 22; FontSize: 11; Foreground: #717c8c; }
.settings-java-state { Height: 24; FontSize: 12; Foreground: #717c8c; }
.settings-java-missing-row { Orientation: Horizontal; Spacing: 12; VerticalAlignment: Center; }
.settings-java-missing-labels { Spacing: 3; }
.settings-java-missing-title { Height: 24; FontSize: 13; Foreground: #717c8c; }
.settings-java-actions { Orientation: Horizontal; Spacing: 16; VerticalAlignment: Center; }
.settings-java-choice-slot { Orientation: Vertical; VerticalAlignment: Center; }
.settings-java-choice { Width: 64; Height: 34; Foreground: #2b3340; CornerRadius: 7; FontSize: 12; TextAlignment: Center; Hover: #cfe1fe; Surface: Solid; }
.settings-java-enabled-track { Orientation: Horizontal; Spacing: 0; Width: 118; Padding: 3; Background: #f1f5fa; Foreground: #2b3340; CornerRadius: 9; Surface: Solid; }
.settings-java-enabled-option { Width: 56; }
