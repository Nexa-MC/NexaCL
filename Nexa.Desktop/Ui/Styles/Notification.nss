/* Notification layout. */
.layout-Notification-Notification { Orientation: Horizontal; Width: 360; }
.layout-Notification-NotificationAccent { Width: 4; Margin: 0,12,0,12; }
.layout-Notification-NotificationIcon { Width: 20; Height: 20; Margin: 14,18,0,0; VerticalAlignment: Start; }
.layout-Notification-NotificationCopy { Orientation: Vertical; Weight: 1; Spacing: 2; Margin: 10,12,8,10; }
.layout-Notification-NotificationLevel { Height: 18; }
.layout-Notification-NotificationClose { Width: 30; Height: 30; Margin: 0,10,10,0; VerticalAlignment: Start; }
