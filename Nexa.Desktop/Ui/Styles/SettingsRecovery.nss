/* Recovery policy, captured storage, paged snapshots and scoped restore actions. */
.settings-recovery-workspace { Orientation: Vertical; Spacing: 12; }
.settings-recovery-hint { FontSize: 12; Foreground: #717C8C; WrapText: true; }
.settings-recovery-policy-hint { Height: 28; }
.settings-recovery-storage-hint { Height: 42; }
.settings-recovery-status { Height: 28; FontSize: 13; Foreground: #717C8C; WrapText: true; }
.settings-recovery-fact { Orientation: Horizontal; Spacing: 20; }
.settings-recovery-fact-label { Width: 90; Height: 28; FontSize: 12; Foreground: #717C8C; }
.settings-recovery-fact-value { Weight: 1; Height: 28; FontSize: 13; Foreground: #2B3340; TextAlignment: End; }
.settings-recovery-snapshot { Orientation: Vertical; Spacing: 2; }
.settings-recovery-snapshot-time { Height: 26; FontSize: 14; Foreground: #2B3340; }
.settings-recovery-snapshot-summary { Height: 22; FontSize: 12; Foreground: #717C8C; }
.settings-recovery-count { Height: 26; FontSize: 13; Foreground: #717C8C; }
.settings-recovery-changes { Orientation: Vertical; Spacing: 0; }
.settings-recovery-category, .settings-recovery-change { Orientation: Horizontal; Spacing: 12; }
.settings-recovery-category-label { Weight: 1; Height: 34; FontSize: 13; Foreground: #2B3340; }
.settings-recovery-change-identity { Weight: 1; Orientation: Vertical; Spacing: 2; }
.settings-recovery-change-kind { Height: 22; FontSize: 12; Foreground: #717C8C; }
.settings-recovery-change-path { Height: 42; FontSize: 14; Foreground: #2B3340; WrapText: true; }
.settings-recovery-button { Height: 34; Background: #F2F5F9; Foreground: #0B5BCB; CornerRadius: 9; FontSize: 12; FontWeight: 500; TextAlignment: Center; Surface: Solid; }
.settings-recovery-next { Width: 180; }
.settings-recovery-restore-all { Width: 140; }
.settings-recovery-category-restore { Width: 84; }
.settings-recovery-change-restore { Width: 100; }
