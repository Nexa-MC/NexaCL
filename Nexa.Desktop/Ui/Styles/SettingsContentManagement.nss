/* Instance content workspaces and finite presentation variants. */
.settings-content-workspace { Orientation: Vertical; Spacing: 12; }
.settings-content-toolbar { Orientation: Horizontal; Spacing: 10; }
.settings-content-button { Height: 34; Background: #f2f5f9; Foreground: #0b5bcb; FontWeight: 500; CornerRadius: 9; FontSize: 12; TextAlignment: Center; Hover: #cfe1fe; Surface: Solid; }
.settings-content-search { Weight: 1; Height: 36; Padding: 12,0,12,0; Background: #f1f4f8; Foreground: #2b3340; CornerRadius: 10; FontSize: 13; Surface: Solid; }
.settings-content-location { Orientation: Horizontal; Spacing: 12; }
.settings-content-path { Height: 24; Weight: 1; FontSize: 12; Foreground: #5e6e82; }
.settings-content-count { Height: 24; FontSize: 12; Foreground: #5e6e82; }
.settings-content-online-status { Width: 268; }
.settings-content-message { Height: 28; FontSize: 13; Foreground: #5e6e82; }
.settings-content-list { Orientation: Vertical; Spacing: 0; }
.settings-content-card { Orientation: Vertical; Spacing: 0; Margin: 0,0,0,8; Background: #ffffff; Foreground: #2b3340; CornerRadius: 12; Surface: Solid; }
.settings-content-card-selected { Background: #e7f0ff; }
.settings-content-card-body { Orientation: Horizontal; Spacing: 14; Weight: 1; VerticalAlignment: Stretch; Padding: 16,10,16,10; }
.settings-content-icon { Width: 48; Height: 48; Background: #f2f5f9; Foreground: #5e6e82; CornerRadius: 10; Surface: Solid; }
.settings-content-copy { Orientation: Vertical; Spacing: 2; Weight: 1; }
.settings-content-title { Height: 26; FontSize: 15; FontWeight: 550; Foreground: #2b3340; }
.settings-content-description { Height: 22; FontSize: 12; FontWeight: 400; Foreground: #5e6e82; WrapText: true; }
.settings-content-version { Width: 116; Height: 24; FontSize: 12; Foreground: #5e6e82; TextAlignment: End; }
.settings-content-pills { Orientation: Horizontal; Spacing: 6; }
.settings-content-pill { Height: 32; CornerRadius: 16; Background: #e0eafd; Foreground: #0b5bcb; HoverExpand: true; }
.settings-content-selection-mark { Width: 3; Height: 28; Margin: 5,0,0,0; HorizontalAlignment: Start; Background: #0b5bcb; Foreground: #0b5bcb; CornerRadius: 1.5; Surface: Solid; }
.settings-content-empty { Height: 48; FontSize: 13; Foreground: #5e6e82; }
.settings-content-facts { Orientation: Vertical; Spacing: 0; }
.settings-content-fact { Orientation: Horizontal; Spacing: 20; }
.settings-content-fact-label { Width: 90; Height: 28; FontSize: 12; Foreground: #5e6e82; }
.settings-content-fact-value { Weight: 1; Height: 28; FontSize: 13; Foreground: #2b3340; TextAlignment: End; }
.settings-content-detail { Orientation: Vertical; Background: #ffffff; Foreground: #2b3340; CornerRadius: 16; Surface: Solid; }
.settings-content-detail-body { Orientation: Vertical; Spacing: 16; Padding: 16; }
.settings-content-identity { Orientation: Horizontal; Spacing: 18; }
.settings-content-hero-icon { Width: 72; Height: 72; Background: #f2f5f9; Foreground: #5e6e82; CornerRadius: 10; Surface: Solid; }
.settings-content-hero-title { Height: 34; FontSize: 21; FontWeight: 550; Foreground: #2b3340; }
.settings-content-subtitle { Height: 26; FontSize: 13; Foreground: #5e6e82; }
.settings-content-long { FontSize: 14; Foreground: #2b3340; WrapText: true; }
.settings-content-toggle-label { Height: 32; FontSize: 13; Foreground: #2b3340; }
.settings-content-toggle { Width: 72; }
.settings-content-selection-count { Weight: 1; Height: 32; FontSize: 12; Foreground: #5e6e82; }
.settings-content-heading { Height: 30; FontSize: 16; FontWeight: 600; Foreground: #2b3340; }
.settings-content-history-caption { Weight: 1; Height: 38; FontSize: 13; Foreground: #2b3340; }
.settings-content-trash-body { Orientation: Horizontal; Spacing: 12; Padding: 16,8,16,8; }
.settings-content-trash-name { Weight: 1; Height: 38; FontSize: 14; Foreground: #2b3340; }
.settings-content-category-track { Orientation: Horizontal; Spacing: 0; Width: 432; Background: #f1f5fa; Foreground: #2b3340; CornerRadius: 9; Surface: Solid; }
.settings-content-category-thumb { Background: #ffffff; Foreground: #2b3340; CornerRadius: 7; Surface: Solid; }
.settings-content-category { Width: 72; Height: 34; Background: #00000000; Foreground: #2b3340; CornerRadius: 7; FontSize: 12; FontWeight: 450; TextAlignment: Center; }
.settings-content-category-selected { Foreground: #0b5bcb; FontWeight: 600; }
.settings-content-metric-files { Height: 84; Width: 104; Spacing: 8; Padding: 92,3,8,0; MaxHeight: 512; MaxWidth: 100000; }

.settings-content-rule-title { Height: 28; FontSize: 13; FontWeight: 600; Foreground: #2b3340; }
.settings-content-rule { FontSize: 12; Foreground: #5e6e82; WrapText: true; }
.settings-content-rule-note { FontSize: 11; Foreground: #5e6e82; WrapText: true; }
.settings-content-integrity { Orientation: Vertical; Spacing: 8; }
.settings-content-integrity-title { Height: 30; FontSize: 15; FontWeight: 600; Foreground: #2b3340; }
.settings-content-integrity-message { Height: 34; FontSize: 12; Foreground: #5e6e82; }
.settings-content-integrity-fact { Orientation: Horizontal; Spacing: 12; }
.settings-content-integrity-label { Width: 132; Height: 28; FontSize: 12; Foreground: #5e6e82; }
.settings-content-integrity-value { Weight: 1; Height: 28; FontSize: 12; Foreground: #2b3340; }
.settings-content-integrity-note { Height: 40; FontSize: 11; Foreground: #5e6e82; WrapText: true; }

.settings-content-graph-tools { Orientation: Horizontal; Spacing: 8; }
.settings-content-graph-caption { Height: 24; FontSize: 12; Foreground: #5e6e82; }
.settings-content-graph-canvas { Height: 380; Background: #f7f9fc; Foreground: #2b3340; CornerRadius: 14; Surface: Solid; }
.settings-content-graph-selection { Orientation: Vertical; Spacing: 6; }
.settings-content-graph-title { FontSize: 16; Foreground: #2b3340; WrapText: true; }
.settings-content-graph-consumer { Width: 220; }
.settings-content-graph-enabled { Foreground: #0b5bcb; }
.settings-content-graph-disabled { Foreground: #5e6e82; }
.settings-content-graph-cycle { Foreground: #cf7921; }
.settings-content-graph-missing { Foreground: #c4423e; }
.settings-content-graph-metric { Width: 700; Height: 380; }

.settings-content-screenshot-scrim { VerticalAlignment: Stretch; Background: #0f1622b4; Foreground: #2b3340; Surface: Solid; }
.settings-content-screenshot-dialog { Orientation: Vertical; HorizontalAlignment: Center; VerticalAlignment: Center; Background: #ffffff; Foreground: #2b3340; CornerRadius: 18; Surface: Solid; }
.settings-content-screenshot-body { Orientation: Vertical; Spacing: 10; Padding: 16; }
.settings-content-screenshot-header { Orientation: Horizontal; Spacing: 12; }
.settings-content-screenshot-title { Weight: 1; Height: 34; FontSize: 17; FontWeight: 600; Foreground: #2b3340; }
.settings-content-screenshot-image { Background: #f2f5f9; Foreground: #5e6e82; CornerRadius: 10; Surface: Solid; }
.settings-content-screenshot-dimensions { Height: 20; FontSize: 11; Foreground: #5e6e82; }
.settings-content-screenshot-status { Height: 24; FontSize: 12; Foreground: #5e6e82; }
.settings-content-screenshot-actions { Spacing: 8; }
.settings-content-screenshot-crop { Orientation: Vertical; Spacing: 10; }
.settings-content-screenshot-crop-title { Height: 28; FontSize: 14; FontWeight: 600; Foreground: #2b3340; }
.settings-content-screenshot-fields { Orientation: Horizontal; Spacing: 16; }
.settings-content-screenshot-field-column { Orientation: Vertical; Spacing: 6; Weight: 1; }
.settings-content-screenshot-field { Orientation: Horizontal; Spacing: 12; }
.settings-content-screenshot-field-label { Width: 80; Height: 36; FontSize: 12; Foreground: #5e6e82; }
.settings-content-screenshot-input { Weight: 1; Height: 36; Padding: 12,0,12,0; Background: #f1f5fa; Foreground: #2b3340; CornerRadius: 9; FontSize: 13; Surface: Solid; }
.settings-content-screenshot-waterfall { Orientation: Horizontal; Spacing: 12; }
.settings-content-screenshot-column { Orientation: Vertical; Spacing: 0; VerticalAlignment: Start; }
.settings-content-screenshot-heading { FontSize: 15; FontWeight: 600; Foreground: #2b3340; }
.settings-content-screenshot-card { Orientation: Vertical; Spacing: 0; Background: #ffffff; Foreground: #2b3340; CornerRadius: 14; Surface: Solid; }
.settings-content-screenshot-card-body { Orientation: Vertical; Spacing: 8; Padding: 12; }
.settings-content-screenshot-card-name { Height: 26; FontSize: 12; Foreground: #2b3340; }
.settings-content-screenshot-card-time { Height: 20; FontSize: 11; Foreground: #5e6e82; }
.settings-content-screenshot-metric { Width: 1120; Height: 680; MinWidth: 240; MinHeight: 120; MaxWidth: 620; MaxHeight: 360; Padding: 80,56,248,520; Margin: 200,100,84,320; }

.settings-content-gallery-metric { Width: 220; Height: 34; MaxHeight: 1024; Spacing: 12; Padding: 12,8,26,28; Margin: 9,16,0,0; }

.settings-content-binary-track { Orientation: Horizontal; Spacing: 0; Width: 118; Padding: 3; Background: #f1f5fa; Foreground: #2b3340; CornerRadius: 9; Surface: Solid; }
.settings-content-binary-option { Width: 56; Height: 34; Background: #00000000; Foreground: #2b3340; CornerRadius: 7; FontSize: 12; FontWeight: 450; TextAlignment: Center; }

.settings-content-file-card { Margin: 0,0,0,8; Background: #ffffff; Foreground: #2b3340; CornerRadius: 12; Surface: Solid; }

.settings-content-card-selected { Background: #e7f0ff; }
.settings-content-category-selected { Foreground: #0b5bcb; FontWeight: 600; }

.settings-content-copy-metric { Width: 40; Height: 22; MinHeight: 1; MaxHeight: 2; }
