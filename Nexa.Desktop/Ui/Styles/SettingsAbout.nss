/* About and optional diagnostic export presentation. */
.settings-about { Orientation: Vertical; Spacing: 18; }
.settings-about-section { Orientation: Vertical; Spacing: 8; }
.settings-about-product { Height: 36; FontSize: 24; FontWeight: 600; Foreground: #2b3340; }
.settings-about-title { Height: 28; FontSize: 18; FontWeight: 600; Foreground: #2b3340; }
.settings-about-copy { Height: 84; FontSize: 13; Foreground: #717c8c; WrapText: true; }
.settings-about-license { Height: 120; }
.settings-about-actions { Orientation: Horizontal; Spacing: 10; }
.settings-about-link { Width: 96; }
.settings-about-license-link { Width: 128; }
.settings-diagnostic-export { Width: 144; }
.settings-diagnostic-description { Height: 64; FontSize: 12; Foreground: #717c8c; WrapText: true; }
