.setup-workspace-slot { Weight: 1; }
.setup-base { Surface: Solid; Background: #00000000; Foreground: #343D4A; CornerRadius: 10; FontSize: 15; FontWeight: 400; TextAlignment: Start; WrapText: true; Hover: #CFE1FE; }
.setup-button { Background: #E0EAFD; Foreground: #0B5BCB; TextAlignment: Center; WrapText: false; }
.setup-primary { Background: #0B5BCB; Foreground: #FFFFFF; CornerRadius: 22; FontWeight: 600; }
.setup-title { FontSize: 32; FontWeight: 600; }
.setup-description { Foreground: #606C7C; FontSize: 16; }
.setup-progress { Foreground: #7A8A99; FontSize: 13; }
.setup-step-layer { VerticalAlignment: Start; }
.setup-error { Foreground: #AD3030; FontSize: 14; }
.setup-surface { Background: #F3F6FA; FontSize: 14; }
.setup-body-welcome { Orientation: Horizontal; Weight: 1; Spacing: 32; MaxWidth: 600; HorizontalAlignment: Center; }
.setup-body-flow { Orientation: Horizontal; Weight: 1; Spacing: 32; Margin: 0,42,0,0; }
.setup-hero-welcome { Width: 144; Height: 144; VerticalAlignment: Center; }
.setup-hero-flow { Width: 64; Height: 64; VerticalAlignment: Start; }
.setup-form-welcome { Orientation: Vertical; Weight: 1; Spacing: 14; VerticalAlignment: Center; }
.setup-form-flow { Orientation: Vertical; Weight: 1; Spacing: 14; }
.setup-consent-on { Background: #E0EAFD; Foreground: #343D4A; }
.setup-consent-off { Background: #F3F6FA; Foreground: #343D4A; }
.setup-frame-metrics { MinWidth: 240; MaxWidth: 768; Padding: 36,0,36,0; }
