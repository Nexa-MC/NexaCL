/* ResourcesPage layout. */
.layout-ResourcesPage-ResourcesLayout { Orientation: Vertical; Weight: 1; Spacing: 8; Padding: 0; }
.layout-ResourcesPage-ResourceCategories { Orientation: Horizontal; Height: 34; Spacing: 8; }
.layout-ResourcesPage-ResourceToolbar { Orientation: Horizontal; Height: 36; Spacing: 6; }
.layout-ResourcesPage-ResourceExtensionCard { Orientation: Vertical; Height: 96; Padding: 12,8,12,8; Spacing: 2; }
.layout-ResourcesPage-ResourceList { Orientation: Vertical; Weight: 1; MinHeight: 80; Spacing: 6; }
.layout-ResourcesPage-ResourcePagination { Orientation: Horizontal; Height: 28; Spacing: 8; }
