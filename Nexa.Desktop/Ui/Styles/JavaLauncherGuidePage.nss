.java-launcher-guide-host { Weight: 1; }
.java-launcher-guide-card { Orientation: Vertical; Width: 560; Padding: 24; Spacing: 12; HorizontalAlignment: Center; VerticalAlignment: Center; }
.java-launcher-guide-icon { Width: 32; Height: 32; HorizontalAlignment: Center; }
.java-launcher-guide-title { FontSize: 20; FontWeight: 600; WrapText: true; }
.java-launcher-guide-copy { WrapText: true; MinHeight: 36; }
.java-launcher-guide-button { Height: 44; }
