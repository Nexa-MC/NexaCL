/* Launch/install product surfaces and virtual catalogue metrics. */
.launch-install-InstallJavaChoice { Background: #e5efff; Foreground: #343d4a; Border: #e0eafd; BorderWidth: 1; CornerRadius: 16; Hover: #d6e7ff; Surface: Solid; }
.launch-install-InstallBedrockChoice { Background: #ebf4e9; Foreground: #343d4a; Border: #e0eafd; BorderWidth: 1; CornerRadius: 16; Hover: #deeedb; Surface: Solid; }
.launch-install-InstallJavaArtwork { Background: transparent; Foreground: #1c61d2; CornerRadius: 12; Surface: Solid; }
.launch-install-InstallBedrockArtwork { Background: transparent; Foreground: #396945; CornerRadius: 12; Surface: Solid; }
.launch-install-InstallJavaTitle, .launch-install-InstallBedrockTitle { Foreground: #343d4a; FontSize: 28; FontWeight: 650; TextAlignment: Center; }
.launch-install-input { Background: #ffffff; Foreground: #343d4a; Border: #e0eafd; BorderWidth: 1; CornerRadius: 12; FontSize: 14; Surface: Solid; }
.launch-install-start { Background: #1c61d2; Foreground: #ffffff; Hover: #1370f3; CornerRadius: 20; FontSize: 13; FontWeight: 650; TextAlignment: Center; Surface: Solid; }
.launch-install-tabs { Background: transparent; Foreground: #343d4a; CornerRadius: 10; Surface: Solid; }
.launch-install-thumb { Background: #ffffff; Foreground: #343d4a; CornerRadius: 8; Surface: Solid; }
.launch-install-tab { Background: transparent; Foreground: #0b5bcb; Hover: transparent; CornerRadius: 0; FontSize: 13; FontWeight: 500; TextAlignment: Center; Surface: Solid; }
.launch-install-tab-active { Foreground: #0b5bcb; FontWeight: 650; }
.launch-install-catalog-page { Background: transparent; Foreground: #343d4a; CornerRadius: 0; Surface: Solid; }
.launch-install-catalog-title { Foreground: #343d4a; FontSize: 19; FontWeight: 650; }
.launch-install-versions { Background: #ffffff; Foreground: #343d4a; Border: #e0eafd; BorderWidth: 1; CornerRadius: 16; Surface: Solid; }
.launch-install-choice { Height: 40; Background: #ffffff; Foreground: #343d4a; Border: #e0eafd; BorderWidth: 1; CornerRadius: 12; Hover: #eef2f7; FontSize: 13; FontWeight: 550; TextAlignment: Center; Surface: Solid; }
.launch-install-choice-active { Background: #e5efff; Foreground: #1c61d2; Border: #80acef; Hover: #e5efff; FontWeight: 650; }
.launch-install-addon { CornerRadius: 18; }
.launch-install-catalog-row { Height: 48; Margin: 0,0,0,2; Background: transparent; Foreground: #343d4a; CornerRadius: 12; Hover: #eef2f7; FontSize: 14; Surface: Solid; }
.launch-install-catalog-row-selected { Background: #f4f6fa; }
.launch-install-catalog-check { Foreground: transparent; FontSize: 14; }
.launch-install-catalog-check-selected { Foreground: #0b5bcb; }
.launch-install-catalog-name { Foreground: #343d4a; FontSize: 14; }
.launch-install-catalog-detail { Foreground: #606c7c; FontSize: 14; }
.launch-install-catalog-status { Height: 40; Foreground: #606c7c; FontSize: 13; WrapText: true; }
.launch-install-virtual-metrics { Height: 48; Spacing: 2; Width: 10; Padding: 4; MinHeight: 240; MaxHeight: 64; MaxWidth: 100000; }

.launch-install-title-motion { Width: 12; }
.launch-install-tab { Height: 36; VerticalAlignment: Center; Padding: 0; }
#JavaMinecraftTab { Width: 104; }
#JavaForgeTab { Width: 76; }
#JavaCleanroomTab { Width: 104; }
#JavaNeoForgeTab { Width: 96; }
#JavaFabricTab { Width: 80; }
#JavaLegacyFabricTab { Width: 128; }
#JavaFabricApiTab, #JavaOptiFabricTab, #JavaQslTab, #JavaLiteLoaderTab { Width: 112; }
#JavaQuiltTab { Width: 104; }
#JavaLabyModTab { Width: 76; }
#JavaOptiFineTab { Width: 96; }
