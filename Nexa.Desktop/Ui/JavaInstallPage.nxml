<nxml-page>
  <Page Key="JavaInstallPage" Label="安装 Java 版">
    <StackPanel Key="JavaInstallContent" Class="layout-JavaInstallPage-JavaInstallContent">
      <StackPanel Key="JavaInstallEntryRow" Class="layout-JavaInstallPage-JavaInstallEntryRow">
        <TextInput Key="JavaInstallVersionInput" Label="搜索版本" Placeholder="搜索版本" Class="layout-JavaInstallPage-JavaInstallVersionInput" />
        <Button Key="JavaInstallStart" Label="开始安装 Java 版 Minecraft" Content="开始安装" Icon="lucide/arrow-right" Command="ui.install.start" Class="layout-JavaInstallPage-JavaInstallStart" />
      </StackPanel>
      <ContentHost Class="java-install-navigation-surface">
      <StackPanel Key="JavaInstallPagerTabs" Label="Java 版安装子页面" Scroll="true" Class="layout-JavaInstallPage-JavaInstallPagerTabs">
        <ContentHost Key="JavaInstallThumb" IsVisible="false" />
        <Button Key="JavaMinecraftTab" Label="显示 Minecraft 安装选项" Content="Minecraft" Command="ui.install.page.minecraft" Class="layout-JavaInstallPage-JavaMinecraftTab" />
        <Button Key="JavaForgeTab" Label="显示 Forge 安装选项" Content="Forge" Command="ui.install.page.forge" Class="layout-JavaInstallPage-JavaForgeTab" />
        <Button Key="JavaCleanroomTab" Label="显示 Cleanroom 安装选项" Content="Cleanroom" Command="ui.install.page.cleanroom" Class="layout-JavaInstallPage-JavaCleanroomTab" />
        <Button Key="JavaNeoForgeTab" Label="显示 NeoForge 安装选项" Content="NeoForge" Command="ui.install.page.neoforge" Class="layout-JavaInstallPage-JavaNeoForgeTab" />
        <Button Key="JavaFabricTab" Label="显示 Fabric 安装选项" Content="Fabric" Command="ui.install.page.fabric" Class="layout-JavaInstallPage-JavaFabricTab" />
        <Button Key="JavaLegacyFabricTab" Label="显示 Legacy Fabric 安装选项" Content="Legacy Fabric" Command="ui.install.page.legacy-fabric" Class="layout-JavaInstallPage-JavaLegacyFabricTab" />
        <Button Key="JavaFabricApiTab" Label="显示 Fabric API 安装选项" Content="Fabric API" Command="ui.install.page.fabric-api" IsVisible="false" Class="layout-JavaInstallPage-JavaFabricApiTab" />
        <Button Key="JavaOptiFabricTab" Label="显示 OptiFabric 安装选项" Content="OptiFabric" Command="ui.install.page.optifabric" IsVisible="false" Class="layout-JavaInstallPage-JavaOptiFabricTab" />
        <Button Key="JavaQuiltTab" Label="显示 Quilt 安装选项" Content="Quilt" Command="ui.install.page.quilt" Class="layout-JavaInstallPage-JavaQuiltTab" />
        <Button Key="JavaQslTab" Label="显示 QSL 安装选项" Content="QSL" Command="ui.install.page.qsl" IsVisible="false" Class="layout-JavaInstallPage-JavaQslTab" />
        <Button Key="JavaLabyModTab" Label="显示 LabyMod 安装选项" Content="LabyMod" Command="ui.install.page.labymod" Class="layout-JavaInstallPage-JavaLabyModTab" />
        <Button Key="JavaOptiFineTab" Label="显示 OptiFine 安装选项" Content="OptiFine" Command="ui.install.page.optifine" Class="layout-JavaInstallPage-JavaOptiFineTab" />
        <Button Key="JavaLiteLoaderTab" Label="显示 LiteLoader 安装选项" Content="LiteLoader" Command="ui.install.page.liteloader" Class="layout-JavaInstallPage-JavaLiteLoaderTab" />
      </StackPanel>
      </ContentHost>
      <ContentHost Key="JavaInstallCatalogHost" Label="Java 版安装子页面内容" Class="layout-JavaInstallPage-JavaInstallCatalogHost">
        <HorizontalPager Key="JavaInstallPager" Label="Java 版安装子页面，可使用左右方向键或拖动切换" Class="layout-JavaInstallPage-JavaInstallPager">
          <StackPanel Key="JavaMinecraftPage" Label="Minecraft 安装选项" Scroll="true" Class="layout-JavaInstallPage-JavaMinecraftPage">
            <Text Key="JavaMinecraftPageTitle" Content="Minecraft" IsVisible="false" Class="layout-JavaInstallPage-JavaMinecraftPageTitle" />
            <StackPanel Key="JavaMinecraftVersions" Class="layout-JavaInstallPage-JavaMinecraftVersions" />
          </StackPanel>
          <StackPanel Key="JavaForgePage" Label="Forge 安装选项" Class="layout-JavaInstallPage-JavaForgePage">
            <Text Key="JavaForgePageTitle" Content="Forge" Class="layout-JavaInstallPage-JavaForgePageTitle" />
            <Button Key="JavaLoaderForge" Label="选择 Forge 加载器" Content="选择 Forge" Command="ui.install.loader.forge" Class="layout-JavaInstallPage-JavaLoaderForge" />
          </StackPanel>
          <StackPanel Key="JavaCleanroomPage" Label="Cleanroom 安装选项" Class="layout-JavaInstallPage-JavaCleanroomPage">
            <Text Key="JavaCleanroomPageTitle" Content="Cleanroom" Class="layout-JavaInstallPage-JavaCleanroomPageTitle" />
            <Button Key="JavaLoaderCleanroom" Label="选择 Cleanroom 加载器" Content="选择 Cleanroom" Command="ui.install.loader.cleanroom" Class="layout-JavaInstallPage-JavaLoaderCleanroom" />
          </StackPanel>
          <StackPanel Key="JavaNeoForgePage" Label="NeoForge 安装选项" Class="layout-JavaInstallPage-JavaNeoForgePage">
            <Text Key="JavaNeoForgePageTitle" Content="NeoForge" Class="layout-JavaInstallPage-JavaNeoForgePageTitle" />
            <Button Key="JavaLoaderNeoForge" Label="选择 NeoForge 加载器" Content="选择 NeoForge" Command="ui.install.loader.neoforge" Class="layout-JavaInstallPage-JavaLoaderNeoForge" />
          </StackPanel>
          <StackPanel Key="JavaFabricPage" Label="Fabric 安装选项" Class="layout-JavaInstallPage-JavaFabricPage">
            <Text Key="JavaFabricPageTitle" Content="Fabric" Class="layout-JavaInstallPage-JavaFabricPageTitle" />
            <Button Key="JavaLoaderFabric" Label="选择 Fabric 加载器" Content="选择 Fabric" Command="ui.install.loader.fabric" Class="layout-JavaInstallPage-JavaLoaderFabric" />
          </StackPanel>
          <StackPanel Key="JavaLegacyFabricPage" Label="Legacy Fabric 安装选项" Class="layout-JavaInstallPage-JavaLegacyFabricPage">
            <Text Key="JavaLegacyFabricPageTitle" Content="Legacy Fabric" Class="layout-JavaInstallPage-JavaLegacyFabricPageTitle" />
            <Button Key="JavaLoaderLegacyFabric" Label="选择 Legacy Fabric 加载器" Content="选择 Legacy Fabric" Command="ui.install.loader.legacy-fabric" Class="layout-JavaInstallPage-JavaLoaderLegacyFabric" />
          </StackPanel>
          <StackPanel Key="JavaFabricApiPage" Label="Fabric API 安装选项" IsVisible="false" Class="layout-JavaInstallPage-JavaFabricApiPage">
            <Text Key="JavaFabricApiPageTitle" Content="Fabric API" Class="layout-JavaInstallPage-JavaFabricApiPageTitle" />
            <Button Key="JavaFabricApiSelect" Label="添加 Fabric API" Content="添加 Fabric API" Command="ui.install.addon.fabric-api" Class="layout-JavaInstallPage-JavaFabricApiSelect" />
          </StackPanel>
          <StackPanel Key="JavaOptiFabricPage" Label="OptiFabric 安装选项" IsVisible="false" Class="layout-JavaInstallPage-JavaOptiFabricPage">
            <Text Key="JavaOptiFabricPageTitle" Content="OptiFabric" Class="layout-JavaInstallPage-JavaOptiFabricPageTitle" />
          </StackPanel>
          <StackPanel Key="JavaQuiltPage" Label="Quilt 安装选项" Class="layout-JavaInstallPage-JavaQuiltPage">
            <Text Key="JavaQuiltPageTitle" Content="Quilt" Class="layout-JavaInstallPage-JavaQuiltPageTitle" />
            <Button Key="JavaLoaderQuilt" Label="选择 Quilt 加载器" Content="选择 Quilt" Command="ui.install.loader.quilt" Class="layout-JavaInstallPage-JavaLoaderQuilt" />
          </StackPanel>
          <StackPanel Key="JavaQslPage" Label="QSL 安装选项" IsVisible="false" Class="layout-JavaInstallPage-JavaQslPage">
            <Text Key="JavaQslPageTitle" Content="QSL" Class="layout-JavaInstallPage-JavaQslPageTitle" />
            <Button Key="JavaQslSelect" Label="添加 QSL" Content="添加 QSL" Command="ui.install.addon.qsl" Class="layout-JavaInstallPage-JavaQslSelect" />
          </StackPanel>
          <StackPanel Key="JavaLabyModPage" Label="LabyMod 安装选项" Class="layout-JavaInstallPage-JavaLabyModPage">
            <Text Key="JavaLabyModPageTitle" Content="LabyMod" Class="layout-JavaInstallPage-JavaLabyModPageTitle" />
            <Button Key="JavaLoaderLabyMod" Label="选择 LabyMod 加载器" Content="选择 LabyMod" Command="ui.install.loader.labymod" Class="layout-JavaInstallPage-JavaLoaderLabyMod" />
          </StackPanel>
          <StackPanel Key="JavaOptiFinePage" Label="OptiFine 安装选项" Class="layout-JavaInstallPage-JavaOptiFinePage">
            <Text Key="JavaOptiFinePageTitle" Content="OptiFine" Class="layout-JavaInstallPage-JavaOptiFinePageTitle" />
            <Button Key="JavaLoaderOptiFine" Label="选择 OptiFine 加载器" Content="选择 OptiFine" Command="ui.install.loader.optifine" Class="layout-JavaInstallPage-JavaLoaderOptiFine" />
          </StackPanel>
          <StackPanel Key="JavaLiteLoaderPage" Label="LiteLoader 安装选项" Class="layout-JavaInstallPage-JavaLiteLoaderPage">
            <Text Key="JavaLiteLoaderPageTitle" Content="LiteLoader" Class="layout-JavaInstallPage-JavaLiteLoaderPageTitle" />
            <Button Key="JavaLoaderLiteLoader" Label="选择 LiteLoader 加载器" Content="选择 LiteLoader" Command="ui.install.loader.liteloader" Class="layout-JavaInstallPage-JavaLoaderLiteLoader" />
          </StackPanel>
        </HorizontalPager>
      </ContentHost>
    </StackPanel>
  </Page>
</nxml-page>
