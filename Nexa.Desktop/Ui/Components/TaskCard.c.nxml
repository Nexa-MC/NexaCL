<nxml-component>
  <StackPanel Key="TaskCard" Class="layout-TaskCard-TaskCard">
    <StackPanel Key="TaskCardContent" Class="layout-TaskCard-TaskCardContent">
      <StackPanel Key="TaskCardHeader" Class="layout-TaskCard-TaskCardHeader">
        <Image Key="TaskCardIcon" Source="lucide/loader-circle" Class="layout-TaskCard-TaskCardIcon" />
        <Text Key="TaskCardTitle" Content="任务" Class="layout-TaskCard-TaskCardTitle" />
        <Button Key="TaskCardAction" Icon="lucide/x" Label="取消任务" Command="ui.tasks.card.cancel" Class="layout-TaskCard-TaskCardAction" />
      </StackPanel>
      <StackPanel Key="TaskCardStatus" Class="layout-TaskCard-TaskCardStatus">
        <Text Key="TaskCardStage" Content="正在准备" Class="layout-TaskCard-TaskCardStage" />
        <Text Key="TaskCardPercent" Content="0%" Class="layout-TaskCard-TaskCardPercent" />
      </StackPanel>
      <ContentHost Key="TaskCardTrack" Class="layout-TaskCard-TaskCardTrack">
        <Progress Key="TaskCardFill" Label="任务进度条" Class="layout-TaskCard-TaskCardFill" />
      </ContentHost>
      <StackPanel Key="TaskCardMeta" Class="layout-TaskCard-TaskCardMeta">
        <Text Key="TaskCardFiles" Content="" Class="layout-TaskCard-TaskCardFiles" />
        <Text Key="TaskCardSpeed" Content="" Class="layout-TaskCard-TaskCardSpeed" />
      </StackPanel>
      <Text Key="TaskCardError" Content="" IsVisible="false" Class="layout-TaskCard-TaskCardError" />
      <Button Key="TaskCardDetails" Content="查看步骤" Label="展开任务步骤" Command="ui.tasks.card.details" Class="layout-TaskCard-TaskCardDetails" />
      <StackPanel Key="TaskCardSteps" IsVisible="false" Class="layout-TaskCard-TaskCardSteps" />
    </StackPanel>
  </StackPanel>
</nxml-component>
