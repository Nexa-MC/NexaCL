<nxml-component>
  <Node Kind="Notification" Recipe="StackLayout" Role="Status" Key="{data key}" Label="{data label}" Localize="false" Command="ui.feedback.notification.open" Clickable="true" Focusable="true" Enabled="{data enabled}" LiveSetting="{data urgency}" OverlayMotion="Notification" Class="{data style}">
    <StackPanel Key="NotificationAccent" Class="{data accent-style}" />
    <Node Kind="Image" Recipe="Image" Key="NotificationIcon" Source="{data icon}" Class="{data icon-style}" />
    <StackPanel Key="NotificationCopy" Class="layout-Notification-NotificationCopy">
      <Node Kind="Text" Recipe="Text" Key="NotificationLevel" Content="{data level}" Localize="false" Class="{data level-style}" />
      <Node Kind="Text" Recipe="Text" Key="NotificationMessage" Content="{data message}" Localize="false" MaxLines="2" TrimOverflow="true" Class="feedback-notification-message" />
    </StackPanel>
    <Button Key="NotificationClose" Label="{data close-label}" Localize="false" Icon="lucide/x" Enabled="{data enabled}" Command="ui.feedback.notification.dismiss" Class="{data close-style}" />
  </Node>
</nxml-component>
