<nxml-component>
  <ContentHost Key="DialogLayer" Label="模态遮罩">
    <Dialog Key="DialogCard" Label="确认" Class="layout-Dialog-DialogCard">
      <StackPanel Key="DialogHeader" Class="layout-Dialog-DialogHeader">
        <Image Key="DialogIcon" Label="需要确认" Source="lucide/info" Class="layout-Dialog-DialogIcon" />
        <Text Key="DialogTitle" Content="需要确认" Class="layout-Dialog-DialogTitle" />
      </StackPanel>
      <StackPanel Key="DialogMessageViewport" Scroll="true" Class="layout-Dialog-DialogMessageViewport">
        <Text Key="DialogMessage" Content="请确认是否继续。" Class="layout-Dialog-DialogMessage" />
      </StackPanel>
      <StackPanel Key="DialogActions" Class="layout-Dialog-DialogActions">
        <Button Key="DialogCancel" Label="取消" Content="取消" Command="ui.feedback.dialog.cancel" Class="layout-Dialog-DialogCancel" />
        <StackPanel Key="DialogActionSpacer" IsVisible="false" Class="layout-Dialog-DialogActionSpacer" />
        <Button Key="DialogAlternate" Label="选择 Java" Content="选择 Java" Command="ui.feedback.dialog.alternate" IsVisible="false" Class="layout-Dialog-DialogAlternate" />
        <Button Key="DialogAccept" Label="继续" Content="继续" Command="ui.feedback.dialog.accept" Class="layout-Dialog-DialogAccept" />
      </StackPanel>
    </Dialog>
  </ContentHost>
</nxml-component>
