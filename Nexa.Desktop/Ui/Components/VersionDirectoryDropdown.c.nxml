<nxml-component>
  <Node Kind="DirectoryPopup" Recipe="Element" Role="None" Key="LibraryDropdownLayer" ModalLayer="true" DismissCommand="ui.versions.dismiss" IsVisible="{data visible}">
    <Button Key="LibraryDropdownDismiss" Label="关闭目录下拉框" Command="ui.versions.dismiss" Focusable="false" Class="version-popup-dismiss" />
    <StackPanel Key="LibraryDropdownCard" Height="{data height}" Anchor="LibraryChooseDirectory" AnchorGap="4" Class="layout-VersionDirectoryDropdown-LibraryDropdownCard version-base version-choose">
      <StackPanel Key="LibraryDropdownBody" Class="layout-VersionDirectoryDropdown-Body version-base">
        <Dynamic Key="LibraryDirectoryRows" Scroll="true" ShowsVerticalIndicator="{data indicator}" Class="layout-VersionDirectoryDropdown-LibraryDirectoryRows version-base" />
        <StackPanel Key="LibraryNameEditor" IsVisible="{data renameVisible}" Class="layout-VersionDirectoryDropdown-LibraryNameEditor version-base">
          <TextInput Key="LibraryNameInput" Label="文件夹名称，留空则显示完整路径" Placeholder="文件夹名称" MaximumLength="2048" Class="layout-VersionDirectoryDropdown-LibraryNameInput version-base version-input" />
          <Button Key="LibraryRenameSave" Content="保存" Label="保存文件夹名称" Command="ui.versions.rename-save" Class="layout-VersionDirectoryDropdown-LibraryRenameSave version-base version-secondary" />
          <Button Key="LibraryRenameCancel" Content="取消" Label="取消修改名称" Command="ui.versions.rename-cancel" Class="layout-VersionDirectoryDropdown-LibraryRenameCancel version-base version-secondary" />
        </StackPanel>
        <StackPanel Key="LibraryPathEditor" IsVisible="{data addVisible}" Class="layout-VersionDirectoryDropdown-LibraryPathEditor version-base">
          <TextInput Key="LibraryDirectoryInput" Label="游戏目录的完整路径" Placeholder="完整文件夹路径" MaximumLength="2048" Class="layout-VersionDirectoryDropdown-LibraryDirectoryInput version-base version-input" />
          <Button Key="LibraryAddPath" Content="添加" Label="添加文件夹" Command="ui.versions.add-path" Class="layout-VersionDirectoryDropdown-LibraryAddPath version-base version-primary" />
        </StackPanel>
      </StackPanel>
    </StackPanel>
  </Node>
</nxml-component>
