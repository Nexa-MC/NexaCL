<nxml-dynamic><StackPanel Key="ServersWorkspace" Class="world-stack"><Text Content="正在读取服务器列表…" Class="world-hint" IsVisible="{data loading}" /><Text Content="{data error}" Class="world-hint" IsVisible="{data hasError}" Localize="false" /><StackPanel IsVisible="{data loaded}" Class="world-stack"><StackPanel Orientation="{data actionDirection}" Class="world-actions"><Text Content="{data count} 个服务器" Class="world-counter" Localize="false" /><Button Key="Management.添加服务器" Content="添加服务器" Command="ui.settings.management.action" Class="settings-catalog-action world-button-wide"  /></StackPanel><Dynamic Key="Servers.Editor" Class="world-stack" /><Dynamic Key="Servers.Rows" Class="world-rows" /></StackPanel></StackPanel></nxml-dynamic>
