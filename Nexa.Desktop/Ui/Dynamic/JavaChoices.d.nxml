<nxml-dynamic>
    <StackPanel Scroll="true" ScrollGesture="true" Class="java-choice-text layout-JavaChoicePage-2">
      <Text Content="选择使用的 Java 版本" Class="java-choice-text layout-JavaChoicePage-3" />
      <Text Content="优先使用本机已安装的版本，缺失时自动下载。" Class="java-choice-text layout-JavaChoicePage-4" />
      <Button Key="JavaChoice8" IsVisible="{data visible8}" Content="Java 8" Label="Java 8" Command="ui.java.major.8" Class="java-choice-text java-choice-button layout-JavaChoicePage-JavaChoice8" />
      <Button Key="JavaChoice16" IsVisible="{data visible16}" Content="Java 16" Label="Java 16" Command="ui.java.major.16" Class="java-choice-text java-choice-button layout-JavaChoicePage-JavaChoice16" />
      <Button Key="JavaChoice17" IsVisible="{data visible17}" Content="Java 17" Label="Java 17" Command="ui.java.major.17" Class="java-choice-text java-choice-button layout-JavaChoicePage-JavaChoice17" />
      <Button Key="JavaChoice21" IsVisible="{data visible21}" Content="Java 21" Label="Java 21" Command="ui.java.major.21" Class="java-choice-text java-choice-button layout-JavaChoicePage-JavaChoice21" />
      <Button Key="JavaChoice25" IsVisible="{data visible25}" Content="Java 25" Label="Java 25" Command="ui.java.major.25" Class="java-choice-text java-choice-button layout-JavaChoicePage-JavaChoice25" />
    </StackPanel>
</nxml-dynamic>
