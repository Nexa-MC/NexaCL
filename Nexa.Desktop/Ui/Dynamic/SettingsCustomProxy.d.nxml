<nxml-dynamic>
  <StackPanel Key="SettingsProxy" Class="settings-form-group">
    <Text Content="代理" Class="settings-form-label" />
    <StackPanel Class="settings-form-surface">
      <StackPanel Key="SettingsProxy.Body" Class="settings-form-body">
        <Text Content="应用后对新请求生效。" Class="settings-network-note" />
        <StackPanel Key="SettingsProxyToolbar" Class="settings-proxy-toolbar">
          <SettingsChoiceTrack Key="SettingsProxyMode" SegmentThumb="SettingsProxyModeThumb" Label="代理模式草稿" Class="settings-proxy-track">
            <ContentHost Key="SettingsProxyModeThumb" TransitionKey="SettingsProxyModeThumb" IsVisible="false" Class="settings-proxy-thumb" />
            <SettingsChoice Key="SettingsProxyMode.1" Selected="{data mode1}" Content="系统代理" Label="系统代理" Command="ui.settings.proxy.mode" Class="{data mode1Style}" />
            <SettingsChoice Key="SettingsProxyMode.0" Selected="{data mode0}" Content="无代理" Label="无代理" Command="ui.settings.proxy.mode" Class="{data mode0Style}" />
            <SettingsChoice Key="SettingsProxyMode.2" Selected="{data mode2}" Content="手动代理" Label="手动代理" Command="ui.settings.proxy.mode" Class="{data mode2Style}" />
          </SettingsChoiceTrack>
          <Button Key="SettingsProxyApply" Enabled="{data enabled}" Content="应用代理" Command="ui.settings.proxy.apply" Class="settings-proxy-action" />
          <Button Key="SettingsProxyReload" Enabled="{data enabled}" Content="重新读取" Command="ui.settings.proxy.reload" Class="settings-proxy-action" />
        </StackPanel>
        <StackPanel Key="SettingsProxyManual" IsVisible="{data manual}" Class="settings-proxy-manual">
          <SettingsChoiceTrack Key="SettingsProxyProtocol" SegmentThumb="SettingsProxyProtocolThumb" Label="代理协议" Class="settings-proxy-track">
            <ContentHost Key="SettingsProxyProtocolThumb" TransitionKey="SettingsProxyProtocolThumb" IsVisible="false" Class="settings-proxy-thumb" />
            <SettingsChoice Key="SettingsProxyProtocol.http" Selected="{data protocolhttp}" Content="HTTP" Label="HTTP" Command="ui.settings.proxy.protocol" Class="{data protocolhttpStyle}" />
            <SettingsChoice Key="SettingsProxyProtocol.https" Selected="{data protocolhttps}" Content="HTTPS" Label="HTTPS" Command="ui.settings.proxy.protocol" Class="{data protocolhttpsStyle}" />
            <SettingsChoice Key="SettingsProxyProtocol.socks4" Selected="{data protocolsocks4}" Content="SOCKS4" Label="SOCKS4" Command="ui.settings.proxy.protocol" Class="{data protocolsocks4Style}" />
            <SettingsChoice Key="SettingsProxyProtocol.socks5" Selected="{data protocolsocks5}" Content="SOCKS5" Label="SOCKS5" Command="ui.settings.proxy.protocol" Class="{data protocolsocks5Style}" />
            <SettingsChoice Key="SettingsProxyProtocol.pac" Selected="{data protocolpac}" Content="PAC" Label="PAC" Command="ui.settings.proxy.protocol" Class="{data protocolpacStyle}" />
          </SettingsChoiceTrack>
          <Dynamic Key="SettingsProxyHint" />
          <StackPanel Key="SettingsProxyRow.network.proxy-address" Class="settings-proxy-input-row">
            <Text Content="地址" Class="settings-proxy-input-label" />
            <TextInput Key="SettingsInput.network.proxy-address" Label="地址" Placeholder="http://localhost:8080" IsPassword="false" Class="settings-proxy-input" />
          </StackPanel>
          <StackPanel Key="SettingsProxyRow.network.proxy-user" Class="settings-proxy-input-row">
            <Text Content="用户名" Class="settings-proxy-input-label" />
            <TextInput Key="SettingsInput.network.proxy-user" MaximumLength="1024" Label="用户名" Placeholder="用户名" IsPassword="false" Class="settings-proxy-input" />
          </StackPanel>
          <StackPanel Key="SettingsProxyRow.network.proxy-password" IsVisible="{data password}" Class="settings-proxy-input-row">
            <Text Content="密码" Class="settings-proxy-input-label" />
            <TextInput Key="SettingsInput.network.proxy-password" MaximumLength="1024" Label="密码" Placeholder="密码" IsPassword="true" Class="settings-proxy-input" />
          </StackPanel>
        </StackPanel>
      </StackPanel>
    </StackPanel>
  </StackPanel>
</nxml-dynamic>
