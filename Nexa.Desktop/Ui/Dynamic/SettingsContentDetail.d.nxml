<nxml-dynamic>
<StackPanel Key="ContentDetail.Workspace" Class="settings-content-workspace"><StackPanel Key="ManagementDetailToolbar" Class="settings-content-toolbar"><Button Key="Management.返回列表" Content="返回列表" Label="返回列表" Command="ui.settings.management.action" Enabled="{data enabled}" Width="86" Class="settings-content-button" /><Node Recipe="StackLayout" Kind="Spacer" Weight="1" /><StackPanel IsVisible="{data canToggle}" Class="settings-content-pills"><Text Content="启用模组" Class="settings-content-toggle-label" /><Node Key="{data toggleTrack}" SegmentThumb="ContentDetail.ToggleThumb" Label="启用模组" Role="RadioGroup" Class="settings-content-binary-track" Recipe="StackLayout" Kind="SettingsContentRadioGroup"><ContentHost Key="ContentDetail.ToggleThumb" IsVisible="false" TransitionKey="ContentDetail.ToggleThumb" Class="settings-content-category-thumb" /><Node Recipe="CommandInput" Kind="ModToggle" Role="RadioButton" Key="{data toggleTrue}" Label="开启" Content="开启" Selected="{data active}" Enabled="{data enabled}" Command="ui.settings.management.action" Class="{data activeStyle}" /><Node Recipe="CommandInput" Kind="ModToggle" Role="RadioButton" Key="{data toggleFalse}" Label="关闭" Content="关闭" Selected="{data inactive}" Enabled="{data enabled}" Command="ui.settings.management.action" Class="{data inactiveStyle}" /></Node></StackPanel><Button Key="Management.移至已移除内容" Content="移至已移除内容" Label="移至已移除内容" Command="ui.settings.management.action" Enabled="{data enabled}" Width="116" Class="settings-content-button" /></StackPanel>
<StackPanel Key="ManagementContentDetail" Class="settings-content-detail"><StackPanel Class="settings-content-detail-body"><StackPanel Key="ContentDetailIdentity" Class="settings-content-identity"><Image Key="ContentDetail.Icon" Source="{data icon}" Class="settings-content-hero-icon" /><StackPanel Key="ContentDetailTitles" Class="settings-content-copy"><Text Key="ContentDetail.Title" Content="{data title}" Localize="false" Class="settings-content-hero-title" /><Text Content="{data subtitle}" Localize="false" Class="settings-content-subtitle" /></StackPanel></StackPanel><Text Key="ContentDetail.Description" Content="{data description}" Localize="false" IsVisible="{data hasDescription}" MaxLines="0" Class="settings-content-long" /><Dynamic Key="ContentDetail.World" /><Dynamic Key="ContentDetail.Facts" Class="settings-content-facts" /><Button Key="ContentDetail.Folder" Content="{data folderLabel}" Label="{data folderLabel}" Command="ui.settings.management.action" Enabled="{data enabled}" Width="128" Class="settings-content-button" IsVisible="{data hasDirectory}" /><Dynamic Key="ContentDetail.Online" /><Dynamic Key="ContentDetail.Integrity" /></StackPanel></StackPanel></StackPanel>
</nxml-dynamic>
