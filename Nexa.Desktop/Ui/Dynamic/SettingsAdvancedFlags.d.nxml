<nxml-dynamic>
<StackPanel Key="AdvancedWorkspace.Flags" Class="settings-diagnostics-card"><StackPanel Class="settings-advanced-body"><Text Content="已接入的内部能力" Class="settings-advanced-title" />
<StackPanel Class="settings-diagnostics-field"><Text Content="Java 诊断" Class="settings-advanced-label" /><Text Key="AdvancedWorkspace.Feature.java" Content="{data java}" Label="{data java}" Localize="false" MaxLines="1" TrimOverflow="true" Class="settings-advanced-fact" /></StackPanel><StackPanel Class="settings-diagnostics-field"><Text Content="XSR Trace" Class="settings-advanced-label" /><Text Key="AdvancedWorkspace.Feature.trace" Content="{data trace}" Label="{data trace}" Localize="false" MaxLines="1" TrimOverflow="true" Class="settings-advanced-fact" /></StackPanel><StackPanel Class="settings-diagnostics-field"><Text Content="受保护自动更新" Class="settings-advanced-label" /><Text Key="AdvancedWorkspace.Feature.updates" Content="{data updates}" Label="{data updates}" Localize="false" MaxLines="1" TrimOverflow="true" Class="settings-advanced-fact" /></StackPanel><StackPanel Class="settings-diagnostics-field"><Text Content="命令面板" Class="settings-advanced-label" /><Text Key="AdvancedWorkspace.Feature.palette" Content="{data palette}" Label="{data palette}" Localize="false" MaxLines="1" TrimOverflow="true" Class="settings-advanced-fact" /></StackPanel>
<Text Content="这些是当前组合根的只读能力事实，不增加隐藏的可变开关。" Class="settings-advanced-hint" />
</StackPanel></StackPanel>
</nxml-dynamic>
