<nxml-dynamic>
  <Button Scroll="true" ShowsHorizontalIndicator="true" UseVerticalWheelForHorizontalScroll="true" Key="{data key}" Class="desktop-bubble process-bubble capsule" IsVisible="false" Command="{data command}" Icon="lucide/power" Content="{data caption}" Localize="false" Label="{data caption}" />
</nxml-dynamic>
