<nxml-dynamic>
  <Node Kind="GamepadEntry" Recipe="Element" Role="Dialog" Key="GamepadEntry" Label="手柄模式" Clickable="true" DismissCommand="ui.gamepad.dismiss" Background="{data background}" Class="gamepad-scrim">
    <StackPanel Key="GamepadPrompt" IsVisible="{data prompt_visible}" Opacity="{data prompt_opacity}" Class="gamepad-prompt">
      <Image Key="GamepadDrawing" Source="gamepad/drawing" Label="左右摇杆同时向中心倾斜" Class="gamepad-drawing" />
      <Text Key="GamepadInstruction" Content="左右摇杆内推以进入手柄模式" Class="gamepad-instruction" />
      <Button Key="GamepadDismiss" Content="暂不进入" Command="ui.gamepad.dismiss" Class="gamepad-dismiss" />
    </StackPanel>
    <Node Kind="GamepadIntro" Recipe="Element" Key="GamepadIntro" IsVisible="{data intro_visible}" Class="gamepad-intro">
      <Image Key="GamepadLogo" Source="brand/n" Label="NexaCL" IsVisible="{data logo_visible}" Opacity="{data logo_opacity}" Width="{data logo_size}" Height="{data logo_size}" Margin="{data logo_margin}" Class="gamepad-logo" />
      <Image Key="GamepadFlash" Source="gamepad/flash" IsVisible="{data flash_visible}" Opacity="{data flash_opacity}" Width="{data flash_size}" Height="{data flash_size}" Margin="{data flash_margin}" Class="gamepad-flash" />
      <Text Key="GamepadName" Content="NexaCL" IsVisible="{data name_visible}" Opacity="{data name_opacity}" Margin="{data name_margin}" Class="gamepad-name" />
      <Text Key="GamepadCaption" Content="手柄模式" IsVisible="{data caption_visible}" Opacity="{data caption_opacity}" Margin="{data caption_margin}" Class="gamepad-caption" />
    </Node>
  </Node>
</nxml-dynamic>
