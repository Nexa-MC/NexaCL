<nxml-dynamic>
  <StackPanel Key="{data row}" Class="resource-base resource-card">
    <StackPanel Class="resource-card-body">
      <Image Key="ResourceVersionType" Label="{data channel}" Localize="false" Source="{data icon}" Class="{data typeClass}" />
      <StackPanel Key="ResourceVersionCopy" Class="resource-copy">
        <Text Content="{data name}" Localize="false" MaxLines="1" TrimOverflow="true" Class="resource-base resource-version-title" />
        <Text Content="{data metadata}" Localize="false" MaxLines="2" TrimOverflow="true" Class="resource-base resource-version-metadata" />
      </StackPanel>
      <Button Key="{data download}" Content="{data downloadCaption}" Localize="false" Icon="{data downloadIcon}" Command="ui.resources.action" Class="resource-base resource-button capsule resource-icon-button" Label="{data downloadCaption}" />
    </StackPanel>
  </StackPanel>
</nxml-dynamic>