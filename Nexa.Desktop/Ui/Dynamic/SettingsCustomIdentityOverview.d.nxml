<nxml-dynamic>
<StackPanel Key="InstanceIdentity.Ready" Class="settings-custom-column"><Button Key="{data refreshKey}" Content="刷新" Label="刷新" Command="ui.settings.management.action" Enabled="{data managementEnabled}" Class="settings-catalog-action settings-custom-action" /><StackPanel Class="settings-custom-fact"><Text Content="加载器" Class="settings-custom-fact-label" /><Text Content="{data loader}" Localize="false" Class="settings-custom-fact-value" /></StackPanel><StackPanel Class="settings-custom-fact"><Text Content="实例记录的 Java 偏好" Class="settings-custom-fact-label" /><Text Content="{data java}" Localize="false" Class="settings-custom-fact-value" /></StackPanel><StackPanel Class="settings-custom-fact"><Text Content="已记录启动次数" Class="settings-custom-fact-label" /><Text Content="{data launchCount}" Localize="false" Class="settings-custom-fact-value" /></StackPanel><Dynamic Key="InstanceIdentity.History" Class="settings-custom-column" /><Button Key="InstanceOverviewLaunch" Content="启动此实例" Label="启动此实例" Command="ui.settings.instance-identity.action" Enabled="{data enabled}" IsVisible="{data canLaunch}" Class="settings-catalog-action settings-custom-action" /><Button Key="InstanceOverviewModify" Content="修改版本与目录名" Label="修改版本与目录名" Command="ui.settings.instance-identity.action" Enabled="{data enabled}" IsVisible="{data canModify}" Class="settings-catalog-action settings-custom-action" /><StackPanel Class="settings-custom-fact"><Text Content="稳定身份" Class="settings-custom-fact-label" /><Text Content="{data stableIdentity}" Localize="false" Class="settings-custom-fact-value" /></StackPanel><StackPanel Class="settings-custom-field"><Text Content="显示名称" Class="settings-custom-label" /><TextInput Key="InstanceIdentityInput.name" Label="显示名称" MaximumLength="256" PreserveTabs="true" Enabled="true" Class="settings-custom-input" /></StackPanel><StackPanel Class="settings-custom-field"><Text Content="描述" Class="settings-custom-label" /><TextInput Key="InstanceIdentityInput.description" Label="描述" MaximumLength="8192" PreserveTabs="true" Enabled="true" Class="settings-custom-input" /></StackPanel><StackPanel Class="settings-custom-field"><Text Content="本地图标 PNG 完整路径" Class="settings-custom-label" /><TextInput Key="InstanceIdentityInput.icon" Label="本地图标 PNG 完整路径" MaximumLength="4096" PreserveTabs="true" Enabled="true" Class="settings-custom-input" /></StackPanel><Image Key="InstanceIdentityIconPreview" Label="实例图标" Source="lucide/image" IsVisible="{data icon}" Class="settings-custom-icon" /><Text Content="{data iconNotice}" Localize="false" IsVisible="{data hasIconNotice}" Class="settings-custom-caption" /><StackPanel Class="settings-custom-field"><Text Content="标签（逗号分隔）" Class="settings-custom-label" /><TextInput Key="InstanceIdentityInput.tags" Label="标签（逗号分隔）" MaximumLength="2048" PreserveTabs="true" Enabled="true" Class="settings-custom-input" /></StackPanel><StackPanel Class="settings-custom-field"><Text Content="分组" Class="settings-custom-label" /><TextInput Key="InstanceIdentityInput.group" Label="分组" MaximumLength="128" PreserveTabs="true" Enabled="true" Class="settings-custom-input" /></StackPanel><StackPanel Class="settings-custom-field"><Text Content="启动版本描述" Class="settings-custom-label" /><TextInput Key="InstanceIdentityInput.custom-info" Label="启动版本描述" MaximumLength="512" PreserveTabs="true" Enabled="true" Class="settings-custom-input" /></StackPanel><StackPanel Class="settings-custom-field"><Text Content="整合包项目 ID" Class="settings-custom-label" /><TextInput Key="InstanceIdentityInput.modpack-project" Label="整合包项目 ID" MaximumLength="256" PreserveTabs="true" Enabled="true" Class="settings-custom-input" /></StackPanel><StackPanel Class="settings-custom-field"><Text Content="整合包版本" Class="settings-custom-label" /><TextInput Key="InstanceIdentityInput.modpack-version" Label="整合包版本" MaximumLength="128" PreserveTabs="true" Enabled="true" Class="settings-custom-input" /></StackPanel><Button Key="InstanceIdentityIsolation" Content="{data isolationLabel}" Label="{data isolationLabel}" Command="ui.settings.instance-identity.action" Enabled="{data enabled}" Localize="false" Class="settings-catalog-action settings-custom-action" /><Button Key="InstanceIdentityStar" Content="{data starLabel}" Label="{data starLabel}" Command="ui.settings.instance-identity.action" Enabled="{data enabled}" Localize="false" Class="settings-catalog-action settings-custom-action" /><SettingsForm Key="InstanceNotes"><Text Content="备注" Class="settings-form-label" /><Dynamic Key="InstanceNotes.Rows" Class="settings-custom-column" /><Dynamic Key="InstanceNotes.Actions" /></SettingsForm><StackPanel Class="settings-custom-actions"><Button Key="InstanceIdentitySave" Content="保存更改" Label="保存更改" Command="ui.settings.instance-identity.action" Enabled="{data enabled}" Class="settings-catalog-action settings-custom-action" /><Button Key="InstanceIdentityReload" Content="重新读取" Label="重新读取" Command="ui.settings.instance-identity.action" Enabled="{data enabled}" Class="settings-catalog-action settings-custom-action" /></StackPanel></StackPanel>
</nxml-dynamic>
