<nxml-dynamic>
<StackPanel Class="settings-workspace-column"><Text Content="{data backups} 个备份 · {data objects} 个对象 · 实际 {data physical} 字节 · 逻辑 {data logical} 字节 · 可回收 {data reclaimableBytes} 字节" Localize="false" Class="settings-workspace-stats" /><Text Content="备份内容去重节省：{data savedBytes} 字节；不含清单及文件系统开销。" Localize="false" Class="settings-workspace-note" /><Text Content="存在未引用的备份对象，可预览清理后确认回收。" IsVisible="{data reclaimable}" Class="settings-workspace-note" /><Text Content="没有未引用的备份对象，无需回收。" IsVisible="{data clean}" Class="settings-workspace-note" /></StackPanel>
</nxml-dynamic>
