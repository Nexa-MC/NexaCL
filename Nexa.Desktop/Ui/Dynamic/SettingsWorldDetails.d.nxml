<nxml-dynamic>
  <StackPanel Key="WorldDetails" Class="world-stack" Weight="{data loadingWeight}" MinHeight="124">
    <StackPanel IsVisible="{data !reading}" Weight="1" Spacing="12">
      <Dynamic Key="WorldDetails.Health" Class="world-stack" />
      <Text Content="无法读取此世界的 level.dat，已保留文件。" Class="world-hint" IsVisible="{data unreadable}" />
      <StackPanel IsVisible="{data hasWorld}" Class="world-stack">
        <StackPanel Class="world-fact">
          <Text Content="世界名称" Class="world-label" />
          <Text Content="{data name}" Class="world-value" Localize="false" />
        </StackPanel>
        <StackPanel Class="world-fact" IsVisible="{data hasDataVersion}">
          <Text Content="数据版本" Class="world-label" />
          <Text Content="{data dataVersion}" Class="world-value" Localize="false" />
        </StackPanel>
        <StackPanel Class="world-fact" IsVisible="{data hasPlayed}">
          <Text Content="上次游玩" Class="world-label" />
          <Text Content="{data played}" Class="world-value" Localize="false" />
        </StackPanel>
        <StackPanel Class="world-fact" IsVisible="{data hasSeed}">
          <Text Content="世界种子" Class="world-label" />
          <Text Content="{data seed}" Class="world-value" Localize="false" />
        </StackPanel>
        <StackPanel Class="world-fact" IsVisible="{data hasMode}">
          <Text Content="游戏模式" Class="world-label" />
          <Text Content="{data mode}" Class="world-value" Localize="false" />
        </StackPanel>
        <StackPanel Class="world-fact" IsVisible="{data hasDifficulty}">
          <Text Content="难度" Class="world-label" />
          <Text Content="{data difficulty}" Class="world-value" Localize="false" />
        </StackPanel>
        <StackPanel Class="world-fact">
          <Text Content="极限模式" Class="world-label" />
          <Text Content="{data hardcore}" Class="world-value" Localize="false" />
        </StackPanel>
        <Text Content="世界大小超过本次扫描预算，未显示部分总量。" Class="world-hint" IsVisible="{data incomplete}" />
        <StackPanel Orientation="{data actionDirection}" Class="world-actions">
          <Button Key="Management.锁定编辑" Content="锁定编辑" Command="ui.settings.management.action" Class="settings-catalog-action world-button" IsVisible="{data unlocked}" />
          <Button Key="Management.解除编辑保护" Content="解除编辑保护" Command="ui.settings.management.action" Class="settings-catalog-action world-button-wide" IsVisible="{data locked}" />
          <Button Key="Management.备份世界" Content="备份世界" Command="ui.settings.management.action" Class="settings-catalog-action world-button" IsVisible="{data backup}" />
          <Button Key="Management.复制世界" Content="复制世界" Command="ui.settings.management.action" Class="settings-catalog-action world-button" IsVisible="{data unlocked}" />
          <Button Key="Management.导入数据包" Content="导入数据包" Command="ui.settings.management.action" Class="settings-catalog-action world-button-wide" IsVisible="{data import}" />
        </StackPanel>
        <Dynamic Key="WorldDetails.Snapshots" Class="world-stack" />
        <Text Content="世界数据包" Class="world-title" />
        <Text Content="此世界的数据版本不支持 Minecraft 数据包。" Class="world-hint" IsVisible="{data unsupported}" />
        <Text Content="此世界尚未安装数据包。" Class="world-hint" IsVisible="{data emptyPacks}" />
        <Dynamic Key="WorldDetails.Packs" Class="world-rows" />
      </StackPanel>
    </StackPanel>
    <LoadingView IsVisible="{data reading}">
      <Text Content="正在读取世界元数据…" Class="loading-hint" LiveSetting="Polite" />
    </LoadingView>
  </StackPanel>
</nxml-dynamic>
