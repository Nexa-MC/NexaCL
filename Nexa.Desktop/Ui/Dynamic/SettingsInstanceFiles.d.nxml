<nxml-dynamic>
  <StackPanel Key="FileWorkspace" Class="instance-tools-stack" Weight="{data loadingWeight}" MinHeight="124">
    <StackPanel IsVisible="{data !loading}" Spacing="12" Weight="1">
      <StackPanel Key="FileWorkspaceNavigation" Class="instance-tools-toolbar">
        <Button Key="FileWorkspace.Area.config" Content="配置文件" Command="ui.settings.management.action" Selected="{data config}" Class="{data configClass}" />
        <Button Key="FileWorkspace.Area.logs" Content="日志" Command="ui.settings.management.action" Selected="{data logs}" Class="{data logsClass}" />
        <Button Key="FileWorkspace.Area.crash-reports" Content="崩溃记录" Command="ui.settings.management.action" Selected="{data crash}" Class="{data crashClass}" />
        <Button Key="FileWorkspace.Area.other" Content="其它文件（只读）" Command="ui.settings.management.action" Selected="{data other}" Class="{data otherClass}" />
      </StackPanel>
      <Text Key="FileWorkspace.Error" IsVisible="{data hasError}" Content="{data error}" Localize="false" Class="instance-tools-hint" MaxLines="3" />
      <StackPanel IsVisible="{data showList}" Class="instance-tools-stack">
        <StackPanel Key="FileWorkspaceLocation" Class="instance-tools-toolbar">
          <Text Content="{data directory}" Label="{data directory}" Localize="false" MaxLines="1" TrimOverflow="true" Class="instance-tools-path" />
          <Button Key="FileWorkspace.OpenFolder" Content="打开文件夹" Command="ui.settings.management.action" Class="settings-catalog-action instance-tools-folder" />
          <Button Key="FileWorkspace.Up" Content="上级目录" IsVisible="{data hasParent}" Command="ui.settings.management.action" Class="settings-catalog-action instance-tools-area" />
        </StackPanel>
        <Text IsVisible="{data incomplete}" Content="部分条目超过预算或是链接，已省略。" Class="instance-tools-hint" />
        <Text IsVisible="{data empty}" Content="此目录中还没有文件。" Class="instance-tools-hint" />
        <Dynamic Key="FileWorkspace.Rows" Class="instance-tools-rows" />
        <StackPanel IsVisible="{data listPaging}" Class="instance-tools-toolbar">
          <Text Content="第 {data listPage} / {data listPages} 页" Localize="false" Class="instance-tools-counter" />
          <Button Key="FileWorkspace.NextFiles" Content="下一页" Command="ui.settings.management.action" Class="settings-catalog-action instance-tools-area" />
        </StackPanel>
      </StackPanel>
      <StackPanel IsVisible="{data hasDocument}" Class="instance-tools-stack">
        <StackPanel Key="FileWorkspaceDocumentHeader" Class="instance-tools-toolbar">
          <Dynamic Key="FileWorkspace.Caption" Class="instance-tools-caption-slot" />
          <Button Key="FileWorkspace.Back" Content="返回文件列表" Command="ui.settings.management.action" Class="settings-catalog-action instance-tools-back" />
        </StackPanel>
        <Text IsVisible="{data manyLines}" Content="此文件行数较多，显示前 65536 行；其余内容将原样保留。" Class="instance-tools-hint" />
        <Dynamic Key="FileWorkspace.Lines" Class="instance-tools-rows" />
        <StackPanel IsVisible="{data textPaging}" Class="instance-tools-toolbar">
          <Text Content="第 {data textPage} / {data textPages} 段" Localize="false" Class="instance-tools-counter" />
          <Button Key="FileWorkspace.NextText" Content="下一段" Command="ui.settings.management.action" Class="settings-catalog-action instance-tools-area" />
        </StackPanel>
        <StackPanel IsVisible="{data editable}" Class="instance-tools-stack">
          <StackPanel Class="instance-tools-toolbar">
            <Text Content="编辑行号" Class="instance-tools-input-label" />
            <TextInput Key="FileWorkspaceLineNumber" Label="编辑行号" MaximumLength="10" Class="instance-tools-line-number" />
            <Button Key="FileWorkspace.SelectLine" Content="选择此行" Command="ui.settings.management.action" Class="settings-catalog-action instance-tools-folder" />
          </StackPanel>
          <StackPanel IsVisible="{data shortLine}" Class="instance-tools-toolbar">
            <Text Content="行内容" Class="instance-tools-input-label" />
            <TextInput Key="FileWorkspaceLineEditor" Label="行内容" MaximumLength="32768" PreserveTabs="true" Class="instance-tools-editor" />
          </StackPanel>
          <Text IsVisible="{data longLine}" Content="此行过长，可从文件夹中使用外部编辑器。" Class="instance-tools-hint" />
          <StackPanel Class="instance-tools-toolbar">
            <Button Key="FileWorkspace.Preview" Content="预览保存" Enabled="{data canPreview}" Command="ui.settings.management.action" Class="settings-catalog-action instance-tools-folder" />
          </StackPanel>
          <Dynamic Key="FileWorkspace.PreviewResult" Class="instance-tools-stack" />
        </StackPanel>
      </StackPanel>
    </StackPanel>
    <LoadingView IsVisible="{data loading}">
      <Text Content="正在读取文件工作区…" Class="loading-hint" LiveSetting="Polite" />
    </LoadingView>
  </StackPanel>
</nxml-dynamic>
