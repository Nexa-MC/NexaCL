<nxml-dynamic><StackPanel Key="{data key}" Class="world-card"><StackPanel Class="world-card-body"><StackPanel Orientation="{data actionDirection}" Class="world-actions"><StackPanel Class="world-server-identity"><Text Key="{data nameKey}" Content="{data name}" Class="world-server-name" Localize="false" MaxLines="1" TrimOverflow="true" /><Text Key="{data addressKey}" Content="{data address}" Class="world-hint" Localize="false" MaxLines="1" TrimOverflow="true" /><Text Content="{data status}" Class="world-hint" Localize="false" /></StackPanel><Button Key="{data check}" Content="检查状态" Command="ui.settings.management.action" Class="settings-catalog-action world-button" Enabled="{data canCheck}" /><Button Key="{data join}" Content="加入" Command="ui.settings.management.action" Class="settings-catalog-action world-button-small" IsVisible="{data canJoin}" /></StackPanel><StackPanel Orientation="{data actionDirection}" Class="world-actions"><Button Key="{data edit}" Content="编辑" Command="ui.settings.management.action" Class="settings-catalog-action world-button-small"  /><Button Key="{data up}" Content="上移" Command="ui.settings.management.action" Class="settings-catalog-action world-button-small" IsVisible="{data canUp}" /><Button Key="{data down}" Content="下移" Command="ui.settings.management.action" Class="settings-catalog-action world-button-small" IsVisible="{data canDown}" /><Button Key="{data remove}" Content="移除" Command="ui.settings.management.action" Class="settings-catalog-action world-button-small"  /></StackPanel></StackPanel></StackPanel></nxml-dynamic>
