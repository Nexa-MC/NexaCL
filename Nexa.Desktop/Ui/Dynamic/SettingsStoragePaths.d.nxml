<nxml-dynamic>
  <StackPanel Class="settings-storage-rows">
    <StackPanel Key="SettingsStoragePath.Settings" Class="settings-storage-path-row">
      <Text Content="启动器设置" Class="settings-storage-path-label" />
      <Dynamic Key="SettingsStorageValue.Settings" Class="settings-storage-paths" />
    </StackPanel>
    <StackPanel Key="SettingsStoragePath.Logs" Class="settings-storage-path-row">
      <Text Content="运行日志" Class="settings-storage-path-label" />
      <Dynamic Key="SettingsStorageValue.Logs" Class="settings-storage-paths" />
    </StackPanel>
    <StackPanel Key="SettingsStoragePath.MinecraftLibrary" Class="settings-storage-path-row">
      <Text Content="游戏目录" Class="settings-storage-path-label" />
      <Dynamic Key="SettingsStorageValue.MinecraftLibrary" Class="settings-storage-paths" />
    </StackPanel>
    <StackPanel Key="SettingsStoragePath.ActiveMinecraft" Class="settings-storage-path-row">
      <Text Content="当前游戏目录" Class="settings-storage-path-label" />
      <Dynamic Key="SettingsStorageValue.ActiveMinecraft" Class="settings-storage-paths" />
    </StackPanel>
    <StackPanel Key="SettingsStoragePath.Instances" Class="settings-storage-path-row">
      <Text Content="版本目录" Class="settings-storage-path-label" />
      <Dynamic Key="SettingsStorageValue.Instances" Class="settings-storage-paths" />
    </StackPanel>
    <StackPanel Key="SettingsStoragePath.SelectedInstance" Class="settings-storage-path-row">
      <Text Content="当前版本目录" Class="settings-storage-path-label" />
      <Dynamic Key="SettingsStorageValue.SelectedInstance" Class="settings-storage-paths" />
    </StackPanel>
    <StackPanel Key="SettingsStoragePath.JavaRuntimes" Class="settings-storage-path-row">
      <Text Content="托管 Java 目录" Class="settings-storage-path-label" />
      <Dynamic Key="SettingsStorageValue.JavaRuntimes" Class="settings-storage-paths" />
    </StackPanel>
    <StackPanel Key="SettingsStoragePath.Cache" Class="settings-storage-path-row">
      <Text Content="下载缓存" Class="settings-storage-path-label" />
      <Dynamic Key="SettingsStorageValue.Cache" Class="settings-storage-paths" />
    </StackPanel>
  </StackPanel>
</nxml-dynamic>
