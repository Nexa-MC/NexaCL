<nxml-dynamic>
  <StackPanel Class="theme-actions">
    <SettingsChoice Key="{data trueKey}" Content="开启" Label="开启" Command="ui.settings.theme.action" Selected="{data true}" Enabled="{data enabled}" Class="theme-action-small" />
    <SettingsChoice Key="{data falseKey}" Content="关闭" Label="关闭" Command="ui.settings.theme.action" Selected="{data false}" Enabled="{data enabled}" Class="theme-action-small" />
  </StackPanel>
</nxml-dynamic>
