<nxml-dynamic>
  <StackPanel Key="ModpackUpdateWorkspace" Class="world-card">
    <StackPanel Class="world-card-body">
      <StackPanel IsVisible="{data online}" Class="world-stack">
        <Text Content="在线整合包" Class="world-title" />
        <Text Content="{data onlineInfo}" Localize="false" Class="world-hint" />
        <StackPanel Orientation="{data actionDirection}" Class="world-stack">
          <Button Key="ModpackUpdate.OnlineRefresh" Content="刷新在线信息" Command="ui.settings.management.action" Class="settings-catalog-action world-button-health" Enabled="{data onlineRefresh}" />
          <Button Key="ModpackUpdate.OnlineProject" Content="打开整合包主页" Command="ui.settings.management.action" Class="settings-catalog-action world-button-health" IsVisible="{data onlineProject}" />
        </StackPanel>
        <Dynamic Key="ModpackUpdate.OnlineVersions" Class="world-stack" />
      </StackPanel>
      <Text Content="更新整合包" Class="world-title" />
      <Text Content="选择新版 MRPack、CurseForge 或 Nexa 整合包。更新保留存档、截图、游戏选项和额外文件；修改过的配置会继续保留。" Class="world-hint" />
      <StackPanel Class="world-field">
        <Text Content="新版整合包" Class="world-field-label" />
        <TextInput Key="ModpackUpdate.Archive" Label="新版整合包路径" Placeholder="新版整合包的完整文件路径" Class="world-input" />
      </StackPanel>
      <Button Key="ModpackUpdate.Pick" Content="选择新版整合包" Command="ui.settings.management.action" Class="settings-catalog-action world-button-health" IsVisible="{data picker}" Enabled="{data enabled}" />
      <StackPanel Class="world-field">
        <Text Content="原整合包（旧安装未记录文件清单时选择）" Class="world-field-label" />
        <TextInput Key="ModpackUpdate.Original" Label="原整合包路径" Placeholder="已有文件清单时无需填写" Class="world-input" />
      </StackPanel>
      <Button Key="ModpackUpdate.PickOriginal" Content="选择原整合包" Command="ui.settings.management.action" Class="settings-catalog-action world-button-health" IsVisible="{data picker}" Enabled="{data enabled}" />
      <CheckBox Key="ModpackUpdate.Optional" Label="包含可选文件" Content="包含可选文件" Checked="{data optional}" Command="ui.settings.management.action" Class="world-category" Enabled="{data enabled}" />
      <CheckBox Key="ModpackUpdate.Replace" Label="替换已修改的模组，保留原文件备份" Content="替换已修改的模组（原文件会备份）" Checked="{data replace}" Command="ui.settings.management.action" Class="world-category" Enabled="{data enabled}" />
      <Text Content="{data status}" Localize="false" Class="world-hint" />
      <StackPanel Orientation="{data actionDirection}" Class="world-stack">
        <Button Key="ModpackUpdate.Preview" Content="预览更新" Command="ui.settings.management.action" Class="settings-catalog-action world-button-health" Enabled="{data enabled}" />
        <Button Key="ModpackUpdate.Apply" Content="确认更新" Command="ui.settings.management.action" Class="settings-catalog-action world-button-health" Enabled="{data canApply}" />
      </StackPanel>
    </StackPanel>
  </StackPanel>
</nxml-dynamic>
