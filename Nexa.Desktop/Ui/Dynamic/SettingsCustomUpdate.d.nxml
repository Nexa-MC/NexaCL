<nxml-dynamic>
<StackPanel Key="SettingsUpdateCard" Class="settings-custom-update"><StackPanel Key="SettingsUpdateCard.Body" Class="settings-custom-update-body"><StackPanel Key="SettingsUpdateHeader" Class="settings-custom-update-header"><Text Content="NexaCL Firefly v{data version}" Localize="false" Class="settings-custom-update-title" /><Button Key="SettingsCheckUpdate" Label="检查更新" Icon="pcl/refresh" Command="ui.settings.update.check" Enabled="{data canCheck}" Class="settings-custom-update-check" /></StackPanel><Text Key="SettingsUpdateStatus" Content="{data status}" Localize="false" Class="settings-custom-update-note" /><Text Content="正在下载并校验" IsVisible="{data downloading}" Class="settings-custom-update-note" /><Text Content="正在准备新版本" IsVisible="{data preparing}" Class="settings-custom-update-note" /><Text Content="正在切换版本" IsVisible="{data activating}" Class="settings-custom-update-note" /><Text Content="正在验证发布信息" IsVisible="{data verifying}" Class="settings-custom-update-note" /><Dynamic Key="SettingsUpdateActions" Class="settings-custom-update-actions" /></StackPanel></StackPanel>
</nxml-dynamic>
