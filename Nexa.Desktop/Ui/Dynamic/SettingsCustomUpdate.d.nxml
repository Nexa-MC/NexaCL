<nxml-dynamic>
  <StackPanel Key="SettingsUpdateCard" Class="settings-custom-update">
    <StackPanel Key="SettingsUpdateCard.Body" Class="settings-custom-update-body">
      <LoadingView IsVisible="{data busy}">
        <Text Content="{data status}" Class="loading-hint" LiveSetting="Polite" Localize="false" />
      </LoadingView>
      <StackPanel Key="SettingsUpdateHeader" Class="settings-custom-update-header" IsVisible="{data !busy}">
        <Text Content="NexaCL Firefly v{data version}" Localize="false" Class="settings-custom-update-title" />
        <Button Key="SettingsCheckUpdate" Label="检查更新" Icon="pcl/refresh" Command="ui.settings.update.check" Enabled="{data canCheck}" Class="settings-custom-update-check" />
      </StackPanel>
      <Text Key="SettingsUpdateStatus" Content="{data status}" Localize="false" Class="settings-custom-update-note" IsVisible="{data !busy}" />
      <Dynamic Key="SettingsUpdateActions" Class="settings-custom-update-actions" />
    </StackPanel>
  </StackPanel>
</nxml-dynamic>
