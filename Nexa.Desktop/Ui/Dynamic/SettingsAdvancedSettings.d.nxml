<nxml-dynamic>
<StackPanel Key="AdvancedWorkspace.Settings" Class="settings-diagnostics-card"><StackPanel Class="settings-advanced-body"><Text Content="只读脱敏设置快照" Class="settings-advanced-title" />


<StackPanel Class="settings-advanced-toolbar"><Button Key="AdvancedWorkspace.Settings.OpenFile" Content="打开 settings.json" Command="ui.settings.management.action" Class="settings-catalog-action settings-advanced-action" Enabled="{data open}" /><Button Key="AdvancedWorkspace.Settings.Read" Content="捕获设置快照" Command="ui.settings.management.action" Class="settings-catalog-action settings-advanced-action" Enabled="{data read}" /></StackPanel>
<Dynamic Key="AdvancedWorkspace.Settings.Rows" Class="settings-advanced-rows" />
<StackPanel Class="settings-advanced-toolbar"><Button Key="AdvancedWorkspace.Settings.Next" Content="下一页" Command="ui.settings.management.action" Class="settings-catalog-action settings-advanced-action" IsVisible="{data next}" /><Button Key="AdvancedWorkspace.Settings.Copy" Content="复制脱敏设置快照" Command="ui.settings.management.action" Class="settings-catalog-action settings-advanced-action" Enabled="{data copy}" IsVisible="{data captured}" /></StackPanel>
</StackPanel></StackPanel>
</nxml-dynamic>
