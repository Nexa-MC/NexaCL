<nxml-dynamic>
  <StackPanel Key="ExportWorkspace" Class="world-stack" Weight="{data loadingWeight}" MinHeight="124">
    <StackPanel IsVisible="{data !loading}" Weight="1" Spacing="12">
      <StackPanel Key="ExportMetadata" Class="world-card">
        <StackPanel Class="world-card-body">
          <Text Content="整合包信息" Class="world-title" />
          <StackPanel Class="world-fact">
            <Text Content="Minecraft" Class="world-label" />
            <Text Content="{data gameVersion}" Class="world-value" Localize="false" />
          </StackPanel>
          <StackPanel Class="world-fact">
            <Text Content="已记录版本" Class="world-label" />
            <Text Content="{data recordedVersion}" Class="world-value" Localize="false" />
          </StackPanel>
          <StackPanel Class="world-field">
            <Text Content="包名称" Class="world-field-label" />
            <TextInput Key="ExportName" Label="包名称" Class="world-input" />
          </StackPanel>
          <StackPanel Class="world-field">
            <Text Content="包版本" Class="world-field-label" />
            <TextInput Key="ExportVersion" Label="包版本" Class="world-input" />
          </StackPanel>
          <StackPanel Class="world-field">
            <Text Content="保存到" Class="world-field-label" />
            <TextInput Key="ExportPath" Label="保存到" Placeholder="完整 .mrpack 文件路径" Class="world-input" />
          </StackPanel>
          <Button Key="Management.选择保存目录" Content="选择保存目录" Command="ui.settings.management.action" Class="settings-catalog-action world-button-health" IsVisible="{data picker}" />
        </StackPanel>
      </StackPanel>
      <StackPanel IsVisible="{data preview}" Class="world-stack">
        <StackPanel Key="ExportCategories" Class="world-card">
          <StackPanel Class="world-card-body">
            <Text Content="包含的内容" Class="world-title" />
            <Dynamic Key="Export.Categories" Class="world-rows" />
          </StackPanel>
        </StackPanel>
        <Text Content="配置和模组默认包含。存档与游戏选项需自行选择；分享前请检查配置中的敏感信息和文件的分发许可。" Class="world-hint" />
        <Button Key="Management.导出整合包" Content="导出整合包" Command="ui.settings.management.action" Class="settings-catalog-action world-button-health" Enabled="{data enabled}" />
      </StackPanel>
      <Text Content="{data error}" Class="world-hint" IsVisible="{data hasError}" Localize="false" />
    </StackPanel>
    <LoadingView IsVisible="{data loading}">
      <Text Content="正在统计可导出的文件…" Class="loading-hint" LiveSetting="Polite" />
    </LoadingView>
  </StackPanel>
</nxml-dynamic>
