<nxml-dynamic><StackPanel Key="{data key}" Class="world-actions"><Text Content="{data name} · {data state}" Class="world-pack-name" Localize="false" /><Button Key="{data restore}" Content="还原数据包" Command="ui.settings.management.action" Class="settings-catalog-action world-button-wide" IsVisible="{data canRestore}" /><Button Key="{data enable}" Content="启用" Command="ui.settings.management.action" Class="settings-catalog-action world-button-small" IsVisible="{data canEnable}" /><Button Key="{data disable}" Content="停用" Command="ui.settings.management.action" Class="settings-catalog-action world-button-small" IsVisible="{data canDisable}" /><Button Key="{data remove}" Content="移至回收" Command="ui.settings.management.action" Class="settings-catalog-action world-button" IsVisible="{data canRemove}" /></StackPanel></nxml-dynamic>
