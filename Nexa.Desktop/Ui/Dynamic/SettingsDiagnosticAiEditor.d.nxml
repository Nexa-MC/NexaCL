<nxml-dynamic>
<StackPanel Class="settings-workspace-column">

<StackPanel Key="DiagnosticAi.endpointRow" Class="settings-workspace-field"><Text Content="服务 HTTPS 地址" Class="settings-workspace-field-label" /><TextInput Key="DiagnosticAi.endpoint" Label="服务 HTTPS 地址" Placeholder="服务 HTTPS 地址" MaximumLength="2048" IsPassword="false" Class="settings-workspace-input" /></StackPanel>
<StackPanel Key="DiagnosticAi.modelRow" Class="settings-workspace-field"><Text Content="模型" Class="settings-workspace-field-label" /><TextInput Key="DiagnosticAi.model" Label="模型" Placeholder="模型" MaximumLength="128" IsPassword="false" Class="settings-workspace-input" /></StackPanel>
<StackPanel Key="DiagnosticAi.keyRow" Class="settings-workspace-field"><Text Content="API 密钥" Class="settings-workspace-field-label" /><TextInput Key="DiagnosticAi.key" Label="API 密钥" Placeholder="API 密钥" MaximumLength="4096" IsPassword="true" Class="settings-workspace-input" /></StackPanel>
<StackPanel Key="DiagnosticAi.inputBudgetRow" Class="settings-workspace-field"><Text Content="输入字节预算" Class="settings-workspace-field-label" /><TextInput Key="DiagnosticAi.inputBudget" Label="输入字节预算" Placeholder="输入字节预算" MaximumLength="6" IsPassword="false" Class="settings-workspace-input" /></StackPanel>
<StackPanel Key="DiagnosticAi.outputBudgetRow" Class="settings-workspace-field"><Text Content="输出 Token 预算" Class="settings-workspace-field-label" /><TextInput Key="DiagnosticAi.outputBudget" Label="输出 Token 预算" Placeholder="输出 Token 预算" MaximumLength="4" IsPassword="false" Class="settings-workspace-input" /></StackPanel>
<StackPanel Key="DiagnosticAi.Actions" Class="settings-workspace-actions"><Button Key="ContentWorkspace.AiFacts" Label="预览结构化诊断" Content="预览结构化诊断" Command="ui.settings.storage.workspace" Enabled="{data enabled}" Class="settings-catalog-action settings-workspace-action" /><Button Key="ContentWorkspace.AiRaw" Label="预览脱敏文本" Content="预览脱敏文本" Command="ui.settings.storage.workspace" Enabled="{data enabled}" Class="settings-catalog-action settings-workspace-action" /><Button Key="ContentWorkspace.AiRepair" Label="预览存储修复" Content="预览存储修复" Command="ui.settings.storage.workspace" Enabled="{data enabled}" Class="settings-catalog-action settings-workspace-action" /></StackPanel>
</StackPanel>
</nxml-dynamic>
