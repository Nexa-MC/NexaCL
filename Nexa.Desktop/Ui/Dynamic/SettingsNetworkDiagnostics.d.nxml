<nxml-dynamic>
  <StackPanel Class="settings-network-groups">
    <SettingsForm Key="NetworkProbe">
      <Text Content="网络故障诊断" Class="settings-form-label" />
      <StackPanel Class="settings-form-surface">
        <StackPanel Class="settings-form-body">
        <Dynamic Key="NetworkProbe.Action" />
        <Dynamic Key="NetworkProbe.Rows" />
        </StackPanel>
      </StackPanel>
    </SettingsForm>
    <SettingsForm Key="NetworkObservedEndpoints">
      <Text Content="最近观察的服务状态" Class="settings-form-label" />
      <StackPanel Class="settings-form-surface">
        <StackPanel Class="settings-form-body">
        <Dynamic Key="NetworkObservedEndpoints.Rows" />
        </StackPanel>
      </StackPanel>
    </SettingsForm>
    <SettingsForm Key="NetworkMirrorResolution" IsVisible="{data mirrors}">
      <Text Content="来源解析" Class="settings-form-label" />
      <StackPanel Class="settings-form-surface">
        <StackPanel Class="settings-form-body">
        <Dynamic Key="NetworkMirrorResolution.Rows" />
        </StackPanel>
      </StackPanel>
    </SettingsForm>
    <SettingsForm Key="NetworkDownloadDiagnostics">
      <Text Content="下载诊断" Class="settings-form-label" />
      <StackPanel Class="settings-form-surface">
        <StackPanel Class="settings-form-body">
        <Dynamic Key="NetworkDownloadDiagnostics.Rows" />
        </StackPanel>
      </StackPanel>
    </SettingsForm>
    <SettingsForm Key="NetworkDiagnostics">
      <Text Content="网络诊断记录" Class="settings-form-label" />
      <StackPanel Class="settings-form-surface">
        <StackPanel Class="settings-form-body">
        <Button Key="NetworkDiagnostics.Refresh" Content="刷新记录" Command="ui.settings.network.trace.refresh" Class="settings-network-refresh" />
        <Dynamic Key="NetworkDiagnostics.Rows" />
        </StackPanel>
      </StackPanel>
    </SettingsForm>
  </StackPanel>
</nxml-dynamic>
