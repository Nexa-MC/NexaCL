<nxml-dynamic>
  <StackPanel Key="DiagnosticExportActions" Class="settings-about-actions">
    <Button Key="Management.导出诊断包" Label="导出诊断包" Content="导出诊断包" Command="ui.settings.management.action" Enabled="{data enabled}" Class="settings-catalog-action settings-diagnostic-export" />
    <Button Key="Management.取消诊断包导出" Label="取消导出" Content="取消导出" Command="ui.settings.management.action" IsVisible="false" Enabled="false" Class="settings-catalog-action settings-about-link" />
  </StackPanel>
</nxml-dynamic>
