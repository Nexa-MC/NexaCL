<nxml-dynamic>
<StackPanel Key="InstanceDiagnostics" Class="instance-diagnostics-stack">
<StackPanel Key="InstanceDiagnostics.Toolbar" Class="instance-diagnostics-toolbar">
<Button Key="InstanceDiagnostics.HistoryMode" Content="{data historyMode}" Localize="false" Command="ui.settings.management.action" Class="settings-catalog-action instance-diagnostics-mode" />
<Button Key="InstanceDiagnostics.Export" Content="导出诊断包" Command="ui.settings.management.action" IsVisible="{data canExport}" Class="settings-catalog-action instance-diagnostics-mode" />
<Node Class="instance-diagnostics-spacer" />
<Button Key="InstanceDiagnostics.Refresh" Label="刷新实例诊断" Command="ui.settings.management.action" Icon="pcl/refresh" Class="settings-diagnostics-refresh" />
</StackPanel>

<StackPanel Key="InstanceDiagnostics.Status" Class="settings-diagnostics-card"><StackPanel Class="instance-diagnostics-body"><Text Content="当前状态" Class="instance-diagnostics-title" />
<Text IsVisible="{data noSession}" Content="此实例尚无当前进程记录。" Class="instance-diagnostics-hint" />
<StackPanel Key="InstanceDiagnostics.Session" Class="instance-diagnostics-field" IsVisible="{data hasSession}"><Text Content="运行身份" Class="instance-diagnostics-label" /><Text Key="InstanceDiagnostics.Session.Value" Content="{data Session}" Label="{data Session}" Localize="false" MaxLines="1" TrimOverflow="true" Class="instance-diagnostics-value" /></StackPanel>
<StackPanel Key="InstanceDiagnostics.State" Class="instance-diagnostics-field" IsVisible="{data hasSession}"><Text Content="进程状态" Class="instance-diagnostics-label" /><Text Key="InstanceDiagnostics.State.Value" Content="{data State}" Label="{data State}" Localize="false" MaxLines="1" TrimOverflow="true" Class="instance-diagnostics-value" /></StackPanel>
<StackPanel Key="InstanceDiagnostics.Window" Class="instance-diagnostics-field" IsVisible="{data hasSession}"><Text Content="游戏窗口" Class="instance-diagnostics-label" /><Text Key="InstanceDiagnostics.Window.Value" Content="{data Window}" Label="{data Window}" Localize="false" MaxLines="1" TrimOverflow="true" Class="instance-diagnostics-value" /></StackPanel>
<StackPanel Key="InstanceDiagnostics.ExitCode" Class="instance-diagnostics-field" IsVisible="{data hasExit}"><Text Content="退出码" Class="instance-diagnostics-label" /><Text Key="InstanceDiagnostics.ExitCode.Value" Content="{data ExitCode}" Label="{data ExitCode}" Localize="false" MaxLines="1" TrimOverflow="true" Class="instance-diagnostics-value" /></StackPanel>
</StackPanel></StackPanel>
<StackPanel Key="InstanceDiagnostics.Launch" Class="settings-diagnostics-card"><StackPanel Class="instance-diagnostics-body"><Text Content="启动性能" Class="instance-diagnostics-title" />
<StackPanel Key="InstanceDiagnostics.StartedAt" Class="instance-diagnostics-field"><Text Content="进程创建时间" Class="instance-diagnostics-label" /><Text Key="InstanceDiagnostics.StartedAt.Value" Content="{data StartedAt}" Label="{data StartedAt}" Localize="false" MaxLines="1" TrimOverflow="true" Class="instance-diagnostics-value" /></StackPanel>
<StackPanel Key="InstanceDiagnostics.LaunchDuration" Class="instance-diagnostics-field"><Text Content="进程启动耗时" Class="instance-diagnostics-label" /><Text Key="InstanceDiagnostics.LaunchDuration.Value" Content="{data LaunchDuration}" Label="{data LaunchDuration}" Localize="false" MaxLines="1" TrimOverflow="true" Class="instance-diagnostics-value" /></StackPanel>
<StackPanel Key="InstanceDiagnostics.LaunchWindow" Class="instance-diagnostics-field"><Text Content="启动采样窗口" Class="instance-diagnostics-label" /><Text Key="InstanceDiagnostics.LaunchWindow.Value" Content="{data LaunchWindow}" Label="{data LaunchWindow}" Localize="false" MaxLines="1" TrimOverflow="true" Class="instance-diagnostics-value" /></StackPanel>

</StackPanel></StackPanel>
<StackPanel Key="InstanceDiagnostics.Resources" Class="settings-diagnostics-card"><StackPanel Class="instance-diagnostics-body"><Text Content="资源分析" Class="instance-diagnostics-title" />
<StackPanel Key="InstanceDiagnostics.Physical" Class="instance-diagnostics-field"><Text Content="进程工作集峰值" Class="instance-diagnostics-label" /><Text Key="InstanceDiagnostics.Physical.Value" Content="{data Physical}" Label="{data Physical}" Localize="false" MaxLines="1" TrimOverflow="true" Class="instance-diagnostics-value" /></StackPanel>
<StackPanel Key="InstanceDiagnostics.Private" Class="instance-diagnostics-field"><Text Content="进程私有内存峰值" Class="instance-diagnostics-label" /><Text Key="InstanceDiagnostics.Private.Value" Content="{data Private}" Label="{data Private}" Localize="false" MaxLines="1" TrimOverflow="true" Class="instance-diagnostics-value" /></StackPanel>
<StackPanel Key="InstanceDiagnostics.Heap" Class="instance-diagnostics-field"><Text Content="已测堆峰值" Class="instance-diagnostics-label" /><Text Key="InstanceDiagnostics.Heap.Value" Content="{data Heap}" Label="{data Heap}" Localize="false" MaxLines="1" TrimOverflow="true" Class="instance-diagnostics-value" /></StackPanel>
<StackPanel Key="InstanceDiagnostics.Native" Class="instance-diagnostics-field"><Text Content="已测 native 峰值" Class="instance-diagnostics-label" /><Text Key="InstanceDiagnostics.Native.Value" Content="{data Native}" Label="{data Native}" Localize="false" MaxLines="1" TrimOverflow="true" Class="instance-diagnostics-value" /></StackPanel>
<StackPanel Key="InstanceDiagnostics.Commit" Class="instance-diagnostics-field"><Text Content="已测提交量峰值" Class="instance-diagnostics-label" /><Text Key="InstanceDiagnostics.Commit.Value" Content="{data Commit}" Label="{data Commit}" Localize="false" MaxLines="1" TrimOverflow="true" Class="instance-diagnostics-value" /></StackPanel>
<StackPanel Key="InstanceDiagnostics.GpuLocal" Class="instance-diagnostics-field"><Text Content="已测 GPU 专用峰值" Class="instance-diagnostics-label" /><Text Key="InstanceDiagnostics.GpuLocal.Value" Content="{data GpuLocal}" Label="{data GpuLocal}" Localize="false" MaxLines="1" TrimOverflow="true" Class="instance-diagnostics-value" /></StackPanel>
<StackPanel Key="InstanceDiagnostics.GpuShared" Class="instance-diagnostics-field"><Text Content="已测 GPU 共享峰值" Class="instance-diagnostics-label" /><Text Key="InstanceDiagnostics.GpuShared.Value" Content="{data GpuShared}" Label="{data GpuShared}" Localize="false" MaxLines="1" TrimOverflow="true" Class="instance-diagnostics-value" /></StackPanel>
<StackPanel Key="InstanceDiagnostics.TreePhysical" Class="instance-diagnostics-field"><Text Content="进程树工作集峰值" Class="instance-diagnostics-label" /><Text Key="InstanceDiagnostics.TreePhysical.Value" Content="{data TreePhysical}" Label="{data TreePhysical}" Localize="false" MaxLines="1" TrimOverflow="true" Class="instance-diagnostics-value" /></StackPanel>
<StackPanel Key="InstanceDiagnostics.PhysicalP95" Class="instance-diagnostics-field"><Text Content="工作集 P95" Class="instance-diagnostics-label" /><Text Key="InstanceDiagnostics.PhysicalP95.Value" Content="{data PhysicalP95}" Label="{data PhysicalP95}" Localize="false" MaxLines="1" TrimOverflow="true" Class="instance-diagnostics-value" /></StackPanel>
<StackPanel Key="InstanceDiagnostics.CpuPeak" Class="instance-diagnostics-field"><Text Content="已测 CPU 峰值" Class="instance-diagnostics-label" /><Text Key="InstanceDiagnostics.CpuPeak.Value" Content="{data CpuPeak}" Label="{data CpuPeak}" Localize="false" MaxLines="1" TrimOverflow="true" Class="instance-diagnostics-value" /></StackPanel>
<StackPanel Key="InstanceDiagnostics.SampleCount" Class="instance-diagnostics-field" IsVisible="{data hasSamples}"><Text Content="窗口采样次数" Class="instance-diagnostics-label" /><Text Key="InstanceDiagnostics.SampleCount.Value" Content="{data SampleCount}" Label="{data SampleCount}" Localize="false" MaxLines="1" TrimOverflow="true" Class="instance-diagnostics-value" /></StackPanel>
<StackPanel Key="InstanceDiagnostics.SampleWindow" Class="instance-diagnostics-field" IsVisible="{data hasSamples}"><Text Content="窗口长度" Class="instance-diagnostics-label" /><Text Key="InstanceDiagnostics.SampleWindow.Value" Content="{data SampleWindow}" Label="{data SampleWindow}" Localize="false" MaxLines="1" TrimOverflow="true" Class="instance-diagnostics-value" /></StackPanel>
<StackPanel Key="InstanceDiagnostics.WorkingMean" Class="instance-diagnostics-field" IsVisible="{data hasSamples}"><Text Content="窗口工作集均值" Class="instance-diagnostics-label" /><Text Key="InstanceDiagnostics.WorkingMean.Value" Content="{data WorkingMean}" Label="{data WorkingMean}" Localize="false" MaxLines="1" TrimOverflow="true" Class="instance-diagnostics-value" /></StackPanel>
<StackPanel Key="InstanceDiagnostics.CpuMean" Class="instance-diagnostics-field" IsVisible="{data hasSamples}"><Text Content="窗口 CPU 均值" Class="instance-diagnostics-label" /><Text Key="InstanceDiagnostics.CpuMean.Value" Content="{data CpuMean}" Label="{data CpuMean}" Localize="false" MaxLines="1" TrimOverflow="true" Class="instance-diagnostics-value" /></StackPanel>
<Text IsVisible="{data noSamples}" Content="此实例尚无可用的运行采样窗口。" Class="instance-diagnostics-hint" />
</StackPanel></StackPanel>
<StackPanel Key="InstanceDiagnostics.System" Class="settings-diagnostics-card"><StackPanel Class="instance-diagnostics-body"><Text Content="系统事件关联" Class="instance-diagnostics-title" />
<Text IsVisible="{data noSystem}" Content="此运行的系统事件采集不可用。" Class="instance-diagnostics-hint" />
<Text IsVisible="{data hasSystem}" Content="仅列出该进程运行时段的实际事件，时间相关不能证明崩溃原因。" Class="instance-diagnostics-hint" />
<Text IsVisible="{data emptySystem}" Content="采集已完成，此时段没有匹配事件。" Class="instance-diagnostics-hint" />
<Dynamic Key="InstanceDiagnostics.System.Rows" Class="instance-diagnostics-rows" />
</StackPanel></StackPanel>
</StackPanel>
</nxml-dynamic>
