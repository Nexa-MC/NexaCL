<nxml-dynamic>
  <StackPanel Key="LaunchHomeWorkspace" Class="layout-LaunchPage-2">
    <StackPanel Key="CardAccount" Class="layout-LaunchPage-CardAccount">
      <StackPanel Key="AccountContent" Class="layout-LaunchPage-AccountContent">
        <StackPanel Key="AccountHeaderRow" Class="layout-LaunchPage-AccountHeaderRow">
          <Button Key="AccountBack" Label="返回账户" Icon="lucide/arrow-left" Command="ui.account.back" IsVisible="{state launch.account.back-visible}" Class="layout-LaunchPage-AccountBack" />
          <Text Key="AccountHeader" Localize="false" Content="{state launch.account.title}" TransitionKey="{state launch.account.title}" Class="layout-LaunchPage-AccountHeader" />
          <Button Key="AccountAdd" Label="添加账户" Content="添加" Icon="lucide/plus" Command="ui.account.add" IsVisible="{state launch.account.add-visible}" Class="layout-LaunchPage-AccountAdd" />
        </StackPanel>
        <StackPanel Key="AccountBody" TransitionKey="{state launch.account.transition}" Class="layout-LaunchPage-AccountBody">
          <Dynamic Key="AccountFormSlot" IsVisible="{state account.form.open}" Class="account-form-slot" />
          <StackPanel Key="AccountSelected" IsVisible="{state launch.account.selected-visible}" Class="layout-LaunchPage-AccountSelected">
            <StackPanel Key="AccountIdentity" Class="layout-LaunchPage-AccountIdentity">
              <StackPanel Key="AccountAvatarSurface" Class="layout-LaunchPage-AccountAvatarSurface">
                <Image Key="AccountAvatar" Label="账户头像" Source="{data avatar}" Class="layout-LaunchPage-AccountAvatar" />
              </StackPanel>
              <Text Key="AccountName" Localize="false" Content="{state launch.profile.name}" Class="layout-LaunchPage-AccountName" />
              <Text Key="AccountKind" Localize="false" Content="{state launch.profile.kind}" Class="layout-LaunchPage-AccountKind" />
              <StackPanel Key="AccountActions" Class="layout-LaunchPage-AccountActions">
                <Button Key="AccountSwitch" Label="切换档案" Content="切换档案" Icon="lucide/arrow-right-left" Command="ui.account.switch" Class="layout-LaunchPage-AccountSwitch" />
                <Button Key="AccountWardrobe" Label="更衣橱" Content="更衣橱" Icon="lucide/shirt" Command="ui.account.wardrobe" Class="layout-LaunchPage-AccountWardrobe" />
              </StackPanel>
            </StackPanel>
          </StackPanel>
          <StackPanel Key="AccountPicker" IsVisible="{state launch.account.roster-visible}" Class="layout-LaunchPage-AccountPicker">
            <Text Key="AccountHint" Localize="false" Content="{state launch.account.hint}" IsVisible="{state launch.account.hint-visible}" Class="layout-LaunchPage-AccountHint" />
            <Dynamic Scroll="true" ScrollGesture="true" Key="AccountRows" Class="layout-LaunchPage-AccountRows" />
            <Button Key="AccountImport" Label="导入旧档案" Content="导入旧档案" Command="ui.account.import" Class="layout-LaunchPage-AccountImport" />
          </StackPanel>
        </StackPanel>
      </StackPanel>
    </StackPanel>
    <StackPanel Key="RightColumn" Class="layout-LaunchPage-RightColumn">
      <StackPanel Key="CardVersion" Class="layout-LaunchPage-CardVersion">
        <StackPanel Key="VersionContent" Class="layout-LaunchPage-VersionContent">
          <StackPanel StretchLastChild="true" Key="VersionHeaderRow" Class="layout-LaunchPage-VersionHeaderRow">
            <Text Key="VersionHeader" Content="版本" Class="layout-LaunchPage-VersionHeader" />
            <Button Key="InstanceListButton" Label="选择版本" Content="选择版本" Command="ui.launch.instances" Icon="lucide/menu" Class="layout-LaunchPage-InstanceListButton" />
          </StackPanel>
          <StackPanel Key="InstanceRow" Class="layout-LaunchPage-InstanceRow">
            <StackPanel Key="InstanceRowContent" Class="layout-LaunchPage-InstanceRowContent">
              <Text Key="VersionName" Localize="false" Content="{state launch.instance.summary}" Class="layout-LaunchPage-VersionName" />
              <StackPanel Key="VersionActions" Class="layout-LaunchPage-VersionActions">
                <Button Key="InstanceModify" Label="修改" Content="修改" Command="ui.launch.modify" Icon="lucide/wrench" Clickable="{state launch.instance.available}" Class="layout-LaunchPage-InstanceModify" />
                <Button Key="InstanceSettings" Label="设置" Content="设置" Command="ui.launch.settings" Icon="lucide/settings" Clickable="{state launch.instance.available}" Class="layout-LaunchPage-InstanceSettings" />
              </StackPanel>
            </StackPanel>
          </StackPanel>
          <Button Key="LaunchButton" Localize="false" Label="{state launch.action.label}" Command="ui.launch.primary" Clickable="{state launch.action.enabled}" Class="layout-LaunchPage-LaunchButton">
            <ProgressRing Key="LaunchButtonProgress" Value="{state minecraft.launch.progress}" IsVisible="{state launch.action.busy}" Indeterminate="true" Width="24" Height="24" HorizontalAlignment="End" VerticalAlignment="Center" Label="任务进度" Margin="0,0,16,0" Foreground="#ffffff" />
            <Text Key="LaunchButtonText" Localize="false" Content="{state launch.action.label}" Class="layout-LaunchPage-LaunchButtonText" />
          </Button>
        </StackPanel>
      </StackPanel>
      <StackPanel Key="CardAbout" Class="layout-LaunchPage-CardAbout">
        <StackPanel Key="AboutContent" Class="layout-LaunchPage-AboutContent">
          <StackPanel Class="layout-LaunchPage-40">
            <VerticalPager Key="LaunchWidgetPager" Label="启动页信息卡片，可使用上下方向键翻页" Class="layout-LaunchPage-LaunchWidgetPager">
              <StackPanel Key="AboutCopy" Class="layout-LaunchPage-AboutCopy">
                <Text Key="AboutTitle" Content="关于 Nexa" Class="layout-LaunchPage-AboutTitle" />
                <Text Key="AboutMessage" Content="让每一次出发都更简单。Nexa 是由社区独立维护的跨平台 Minecraft 启动器。" Class="layout-LaunchPage-AboutMessage" />
              </StackPanel>
              <Button Key="TriviaPage" Label="你知道吗？点击换一条" Command="ui.launch.hint.refresh">
                <StackPanel Class="layout-LaunchPage-46">
                  <Text Key="TriviaTitle" Content="你知道吗？" Class="layout-LaunchPage-TriviaTitle" />
                  <Text Key="TriviaMessage" Content="{state launch.widget.hint}" TransitionKey="{state launch.widget.hint}" Class="layout-LaunchPage-TriviaMessage" />
                </StackPanel>
              </Button>
              <StackPanel Key="EchoPage" Class="layout-LaunchPage-EchoPage">
                <Text Key="EchoTitle" Content="回声洞" Class="layout-LaunchPage-EchoTitle" />
                <Text Key="EchoMessage" Content="请等待本功能上线，到时你可以前往官网上投稿~" Class="layout-LaunchPage-EchoMessage" />
              </StackPanel>
            </VerticalPager>
          </StackPanel>
          <StackPanel Key="WidgetIndicators" Class="layout-LaunchPage-WidgetIndicators">
            <Dynamic Key="WidgetAboutSlot" />
            <Dynamic Key="WidgetTriviaSlot" />
            <Dynamic Key="WidgetEchoSlot" />
          </StackPanel>
        </StackPanel>
      </StackPanel>
    </StackPanel>
  </StackPanel>
</nxml-dynamic>
