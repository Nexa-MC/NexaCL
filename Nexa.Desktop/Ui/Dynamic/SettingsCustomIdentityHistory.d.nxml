<nxml-dynamic>
<StackPanel Class="settings-custom-column"><StackPanel Class="settings-custom-fact" ><Text Content="最近启动（本次启动器）" Class="settings-custom-fact-label" /><Text Content="{data latest}" Localize="false" Class="settings-custom-fact-value" /></StackPanel><StackPanel Class="settings-custom-fact" ><Text Content="已观察进程用时（截至当前快照）" Class="settings-custom-fact-label" /><Text Content="{data minutes} 分钟" Localize="false" Class="settings-custom-fact-value" /></StackPanel><Text Content="统计限于本次启动器最近 256 条进程记录，{data count} 条属于此实例；先前历史未记录。" Localize="false" Class="settings-custom-note" /><StackPanel Class="settings-custom-fact" ><Text Content="实例健康（本地依赖）" Class="settings-custom-fact-label" /><Text Content="{data health}" Localize="false" Class="settings-custom-fact-value" /></StackPanel><StackPanel Class="settings-custom-fact" IsVisible="{data hasMemory}"><Text Content="有效启动内存" Class="settings-custom-fact-label" /><Text Content="{data memory}" Localize="false" Class="settings-custom-fact-value" /></StackPanel></StackPanel>
</nxml-dynamic>
