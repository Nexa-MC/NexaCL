<nxml-dynamic>
    <StackPanel Key="TaskCenterRoot" Class="layout-TaskCenterPage-TaskCenterRoot">
      <StackPanel Key="TaskCenterHeader" Class="layout-TaskCenterPage-TaskCenterHeader">
        <Image Key="TaskCenterHeaderIcon" Source="lucide/list-checks" IsVisible="false" Class="layout-TaskCenterPage-TaskCenterHeaderIcon" />
        <Text Key="TaskCenterTitle" Content="任务中心" Class="layout-TaskCenterPage-TaskCenterTitle" />
        <Button Key="TaskCenterClear" IsVisible="{data has-finished}" Content="清除已完成" Label="清除已完成的任务" Command="ui.tasks.clear-finished" Class="layout-TaskCenterPage-TaskCenterClear" />
      </StackPanel>
      <Text Key="TaskCenterSummary" Localize="false" Content="{data summary}" Class="layout-TaskCenterPage-TaskCenterSummary" />
      <ContentHost Key="TaskCenterBody" Class="layout-TaskCenterPage-TaskCenterBody">
        <StackPanel Key="TaskCenterEmpty" IsVisible="{data empty}" Class="layout-TaskCenterPage-TaskCenterEmpty">
          <Image Key="TaskCenterEmptyIcon" Source="lucide/inbox" Class="layout-TaskCenterPage-TaskCenterEmptyIcon" />
          <Text Key="TaskCenterEmptyTitle" Content="暂无任务" Class="layout-TaskCenterPage-TaskCenterEmptyTitle" />
          <Text Key="TaskCenterEmptyHint" Content="安装和下载进度会显示在这里。" Class="layout-TaskCenterPage-TaskCenterEmptyHint" />
        </StackPanel>
        <Dynamic Key="TaskCenterList" IsVisible="{data has-tasks}" Scroll="true" ScrollGesture="true" Class="layout-TaskCenterPage-TaskCenterList" />
      </ContentHost>
    </StackPanel>
</nxml-dynamic>
