<nxml-dynamic>
<StackPanel Class="settings-content-workspace"><StackPanel Class="settings-content-toolbar"><Node Recipe="StackLayout" Kind="Spacer" Weight="1" /><Button Key="Management.刷新" Height="36" Label="刷新" Command="ui.settings.management.action" Enabled="{data enabled}" Width="36" Class="settings-content-button" Icon="pcl/refresh"/></StackPanel><Text Content="{data message}" Localize="false" Class="settings-content-message" /></StackPanel>
</nxml-dynamic>
