<nxml-dynamic><StackPanel Key="ManagementModCategories" Class="settings-content-toolbar"><Node Key="ManagementModCategoryTrack" Label="筛选模组" Role="RadioGroup" SegmentThumb="ManagementModCategoryThumb" Scroll="true" ScrollGesture="true" Class="settings-content-category-track" Recipe="StackLayout" Kind="SettingsContentRadioGroup"><ContentHost Key="ManagementModCategoryThumb" TransitionKey="ManagementModCategoryThumb" IsVisible="false" Class="settings-content-category-thumb" /><Node Recipe="CommandInput" Kind="ContentCategory" Role="RadioButton" Key="ManagementModCategory.all" Content="全部" Label="全部" Command="ui.settings.management.action" Selected="{data allSelected}" Class="{data allStyle}" /><Node Recipe="CommandInput" Kind="ContentCategory" Role="RadioButton" Key="ManagementModCategory.enabled" Content="已启用" Label="已启用" Command="ui.settings.management.action" Selected="{data enabledSelected}" Class="{data enabledStyle}" /><Node Recipe="CommandInput" Kind="ContentCategory" Role="RadioButton" Key="ManagementModCategory.disabled" Content="已禁用" Label="已禁用" Command="ui.settings.management.action" Selected="{data disabledSelected}" Class="{data disabledStyle}" /><Node Recipe="CommandInput" Kind="ContentCategory" Role="RadioButton" Key="ManagementModCategory.updates" Content="可更新" Label="可更新" Command="ui.settings.management.action" Selected="{data updatesSelected}" Class="{data updatesStyle}" /><Node Recipe="CommandInput" Kind="ContentCategory" Role="RadioButton" Key="ManagementModCategory.problems" Content="包异常" Label="包异常" Command="ui.settings.management.action" Selected="{data problemsSelected}" Class="{data problemsStyle}" /><Node Recipe="CommandInput" Kind="ContentCategory" Role="RadioButton" Key="ManagementModCategory.unchecked" Content="未检测" Label="未检测" Command="ui.settings.management.action" Selected="{data uncheckedSelected}" Class="{data uncheckedStyle}" /></Node></StackPanel></nxml-dynamic>
