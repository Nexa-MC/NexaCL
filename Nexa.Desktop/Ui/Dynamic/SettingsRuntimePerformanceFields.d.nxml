<nxml-dynamic>
<StackPanel Class="settings-diagnostics-fields">
<StackPanel Key="SettingsRuntime.Performance.PixelCharge" Class="settings-diagnostics-field"><Text Content="解码图像像素计费字节" Class="settings-runtime-label" /><Text Key="SettingsRuntime.Performance.PixelCharge.Value" Content="{data PixelCharge}" Label="{data PixelCharge}" Localize="false" MaxLines="1" TrimOverflow="true" Class="settings-diagnostics-value" /></StackPanel>
<StackPanel Key="SettingsRuntime.Performance.AdmissionBudget" Class="settings-diagnostics-field"><Text Content="图像准入预算字节" Class="settings-runtime-label" /><Text Key="SettingsRuntime.Performance.AdmissionBudget.Value" Content="{data AdmissionBudget}" Label="{data AdmissionBudget}" Localize="false" MaxLines="1" TrimOverflow="true" Class="settings-diagnostics-value" /></StackPanel>
<StackPanel Key="SettingsRuntime.Performance.RasterEntries" Class="settings-diagnostics-field"><Text Content="保留图像数量" Class="settings-runtime-label" /><Text Key="SettingsRuntime.Performance.RasterEntries.Value" Content="{data RasterEntries}" Label="{data RasterEntries}" Localize="false" MaxLines="1" TrimOverflow="true" Class="settings-diagnostics-value" /></StackPanel>
<StackPanel Key="SettingsRuntime.Performance.RasterLeases" Class="settings-diagnostics-field"><Text Content="活动图像租约数量" Class="settings-runtime-label" /><Text Key="SettingsRuntime.Performance.RasterLeases.Value" Content="{data RasterLeases}" Label="{data RasterLeases}" Localize="false" MaxLines="1" TrimOverflow="true" Class="settings-diagnostics-value" /></StackPanel>
<StackPanel Key="SettingsRuntime.Performance.DecodeAttempts" Class="settings-diagnostics-field"><Text Content="图像解码尝试次数" Class="settings-runtime-label" /><Text Key="SettingsRuntime.Performance.DecodeAttempts.Value" Content="{data DecodeAttempts}" Label="{data DecodeAttempts}" Localize="false" MaxLines="1" TrimOverflow="true" Class="settings-diagnostics-value" /></StackPanel>
<StackPanel Key="SettingsRuntime.Performance.DisposedBitmaps" Class="settings-diagnostics-field"><Text Content="已释放位图数量" Class="settings-runtime-label" /><Text Key="SettingsRuntime.Performance.DisposedBitmaps.Value" Content="{data DisposedBitmaps}" Label="{data DisposedBitmaps}" Localize="false" MaxLines="1" TrimOverflow="true" Class="settings-diagnostics-value" /></StackPanel>
<StackPanel Key="SettingsRuntime.Performance.MemoryAvailable" Class="settings-diagnostics-field"><Text Content="系统可用内存字节" Class="settings-runtime-label" /><Text Key="SettingsRuntime.Performance.MemoryAvailable.Value" Content="{data MemoryAvailable}" Label="{data MemoryAvailable}" Localize="false" MaxLines="1" TrimOverflow="true" Class="settings-diagnostics-value" /></StackPanel>
<StackPanel Key="SettingsRuntime.Performance.MemoryLimit" Class="settings-diagnostics-field"><Text Content="系统内存上限字节" Class="settings-runtime-label" /><Text Key="SettingsRuntime.Performance.MemoryLimit.Value" Content="{data MemoryLimit}" Label="{data MemoryLimit}" Localize="false" MaxLines="1" TrimOverflow="true" Class="settings-diagnostics-value" /></StackPanel>
<StackPanel Key="SettingsRuntime.Performance.GpuResident" Class="settings-diagnostics-field"><Text Content="已测量 GPU 驻留字节" Class="settings-runtime-label" /><Text Key="SettingsRuntime.Performance.GpuResident.Value" Content="{data GpuResident}" Label="{data GpuResident}" Localize="false" MaxLines="1" TrimOverflow="true" Class="settings-diagnostics-value" /></StackPanel>
<StackPanel Key="SettingsRuntime.Performance.MemorySource" Class="settings-diagnostics-field"><Text Content="内存采样来源" Class="settings-runtime-label" /><Text Key="SettingsRuntime.Performance.MemorySource.Value" Content="{data MemorySource}" Label="{data MemorySource}" Localize="false" MaxLines="1" TrimOverflow="true" Class="settings-diagnostics-value" /></StackPanel>
<StackPanel Key="SettingsRuntime.Performance.PresentationRate" Class="settings-diagnostics-field"><Text Content="物理呈现帧率" Class="settings-runtime-label" /><Text Key="SettingsRuntime.Performance.PresentationRate.Value" Content="{data PresentationRate}" Label="{data PresentationRate}" Localize="false" MaxLines="1" TrimOverflow="true" Class="settings-diagnostics-value" /></StackPanel>
</StackPanel>
</nxml-dynamic>
