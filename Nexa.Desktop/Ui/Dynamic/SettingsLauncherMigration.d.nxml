<nxml-dynamic>
<SettingsForm Key="LauncherMigrationWorkspace">
  <Text Content="从其他启动器迁移" Class="settings-form-label" />
  <StackPanel Class="settings-form-surface"><StackPanel Class="settings-launcher-migration-body">
    <Text Content="复制所选实例到新的独立目录；保留原启动器的数据，不覆盖现有目录。支持 Nexa/PCL、Prism/MultiMC、Modrinth、CurseForge、HMCL、XMCL、ATLauncher 和标准 Minecraft 目录。" Class="settings-launcher-migration-note" />
    <StackPanel Class="settings-launcher-migration-field"><Text Content="来源类型" Class="settings-launcher-migration-label" /><Text Key="LauncherMigration.SourceKind" Content="{data sourceKind}" Localize="false" Class="settings-launcher-migration-value" /><Button Key="LauncherMigration.kind" Label="切换来源类型" Content="切换来源" Command="ui.settings.launcher-migration.action" Enabled="{data enabled}" Class="settings-catalog-action settings-launcher-migration-action" /></StackPanel>
    <StackPanel Class="settings-launcher-migration-field"><Text Content="来源目录" Class="settings-launcher-migration-label" /><Text Key="LauncherMigration.Source" Content="{data source}" Localize="false" Class="settings-launcher-migration-value" /><Button Key="LauncherMigration.source" Label="选择其他启动器的数据目录" Content="选择来源" Command="ui.settings.launcher-migration.action" Enabled="{data enabled}" Class="settings-catalog-action settings-launcher-migration-action" /></StackPanel>
    <StackPanel Class="settings-launcher-migration-field"><Text Content="迁入目录" Class="settings-launcher-migration-label" /><Text Key="LauncherMigration.Destination" Content="{data destination}" Localize="false" Class="settings-launcher-migration-value" /><Button Key="LauncherMigration.destination" Label="选择目标父目录，自动创建新的迁入目录" Content="选择目标" Command="ui.settings.launcher-migration.action" Enabled="{data enabled}" Class="settings-catalog-action settings-launcher-migration-action" /></StackPanel>
    <Text Content="选择目标父目录后会生成新的迁入目录。在线账户须重新登录；其他启动器的令牌、启动脚本和私有设置不会执行或导入。需要转换的实例会通过安装器生成版本与加载器，可能联网下载；进度见任务中心。" Class="settings-launcher-migration-note" />
    <StackPanel Class="settings-launcher-migration-actions"><Button Key="LauncherMigration.preview" Label="预览实例和数据量" Content="预览迁移" Command="ui.settings.launcher-migration.action" Enabled="{data previewEnabled}" Class="settings-catalog-action settings-launcher-migration-action" /><Button Key="LauncherMigration.apply" Label="迁移勾选的实例" Content="迁移所选实例" Command="ui.settings.launcher-migration.action" Enabled="{data applyEnabled}" Class="settings-catalog-action settings-launcher-migration-wide" /><Button Key="LauncherMigration.cancel" Label="取消当前迁移操作" Content="取消操作" Command="ui.settings.launcher-migration.action" Enabled="{data busy}" IsVisible="{data busy}" Class="settings-catalog-action settings-launcher-migration-action" /></StackPanel>
    <Dynamic Key="LauncherMigration.Status" />
    <Dynamic Key="LauncherMigration.Warnings" />
    <Dynamic Key="LauncherMigration.Instances" Class="settings-launcher-migration-instances" />
    <Text Content="已迁入的实例会加入版本库。关闭页面或登记失败后，可选择迁入目录恢复记录并重试登记。撤销只清理本次创建且未被修改的副本；原目录始终保留。" Class="settings-launcher-migration-note" />
    <StackPanel Class="settings-launcher-migration-actions"><Button Key="LauncherMigration.recover" Label="选择迁入目录恢复迁移记录" Content="恢复迁移记录" Command="ui.settings.launcher-migration.action" Enabled="{data recoverEnabled}" Class="settings-catalog-action settings-launcher-migration-wide" /><Button Key="LauncherMigration.register" Label="将已完成的迁入副本重新登记到版本库" Content="重试登记" Command="ui.settings.launcher-migration.action" Enabled="{data registerEnabled}" IsVisible="{data hasReceipt}" Class="settings-catalog-action settings-launcher-migration-action" /><Button Key="LauncherMigration.undo" Label="检查并撤销本次迁移" Content="撤销本次迁移" Command="ui.settings.launcher-migration.action" Enabled="{data undoEnabled}" IsVisible="{data hasReceipt}" Class="settings-catalog-action settings-launcher-migration-wide" /><Button Key="LauncherMigration.cleanup" Label="完成已撤销副本的版本库登记清理" Content="完成撤销登记" Command="ui.settings.launcher-migration.action" Enabled="{data cleanupEnabled}" IsVisible="{data hasCleanup}" Class="settings-catalog-action settings-launcher-migration-wide" /></StackPanel>
  </StackPanel></StackPanel>
</SettingsForm>
</nxml-dynamic>
