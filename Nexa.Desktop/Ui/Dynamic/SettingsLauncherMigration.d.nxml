<nxml-dynamic>
  <SettingsForm Key="LauncherMigrationWorkspace">
    <StackPanel IsVisible="{data !loading}" Spacing="12">
      <Text Content="从其他启动器迁移" Class="settings-form-label" />
      <StackPanel Key="LauncherMigration.Card" Class="settings-form-surface">
        <StackPanel Key="LauncherMigration.Body" Class="settings-launcher-migration-body">
          <StackPanel Class="settings-launcher-migration-field">
            <Text Content="来源类型" Class="settings-launcher-migration-label" />
            <Text Key="LauncherMigration.SourceKind" Content="{data sourceKind}" Localize="false" Class="settings-launcher-migration-value" />
            <Button Key="LauncherMigration.kind" Label="切换来源类型" Content="切换来源" Command="ui.settings.launcher-migration.action" Enabled="{data enabled}" Class="settings-catalog-action settings-launcher-migration-action" />
          </StackPanel>
          <Button Key="LauncherMigration.discover" Label="检测所选来源类型的常用数据位置" Content="检测常用位置" Command="ui.settings.launcher-migration.action" Enabled="{data discoverEnabled}" Class="settings-catalog-action settings-launcher-migration-wide" />
          <Dynamic Key="LauncherMigration.Sources" Class="settings-launcher-migration-instances" />
          <StackPanel Class="settings-launcher-migration-field">
            <Text Content="来源目录" Class="settings-launcher-migration-label" />
            <Text Key="LauncherMigration.Source" Content="{data source}" Localize="false" Class="settings-launcher-migration-value" />
            <Button Key="LauncherMigration.source" Label="选择其他启动器的数据目录" Content="选择来源" Command="ui.settings.launcher-migration.action" Enabled="{data enabled}" Class="settings-catalog-action settings-launcher-migration-action" />
          </StackPanel>
          <StackPanel Class="settings-launcher-migration-field">
            <Text Content="迁入目录" Class="settings-launcher-migration-label" />
            <Text Key="LauncherMigration.Destination" Content="{data destination}" Localize="false" Class="settings-launcher-migration-value" />
            <Button Key="LauncherMigration.destination" Label="选择目标父目录，自动创建新的迁入目录" Content="选择目标" Command="ui.settings.launcher-migration.action" Enabled="{data enabled}" Class="settings-catalog-action settings-launcher-migration-action" />
          </StackPanel>
          <StackPanel Class="settings-launcher-migration-actions">
            <Button Key="LauncherMigration.preview" Label="预览实例和数据量" Content="预览迁移" Command="ui.settings.launcher-migration.action" Enabled="{data previewEnabled}" Class="settings-catalog-action settings-launcher-migration-action" />
            <Button Key="LauncherMigration.apply" Label="迁移勾选的实例" Content="迁移所选实例" Command="ui.settings.launcher-migration.action" Enabled="{data applyEnabled}" Class="settings-catalog-action settings-launcher-migration-wide" />
          </StackPanel>
          <Dynamic Key="LauncherMigration.Status" />
          <Dynamic Key="LauncherMigration.Warnings" />
          <Dynamic Key="LauncherMigration.Instances" Class="settings-launcher-migration-instances" />
          <StackPanel Class="settings-launcher-migration-actions">
            <Button Key="LauncherMigration.recover" Label="选择迁入目录恢复迁移记录" Content="恢复迁移记录" Command="ui.settings.launcher-migration.action" Enabled="{data recoverEnabled}" Class="settings-catalog-action settings-launcher-migration-wide" />
            <Button Key="LauncherMigration.register" Label="将已完成的迁入副本重新登记到版本库" Content="重试登记" Command="ui.settings.launcher-migration.action" Enabled="{data registerEnabled}" IsVisible="{data hasReceipt}" Class="settings-catalog-action settings-launcher-migration-action" />
            <Button Key="LauncherMigration.undo" Label="检查并撤销本次迁移" Content="撤销本次迁移" Command="ui.settings.launcher-migration.action" Enabled="{data undoEnabled}" IsVisible="{data hasReceipt}" Class="settings-catalog-action settings-launcher-migration-wide" />
            <Button Key="LauncherMigration.cleanup" Label="完成已撤销副本的版本库登记清理" Content="完成撤销登记" Command="ui.settings.launcher-migration.action" Enabled="{data cleanupEnabled}" IsVisible="{data hasCleanup}" Class="settings-catalog-action settings-launcher-migration-wide" />
          </StackPanel>
        </StackPanel>
      </StackPanel>
    </StackPanel>
    <LoadingView IsVisible="{data loading}">
      <Text Content="正在处理启动器迁移…" Class="loading-hint" LiveSetting="Polite" />
      <Button Key="LauncherMigration.cancel" Label="取消当前迁移操作" Content="取消操作" Command="ui.settings.launcher-migration.action" Enabled="{data busy}" IsVisible="{data busy}" Class="settings-catalog-action settings-launcher-migration-action" />
    </LoadingView>
  </SettingsForm>
</nxml-dynamic>
