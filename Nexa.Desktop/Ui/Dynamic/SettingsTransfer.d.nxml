<nxml-dynamic>
  <SettingsForm Key="SettingsTransfer">
    <Text Content="设置数据" Class="settings-form-label" />
    <StackPanel Class="settings-form-surface"><StackPanel Class="settings-form-body">
      <StackPanel Key="SettingsImport.Row" Class="settings-transfer-row">
        <StackPanel Class="settings-storage-labels">
          <Text Content="导入设置" Class="settings-storage-label" />
        </StackPanel>
        <Button Key="SettingsImport" Label="选择文件" Content="选择文件" Command="ui.settings.data.import" Enabled="{data importEnabled}" Class="settings-catalog-action settings-storage-action" />
      </StackPanel>
      <StackPanel Key="SettingsExport.Row" Class="settings-transfer-row">
        <StackPanel Class="settings-storage-labels">
          <Text Content="导出设置" Class="settings-storage-label" />
        </StackPanel>
        <Button Key="SettingsExport" Label="导出" Content="导出" Command="ui.settings.data.export" Enabled="{data exportEnabled}" Class="settings-catalog-action settings-storage-action" />
      </StackPanel>
      <StackPanel Key="SettingsReset.Row" Class="settings-transfer-row">
        <StackPanel Class="settings-storage-labels">
          <Text Content="恢复默认" IsVisible="{data global}" Class="settings-storage-label" />
          <Text Content="恢复继承" IsVisible="{data instance}" Class="settings-storage-label" />
        </StackPanel>
        <Button Key="SettingsReset" Label="恢复" Content="恢复" Command="ui.settings.data.reset" Enabled="{data resetEnabled}" Class="settings-catalog-action settings-storage-action" />
      </StackPanel>
    </StackPanel></StackPanel>
  </SettingsForm>
</nxml-dynamic>
