<nxml-dynamic>
  <SettingsForm Key="Theme.Settings">
    <Text Content="主题包" Class="settings-form-label" />
    <StackPanel Class="settings-form-surface theme-surface">
      <Text Content="导入 NTP/1 主题包，或选择开发目录。切换立即生效；预览不会更改保存的选择。" Class="theme-description" />
      <StackPanel Class="theme-actions">
        <Button Key="Theme.ImportPackage" Content="导入主题包" Label="导入主题包" Command="ui.settings.theme.action" Enabled="{data canImport}" Class="theme-action" />
        <Button Key="Theme.ImportDirectory" Content="开发目录" Label="开发目录" Command="ui.settings.theme.action" Enabled="{data canImport}" Class="theme-action" />
        <Button Key="Theme.Refresh" Content="刷新" Label="刷新" Command="ui.settings.theme.action" Enabled="{data ready}" Class="theme-action-small" />
        <Button Key="Theme.EndPreview" Content="结束预览" Label="结束预览" Command="ui.settings.theme.action" IsVisible="{data preview}" Class="theme-action" />
      </StackPanel>
      <Text Content="正在准备主题…" IsVisible="{data busy}" Class="theme-description" />
      <Text Content="当前为临时预览，结束后恢复已保存的主题。" IsVisible="{data preview}" Class="theme-description" />
      <Text Key="Theme.Error" Content="{data error}" Label="{data error}" Localize="false" IsVisible="{data hasError}" Class="theme-error" />
      <Dynamic Key="Theme.Rows" Class="theme-rows" />
    </StackPanel>
  </SettingsForm>
</nxml-dynamic>
