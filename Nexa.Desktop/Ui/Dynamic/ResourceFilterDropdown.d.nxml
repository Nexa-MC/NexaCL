<nxml-dynamic>
  <Node Recipe="Element" Kind="ResourceFilterLayer" Key="ResourceFilterOverlay" ModalLayer="true" DismissCommand="ui.resources.action" Command="ui.resources.action" Clickable="true">
    <Button Key="ResourceFilterDismiss" Label="关闭筛选" Command="ui.resources.action" Class="resource-filter-dismiss" />
    <StackPanel Key="ResourceFilterCard" Anchor="{data anchor}" Height="{data height}" Class="resource-filter-card">
      <StackPanel Class="resource-filter-padding">
        <TextInput Key="ResourceFilterSearch" Label="搜索版本" Placeholder="搜索版本" IsVisible="{data searchable}" Class="resource-filter-search" />
        <Dynamic Key="ResourceFilterOptions" Scroll="true" ScrollGesture="true" ShowsVerticalIndicator="{data indicator}" Class="resource-filter-options" />
      </StackPanel>
    </StackPanel>
  </Node>
</nxml-dynamic>
