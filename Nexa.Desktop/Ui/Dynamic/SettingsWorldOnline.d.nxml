<nxml-dynamic><StackPanel Key="ManagementOnlineContent" Class="world-stack"><Text Content="在线信息" Class="world-title"  /><StackPanel IsVisible="{data project}" Class="world-stack"><StackPanel Key="ManagementOnlineIdentity" Class="world-actions"><Image Source="" Key="ManagementOnlineIcon" IsVisible="{data icon}" Class="world-online-icon" /><StackPanel Class="world-server-identity"><Text Key="Online.Title" Content="{data name}" Class="world-online-name" Localize="false" /></StackPanel></StackPanel><Text Key="Online.Description" Content="{data description}" Class="world-message" IsVisible="{data hasDescription}" Localize="false" /><StackPanel Class="world-fact"><Text Content="来源" Class="world-label"  /><Text Content="{data source}" Class="world-value" Localize="false" /></StackPanel><StackPanel Class="world-fact"><Text Content="作者" Class="world-label"  /><Text Content="{data author}" Class="world-value" Localize="false" /></StackPanel><StackPanel Class="world-fact"><Text Content="下载次数" Class="world-label"  /><Text Content="{data downloads}" Class="world-value" Localize="false" /></StackPanel><StackPanel Class="world-fact"><Text Content="已安装版本" Class="world-label"  /><Text Content="{data installed}" Class="world-value" Localize="false" /></StackPanel><StackPanel IsVisible="{data hasUpdate}" Class="world-actions"><Text Content="可更新至 {data update}" Class="world-pack-name" Localize="false" /><Button Key="ManagementOnlineUpdate" Content="更新" Command="ui.settings.management.action" Class="settings-catalog-action world-button-small" IsVisible="{data canUpdate}" /><Text Content="正在更新…" Class="world-hint" IsVisible="{data updating}" /></StackPanel><Text Content="适用于当前游戏的版本" Class="world-hint" IsVisible="{data hasVersions}" /><Dynamic Key="Online.Versions" Class="world-rows" /><Text Content="暂未找到适用于当前游戏的版本。" Class="world-hint" IsVisible="{data noVersions}" /><Text Content="正在读取更新日志…" Class="world-hint" IsVisible="{data changelogRead}" /><Text Key="Online.Changelog" Content="{data changelog}" Class="world-message" IsVisible="{data hasChangelog}" Localize="false" /><Button Key="Management.查看项目" Content="查看项目" Command="ui.settings.management.action" Class="settings-catalog-action world-button"  /></StackPanel><Text Content="{data notice}" Class="world-hint" IsVisible="{data hasNotice}" Localize="false" /><Text Content="正在识别文件并获取项目资料…" Class="world-hint" IsVisible="{data reading}" /><Button Key="Management.重新识别" Content="重新识别" Command="ui.settings.management.action" Class="settings-catalog-action world-button" IsVisible="{data refresh}" /></StackPanel></nxml-dynamic>
