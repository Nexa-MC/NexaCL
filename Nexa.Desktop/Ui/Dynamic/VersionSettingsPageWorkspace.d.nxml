<nxml-dynamic>
  <StackPanel Key="SettingsLayout" Class="layout-SettingsPage-SettingsLayout">
    <StackPanel Key="SettingsToolbar" IsVisible="{data !loading}" Class="layout-SettingsPage-SettingsToolbar">
      <ContentHost Key="SettingsNavigationSurface" Class="settings-navigation-surface">
        <ContentHost Key="SettingsThumb" TransitionKey="settings-navigation" IsVisible="false" Class="settings-navigation-thumb" />
        <SettingsChoiceSlot SegmentThumb="SettingsThumb" ScrollGesture="true" Key="SettingsNavigation" Label="版本设置分类" Scroll="true" Class="layout-SettingsPage-SettingsNavigation" />
      </ContentHost>
    </StackPanel>
    <ContentHost Weight="1">
      <Dynamic Layout="HorizontalPager" Key="SettingsPager" Label="设置子页面，可拖动或使用左右方向键切换" Class="layout-SettingsPage-SettingsPager" IsVisible="{data !loading}" />
      <LoadingView IsVisible="{data loading}">
        <Text Content="{data message}" Class="loading-hint" LiveSetting="Polite" />
      </LoadingView>
    </ContentHost>
    <Dynamic Key="SettingsSaveStatusSlot" Class="layout-SettingsPage-SettingsSaveStatus" />
  </StackPanel>
</nxml-dynamic>
