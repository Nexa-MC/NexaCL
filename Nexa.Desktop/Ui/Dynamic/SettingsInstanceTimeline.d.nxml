<nxml-dynamic><StackPanel Key="RecoveryTimeline" Class="settings-diagnostics-card"><StackPanel Class="instance-tools-body"><Text Key="RecoveryTimeline.Title" Content="恢复时间线" Class="instance-tools-title" />
<Text IsVisible="{data incomplete}" Content="时间线读取不完整，请刷新后重试。" Class="instance-tools-hint" /><Text IsVisible="{data empty}" Content="尚无已保存的成功运行记录。" Class="instance-tools-hint" /><Text IsVisible="{data hasPoints}" Content="按已保存快照的实际采集时间排列；文件数量变化表示记录差值。" Class="instance-tools-hint" />
<Dynamic Key="RecoveryTimeline.Rows" Class="instance-tools-rows" /><Text IsVisible="{data more}" Content="显示最近 16 个时间点。" Class="instance-tools-hint" /><Text IsVisible="{data hasComparison}" Content="当前与恢复基线比较：{data changes} 项更改" Localize="false" Class="instance-tools-hint" /></StackPanel></StackPanel></nxml-dynamic>
