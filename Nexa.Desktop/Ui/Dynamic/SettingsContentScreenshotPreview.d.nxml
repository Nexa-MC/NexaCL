<nxml-dynamic>
<Node Key="ScreenshotPreviewLayer" DismissCommand="ui.settings.screenshot-preview.action" OverlayMotion="DialogScrim" ModalLayer="true" Class="settings-content-screenshot-scrim" Recipe="Element" Kind="ContentOverlay"><Dialog Key="ScreenshotPreview" Label="截图预览" Width="{data width}" MaxHeight="{data maxHeight}" Scroll="true" ScrollGesture="true" ShowsVerticalIndicator="true" OverlayMotion="Dialog" Class="settings-content-screenshot-dialog"><StackPanel Key="ScreenshotPreviewBody" Class="settings-content-screenshot-body"><StackPanel Key="ScreenshotPreviewHeader" Class="settings-content-screenshot-header"><Text Key="ScreenshotPreviewTitle" Content="{data name}" Localize="false" MaxLines="1" TrimOverflow="true" Class="settings-content-screenshot-title" /><Button Key="ScreenshotPreview.Refresh" Height="36" Label="刷新" Command="ui.settings.screenshot-preview.action" Enabled="{data enabled}" Width="36" Class="settings-content-button" Icon="pcl/refresh" /><Button Key="ScreenshotPreview.Close" Content="关闭" Label="关闭" Command="ui.settings.screenshot-preview.action" Width="72" Class="settings-content-button" /></StackPanel><Image Key="ScreenshotPreviewImage" Source="nexa/content-image" Label="{data name}" Localize="false" Height="{data imageHeight}" Class="settings-content-screenshot-image" /><Text Content="图像尺寸" Class="settings-content-screenshot-dimensions" /><Text Key="ScreenshotPreviewStatus" Content="{data status}" Localize="false" Class="settings-content-screenshot-status" /><StackPanel Key="ScreenshotPreviewActions" Orientation="{data actionOrientation}" Class="settings-content-screenshot-actions"><Button Key="ScreenshotPreview.Copy" Content="复制图片" Label="复制图片" Command="ui.settings.screenshot-preview.action" Width="96" Class="settings-content-button" IsVisible="{data canCopy}" Enabled="{data readable}" /><Button Key="ScreenshotPreview.Share" Content="分享截图" Label="分享截图" Command="ui.settings.screenshot-preview.action" Width="96" Class="settings-content-button" IsVisible="{data canShare}" Enabled="{data readable}" /><Button Key="ScreenshotPreview.Folder" Content="打开所在文件夹" Label="打开所在文件夹" Command="ui.settings.screenshot-preview.action" Width="128" Class="settings-content-button" IsVisible="{data canFolder}" /><Button Key="ScreenshotPreview.Remove" Content="移至已移除内容" Label="移至已移除内容" Command="ui.settings.screenshot-preview.action" Width="128" Class="settings-content-button" IsVisible="{data canRemove}" /><Button Key="ScreenshotPreview.Crop" Content="{data cropLabel}" Label="{data cropLabel}" Command="ui.settings.screenshot-preview.action" Width="96" Class="settings-content-button" IsVisible="{data canCrop}" Enabled="{data cropEnabled}" /></StackPanel><StackPanel Key="ScreenshotCrop" IsVisible="{data cropVisible}" Class="settings-content-screenshot-crop"><Text Content="裁剪为新截图" Class="settings-content-screenshot-crop-title" /><StackPanel Key="ScreenshotCropFields" Class="settings-content-screenshot-fields"><StackPanel Key="ScreenshotCropPosition" Class="settings-content-screenshot-field-column"><StackPanel Class="settings-content-screenshot-field"><Text Content="左侧像素" Class="settings-content-screenshot-field-label" /><TextInput Key="ScreenshotCropX" Label="左侧像素" Class="settings-content-screenshot-input" /></StackPanel><StackPanel Class="settings-content-screenshot-field"><Text Content="顶部像素" Class="settings-content-screenshot-field-label" /><TextInput Key="ScreenshotCropY" Label="顶部像素" Class="settings-content-screenshot-input" /></StackPanel></StackPanel><StackPanel Key="ScreenshotCropDimensions" Class="settings-content-screenshot-field-column"><StackPanel Class="settings-content-screenshot-field"><Text Content="宽度" Class="settings-content-screenshot-field-label" /><TextInput Key="ScreenshotCropWidth" Label="宽度" Class="settings-content-screenshot-input" /></StackPanel><StackPanel Class="settings-content-screenshot-field"><Text Content="高度" Class="settings-content-screenshot-field-label" /><TextInput Key="ScreenshotCropHeight" Label="高度" Class="settings-content-screenshot-input" /></StackPanel></StackPanel></StackPanel><Button Key="ScreenshotPreview.SaveCrop" Content="保存裁剪副本" Label="保存裁剪副本" Command="ui.settings.screenshot-preview.action" Width="128" Class="settings-content-button" /></StackPanel></StackPanel></Dialog></Node>
</nxml-dynamic>
