<nxml-dynamic>
<StackPanel Key="{data row}" Class="settings-workspace-backup"><Text Content="{data name} · {data files} 个文件 · {data created}" Localize="false" Class="settings-workspace-caption" /><StackPanel Key="{data actions}" Class="settings-workspace-actions"><Button Key="{data verify}" Label="离线校验" Content="离线校验" Command="ui.settings.storage.workspace" Enabled="{data enabled}" Class="settings-catalog-action settings-workspace-action" /><Button Key="{data restore}" Label="恢复副本" Content="恢复副本" Command="ui.settings.storage.workspace" Enabled="{data enabled}" Class="settings-catalog-action settings-workspace-action" /><Button Key="{data export}" Label="导出薄备份" Content="导出薄备份" Command="ui.settings.storage.workspace" Enabled="{data enabled}" Class="settings-catalog-action settings-workspace-action" /></StackPanel></StackPanel>
</nxml-dynamic>
