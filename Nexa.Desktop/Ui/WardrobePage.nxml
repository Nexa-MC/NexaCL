<nxml-page>
  <Page Key="AccountWardrobePage" Label="更衣橱">
    <StackPanel Key="WardrobeRoot" Class="layout-WardrobePage-WardrobeRoot">
      <ContentHost Key="WardrobeRailSurface" Class="layout-WardrobePage-WardrobeRailSurface">
        <StackPanel Key="WardrobeProfileRail" Scroll="true" Class="layout-WardrobePage-WardrobeProfileRail">
          <Text Key="WardrobeCurrentTitle" Content="当前外观" Class="layout-WardrobePage-WardrobeCurrentTitle" />
          <Text Key="WardrobeCurrentSubtitle" Content="完整预览当前档案正在使用的皮肤与披风。" Class="layout-WardrobePage-WardrobeCurrentSubtitle" />
          <StackPanel Key="WardrobeCurrentCard" Class="layout-WardrobePage-WardrobeCurrentCard">
            <ContentHost Key="WardrobeCurrentPreview" Class="layout-WardrobePage-WardrobeCurrentPreview">
              <Image Key="WardrobePlayerPreview" Label="当前皮肤与披风全身预览" Source="lucide/image" Class="layout-WardrobePage-WardrobePlayerPreview" />
              <Button Key="WardrobeCurrentView" Label="切换当前外观视角" Content="" Icon="pcl/refresh" Command="ui.wardrobe.view.current" Class="layout-WardrobePage-WardrobeCurrentView" />
            </ContentHost>
            <Text Key="WardrobeIdentity" Content="更衣橱" Class="layout-WardrobePage-WardrobeIdentity" />
            <Text Key="WardrobeProfileKind" Content="请先选择账户" Class="layout-WardrobePage-WardrobeProfileKind" />
          </StackPanel>
          <Button Key="WardrobeBrowse" Label="选择本地皮肤" Content="选择本地皮肤" Command="ui.wardrobe.browse" Class="layout-WardrobePage-WardrobeBrowse" />
          <Button Key="WardrobeLibrary" Label="打开皮肤库" Content="皮肤库" Command="ui.wardrobe.library" Class="layout-WardrobePage-WardrobeLibrary" />
          <Button Key="WardrobeManage" Label="打开账户皮肤站" Content="打开账户皮肤站" Command="ui.wardrobe.manage" Icon="lucide/external-link" IsVisible="false" Class="layout-WardrobePage-WardrobeManage" />
          <Button Key="WardrobeCancel" Label="取消更衣橱操作" Content="取消操作" Command="ui.wardrobe.cancel" IsVisible="false" Class="layout-WardrobePage-WardrobeCancel" />
        </StackPanel>
      </ContentHost>
      <StackPanel Key="WardrobeContent" Scroll="true" Class="layout-WardrobePage-WardrobeContent">
        <StackPanel Key="WardrobeMainHeader" IsVisible="false" Class="layout-WardrobePage-WardrobeMainHeader">
          <Text Key="WardrobePageTitle" Content="更衣橱" Class="layout-WardrobePage-WardrobePageTitle" />
        </StackPanel>
        <Text Key="WardrobeStatus" Content="正在读取当前账户…" Class="layout-WardrobePage-WardrobeStatus" />
        <StackPanel Key="WardrobeSkinHeader" Class="layout-WardrobePage-WardrobeSkinHeader">
          <Text Key="WardrobeSkinTitle" Content="皮肤" Class="layout-WardrobePage-WardrobeSkinTitle" />
          <Text Key="WardrobeSkinCount" Content="0 项" Class="layout-WardrobePage-WardrobeSkinCount" />
          <StackPanel Key="WardrobeSkinPager" Class="layout-WardrobePage-WardrobeSkinPager">
            <Button Key="WardrobeSkinPrevious" Content="" Label="向左浏览皮肤" Command="ui.wardrobe.skin.previous" Icon="lucide/arrow-left" Class="layout-WardrobePage-WardrobeSkinPrevious" />
            <Button Key="WardrobeSkinNext" Content="" Label="向右浏览皮肤" Command="ui.wardrobe.skin.next" Icon="lucide/chevron-right" Class="layout-WardrobePage-WardrobeSkinNext" />
          </StackPanel>
          <Button Key="WardrobeRefresh" Content="" Label="刷新更衣橱" Command="ui.wardrobe.refresh" Icon="pcl/refresh" Class="layout-WardrobePage-WardrobeRefresh" />
        </StackPanel>
        <Text Key="WardrobeSkinSubtitle" Content="此前更换过的皮肤和其他档案的皮肤" Class="layout-WardrobePage-WardrobeSkinSubtitle" />
        <StackPanel Key="WardrobeSkinTrack" Class="layout-WardrobePage-WardrobeSkinTrack">
          <StackPanel Key="WardrobeSkins" Scroll="true" Class="layout-WardrobePage-WardrobeSkins" />
          <Text Key="WardrobeSkinsEmpty" Content="还没有发现可展示的皮肤。可以选择本地皮肤或打开皮肤库。" IsVisible="false" Class="layout-WardrobePage-WardrobeSkinsEmpty" />
        </StackPanel>
        <StackPanel Key="WardrobeCapeHeader" Class="layout-WardrobePage-WardrobeCapeHeader">
          <Text Key="WardrobeCapeTitle" Content="披风" Class="layout-WardrobePage-WardrobeCapeTitle" />
          <Text Key="WardrobeCapeCount" Content="0 项" Class="layout-WardrobePage-WardrobeCapeCount" />
          <StackPanel Key="WardrobeCapePager" Class="layout-WardrobePage-WardrobeCapePager">
            <Button Key="WardrobeCapePrevious" Content="" Label="向左浏览披风" Command="ui.wardrobe.cape.previous" Icon="lucide/arrow-left" Class="layout-WardrobePage-WardrobeCapePrevious" />
            <Button Key="WardrobeCapeNext" Content="" Label="向右浏览披风" Command="ui.wardrobe.cape.next" Icon="lucide/chevron-right" Class="layout-WardrobePage-WardrobeCapeNext" />
            <Button Key="WardrobeCapeClear" Content="" Label="关闭当前披风" Command="ui.wardrobe.cape.clear" Icon="lucide/circle-minus" Class="layout-WardrobePage-WardrobeCapeClear" />
          </StackPanel>
        </StackPanel>
        <Text Key="WardrobeCapeSubtitle" Content="当前、历史和其他档案中发现的披风。" Class="layout-WardrobePage-WardrobeCapeSubtitle" />
        <StackPanel Key="WardrobeCapeTrack" Class="layout-WardrobePage-WardrobeCapeTrack">
          <StackPanel Key="WardrobeCapes" Scroll="true" Class="layout-WardrobePage-WardrobeCapes" />
          <Text Key="WardrobeCapeStatus" Content="正在读取披风…" IsVisible="false" Class="layout-WardrobePage-WardrobeCapeStatus" />
        </StackPanel>
      </StackPanel>
      <ContentHost Key="WardrobeLocalLayer" Label="本地皮肤选择" IsVisible="false">
        <Dialog Key="WardrobeLocalPanel" Label="选择本地皮肤" Scroll="true" Class="layout-WardrobePage-WardrobeLocalPanel">
          <Text Key="WardrobeLocalTitle" Content="选择本地皮肤" Class="layout-WardrobePage-WardrobeLocalTitle" />
          <Text Content="支持 64×64 或经典模型的 64×32 PNG 皮肤，最大 1 MiB。" Class="layout-WardrobePage-46" />
          <StackPanel Key="WardrobePreviews" Class="layout-WardrobePage-WardrobePreviews">
            <Image Key="WardrobeHeadPreview" Label="选择的皮肤头像预览" Source="pcl/avatar/steve" Class="layout-WardrobePage-WardrobeHeadPreview" />
            <Image Key="WardrobeTexturePreview" Label="选择的皮肤 PNG 预览" Source="lucide/image" Class="layout-WardrobePage-WardrobeTexturePreview" />
          </StackPanel>
          <StackPanel Class="layout-WardrobePage-50">
            <TextInput Key="WardrobeSkinPath" Label="皮肤 PNG 文件路径" Placeholder="皮肤 PNG 文件路径" Class="layout-WardrobePage-WardrobeSkinPath" />
            <Button Key="WardrobeChooseFile" Label="选择皮肤文件" Content="选择文件" Command="ui.wardrobe.browse" Class="layout-WardrobePage-WardrobeChooseFile" />
          </StackPanel>
          <StackPanel Class="layout-WardrobePage-53">
            <Button Key="WardrobeClassic" Label="经典皮肤模型" Content="✓  经典模型" Command="ui.wardrobe.classic" Class="layout-WardrobePage-WardrobeClassic" />
            <Button Key="WardrobeSlim" Label="纤细皮肤模型" Content="纤细模型" Command="ui.wardrobe.slim" Class="layout-WardrobePage-WardrobeSlim" />
          </StackPanel>
          <Text Key="WardrobeLocalStatus" Content="选择文件并确认手臂模型后上传。" Class="layout-WardrobePage-WardrobeLocalStatus" />
          <StackPanel Class="layout-WardrobePage-57">
            <Button Key="WardrobeLocalClose" Label="关闭本地皮肤选择" Content="取消" Command="ui.wardrobe.local.close" Class="layout-WardrobePage-WardrobeLocalClose" />
            <Button Key="WardrobePreview" Label="校验并预览皮肤" Content="校验并预览" Command="ui.wardrobe.preview" Class="layout-WardrobePage-WardrobePreview" />
            <Button Key="WardrobeUpload" Label="上传预览的皮肤" Content="上传皮肤" Command="ui.wardrobe.upload" Class="layout-WardrobePage-WardrobeUpload" />
          </StackPanel>
        </Dialog>
      </ContentHost>
    </StackPanel>
  </Page>
</nxml-page>
