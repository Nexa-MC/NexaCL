<Page xmlns="https://pcln.dev/pxml/2026" Key="SettingsPage" Label="设置">
  <StackPanel Key="SettingsLayout" Orientation="Vertical" Weight="1" Spacing="8" Padding="20,16,20,16">
    <StackPanel Key="SettingsToolbar" Orientation="Horizontal" Height="44" Spacing="12">
      <StackPanel Key="SettingsNavigation" Label="设置分类" Orientation="Horizontal" Height="44" Weight="1" MaxWidth="960" Spacing="2" Scroll="true" Padding="4,0,4,0">
        <ContentHost Key="SettingsThumb" IsVisible="false" />
      </StackPanel>
      <Text Key="SettingsSaveStatus" Content="" Width="96" Height="18" VerticalAlignment="Center" />
    </StackPanel>
    <HorizontalPager Key="SettingsPager" Label="设置子页面，可拖动或使用左右方向键切换" Weight="1" MinHeight="180" />
  </StackPanel>
</Page>
