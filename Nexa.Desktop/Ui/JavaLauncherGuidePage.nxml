<nxml-page>
  <Page Key="JavaLauncherGuidePage" Label="Java 版下载">
    <ContentHost Class="java-launcher-guide-host">
      <StackPanel Key="JavaLauncherGuideCard" Class="launch-install-bedrock-base java-launcher-guide-card">
        <Image Key="JavaLauncherGuideIcon" Source="lucide/shopping-bag" Label="Microsoft Store" Class="java-launcher-guide-icon" />
        <Text Key="JavaLauncherGuideTitle" Content="通过官方启动器获取 Minecraft" Class="launch-install-bedrock-base java-launcher-guide-title" />
        <Text Key="JavaLauncherGuideDescription" Content="不向中国大陆提供 Minecraft 本体下载服务。请前往 Microsoft Store 下载 Minecraft Launcher，再通过官方启动器获取 Minecraft：Java 版。" Class="launch-install-bedrock-base java-launcher-guide-copy" />
        <Button Key="JavaLauncherStore" Content="前往 Microsoft Store" Label="在 Microsoft Store 下载 Minecraft Launcher" Icon="lucide/external-link" Command="ui.install.java.store" Class="launch-install-bedrock-button java-launcher-guide-button" />
        <Text Key="JavaLauncherGuideLocal" Content="已有完整的本地游戏？仍可导入并使用 NexaCL 启动。" Class="launch-install-bedrock-base java-launcher-guide-copy" />
        <Text Key="JavaLauncherGuidePlatform" Content="Microsoft Store 中的 Minecraft Launcher 适用于 Windows；macOS / Linux 用户可继续使用完整的本地版本。" Class="launch-install-bedrock-base launch-install-bedrock-return java-launcher-guide-copy" />
      </StackPanel>
    </ContentHost>
  </Page>
</nxml-page>
