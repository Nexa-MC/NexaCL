<nxml-page>
  <Page Key="JavaChoicePage" Label="选择 Java 版本">
    <StackPanel Scroll="true" Class="layout-JavaChoicePage-2">
      <Text Content="选择使用的 Java 版本" Class="layout-JavaChoicePage-3" />
      <Text Content="优先使用本机已安装的版本，缺失时自动下载。" Class="layout-JavaChoicePage-4" />
      <Button Key="JavaChoice8" Content="Java 8" Label="Java 8" Command="ui.java.major.8" Class="layout-JavaChoicePage-JavaChoice8" />
      <Button Key="JavaChoice16" Content="Java 16" Label="Java 16" Command="ui.java.major.16" Class="layout-JavaChoicePage-JavaChoice16" />
      <Button Key="JavaChoice17" Content="Java 17" Label="Java 17" Command="ui.java.major.17" Class="layout-JavaChoicePage-JavaChoice17" />
      <Button Key="JavaChoice21" Content="Java 21" Label="Java 21" Command="ui.java.major.21" Class="layout-JavaChoicePage-JavaChoice21" />
      <Button Key="JavaChoice25" Content="Java 25" Label="Java 25" Command="ui.java.major.25" Class="layout-JavaChoicePage-JavaChoice25" />
    </StackPanel>
  </Page>
</nxml-page>
