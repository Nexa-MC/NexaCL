<nxml-page>
  <Shell Label="NexaCL">
    <TitleBar Class="layout-Shell-2">
      <StackPanel Key="TitleNavigation" Class="layout-Shell-TitleNavigation">
        <StackPanel Key="TitleBrand" Class="layout-Shell-TitleBrand" IsVisible="{state launch.navigation.root}">
          <Text Key="TitleMain" Content="NexaCL" TransitionKey="{state launch.navigation.title}" Class="layout-Shell-TitleMain" IsVisible="{state launch.navigation.root}" />
          <Dynamic Key="CustomLauncherLogoSlot" IsVisible="{state shell.appearance.logo_visible}" />
        </StackPanel>
        <Button Key="TitleBack" Label="返回上一级" Icon="lucide/arrow-left" Command="ui.page.back" IsVisible="{state launch.navigation.subpage}" TransitionKey="{state launch.navigation.title}" Class="layout-Shell-TitleBack" />
        <Text Key="TitleSubpage" Content="{state launch.navigation.caption}" IsVisible="{state launch.navigation.subpage}" TransitionKey="{state launch.navigation.title}" Class="layout-Shell-TitleSubpage" Localize="false" />
      </StackPanel>
    </TitleBar>
    <StackPanel StretchLastChild="true" Class="layout-Shell-8">
      <Navigation IsVisible="{state setup.presentation.navigation_visible}" StretchLastChild="true" Class="layout-Shell-9">
        <NavigationItem Label="启动" Content="启动" Icon="lucide/play" Command="ui.navigation.launch" />
        <NavigationItem Label="安装" Content="安装" Icon="lucide/package-plus" Command="ui.navigation.download" IsVisible="{state launch.navigation.install-visible}" Enabled="{state launch.navigation.install-visible}" />
        <NavigationItem Label="资源" Content="资源" Icon="lucide/blocks" Command="ui.navigation.community" />
        <NavigationItem Label="设置" Content="设置" Icon="lucide/settings" Command="ui.navigation.settings" />
      </Navigation>
      <ContentHost TransitionKey="navigation" Class="layout-Shell-14" />
    </StackPanel>
  </Shell>
</nxml-page>
