<nxml-page>
  <Page Key="ProcessLogPage" Label="游戏日志">
    <StackPanel Class="layout-ProcessLogPage-2">
      <StackPanel Class="layout-ProcessLogPage-3">
        <Button Key="ProcessLogPreviousSession" Content="上次运行" Label="上次运行" Command="ui.process.log.previous-session" Class="layout-ProcessLogPage-ProcessLogPreviousSession" />
        <Text Key="ProcessLogSession" Content="游戏日志" Class="layout-ProcessLogPage-ProcessLogSession" />
        <Button Key="ProcessLogNextSession" Content="下次运行" Label="下次运行" Command="ui.process.log.next-session" Class="layout-ProcessLogPage-ProcessLogNextSession" />
        <Button Key="ProcessLogRefresh" Icon="pcl/refresh" Label="刷新日志" Command="ui.process.log.refresh" Class="layout-ProcessLogPage-ProcessLogRefresh" />
      </StackPanel>
      <StackPanel Class="layout-ProcessLogPage-8">
        <TextInput Key="ProcessLogSearch" Label="搜索日志" Placeholder="搜索日志内容" Class="layout-ProcessLogPage-ProcessLogSearch" />
        <Button Key="ProcessLogAll" Content="全部" Label="全部输出" Command="ui.process.log.all" Class="layout-ProcessLogPage-ProcessLogAll" />
        <Button Key="ProcessLogStdout" Content="stdout" Label="标准输出" Command="ui.process.log.stdout" Class="layout-ProcessLogPage-ProcessLogStdout" />
        <Button Key="ProcessLogStderr" Content="stderr" Label="标准错误" Command="ui.process.log.stderr" Class="layout-ProcessLogPage-ProcessLogStderr" />
      </StackPanel>
      <Text Key="ProcessLogStatus" Content="正在读取日志…" Class="layout-ProcessLogPage-ProcessLogStatus" />
      <Text Key="ProcessLogEmpty" Content="" Class="layout-ProcessLogPage-ProcessLogEmpty" />
      <StackPanel Key="ProcessLogRows" Scroll="true" Class="layout-ProcessLogPage-ProcessLogRows" />
      <StackPanel Class="layout-ProcessLogPage-16">
        <Button Key="ProcessLogPrevious" Content="上一页" Label="上一页日志" Command="ui.process.log.previous" Class="layout-ProcessLogPage-ProcessLogPrevious" />
        <Text Key="ProcessLogPageNumber" Content="1 / 1" Class="layout-ProcessLogPage-ProcessLogPageNumber" />
        <Button Key="ProcessLogNext" Content="下一页" Label="下一页日志" Command="ui.process.log.next" Class="layout-ProcessLogPage-ProcessLogNext" />
        <Button Key="ProcessLogClearSelection" Content="清除选择" Label="清除日志选择" Command="ui.process.log.clear-selection" Class="layout-ProcessLogPage-ProcessLogClearSelection" />
        <Button Key="ProcessLogCopySelected" Content="复制所选" Label="复制所选日志" Command="ui.process.log.copy-selected" Class="layout-ProcessLogPage-ProcessLogCopySelected" />
        <Button Key="ProcessLogCopyPage" Content="复制本页" Label="复制本页日志" Command="ui.process.log.copy-page" Class="layout-ProcessLogPage-ProcessLogCopyPage" />
      </StackPanel>
    </StackPanel>
  </Page>
</nxml-page>
