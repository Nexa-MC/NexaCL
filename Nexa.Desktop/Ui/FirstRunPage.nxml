<nxml-page>
  <Page Key="FirstRunPage" Label="设置 NexaCL">
    <StackPanel Key="SetupFrame" Class="layout-FirstRunPage-SetupFrame">
      <Text Key="SetupStep" Content="1 / 4 · 欢迎" Class="layout-FirstRunPage-SetupStep" />
      <StackPanel Key="SetupBody" Class="layout-FirstRunPage-SetupBody">
        <Image Key="SetupHero" Source="lucide/box" Label="NexaCL" Class="layout-FirstRunPage-SetupHero" />
        <StackPanel Key="SetupForm" Scroll="true" Class="layout-FirstRunPage-SetupForm">
          <Text Key="SetupTitle" Content="欢迎使用 NexaCL" />
          <Text Key="SetupDescription" Content="先完成几项设置，然后开始你的 Minecraft。" />
          <Button Key="SetupStart" Label="开始配置" Content="开始配置" Command="ui.setup.next" Class="layout-FirstRunPage-SetupStart" />
          <StackPanel Key="SetupDirectory" IsVisible="false" Class="layout-FirstRunPage-SetupDirectory">
            <Text Key="SetupDirectoryLabel" Content="启动器数据位置" Class="layout-FirstRunPage-SetupDirectoryLabel" />
            <StackPanel Class="layout-FirstRunPage-12">
              <ContentHost Key="SetupPathSurface" Class="layout-FirstRunPage-SetupPathSurface">
                <Text Key="SetupPath" Content="" Class="layout-FirstRunPage-SetupPath" />
              </ContentHost>
              <Button Key="SetupBrowse" Label="选择文件夹" Content="浏览" Command="ui.setup.browse" Class="layout-FirstRunPage-SetupBrowse" />
            </StackPanel>
          </StackPanel>
          <StackPanel Key="SetupConsent" IsVisible="false" Class="layout-FirstRunPage-SetupConsent">
            <Button Key="SetupPrivate" Label="仅共享必要遥测" Content="仅共享必要遥测" Command="ui.setup.private" Class="layout-FirstRunPage-SetupPrivate" />
            <Button Key="SetupShare" Label="同时共享诊断信息" Content="同时共享诊断信息" Command="ui.setup.share" Class="layout-FirstRunPage-SetupShare" />
          </StackPanel>
          <ContentHost Key="SetupSummarySurface" IsVisible="false" Class="layout-FirstRunPage-SetupSummarySurface">
            <Text Key="SetupSummary" Content="" IsVisible="false" Class="layout-FirstRunPage-SetupSummary" />
          </ContentHost>
          <Text Key="SetupError" Content="" IsVisible="false" />
        </StackPanel>
      </StackPanel>
      <StackPanel Key="SetupFooter" Class="layout-FirstRunPage-SetupFooter">
        <Button Key="SetupBack" Label="上一步" Content="上一步" Command="ui.setup.back" IsVisible="false" Class="layout-FirstRunPage-SetupBack" />
        <ContentHost Class="layout-FirstRunPage-24" />
        <Button Key="SetupNext" Label="继续" Content="开始配置" Command="ui.setup.next" Class="layout-FirstRunPage-SetupNext" />
      </StackPanel>
    </StackPanel>
  </Page>
</nxml-page>
