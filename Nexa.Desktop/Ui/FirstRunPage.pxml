<Page xmlns="https://pcln.dev/pxml/2026" Key="FirstRunPage" Label="设置 NexaCL">
  <StackPanel Key="SetupFrame" Orientation="Vertical" Weight="1" Padding="16,8,16,8" Spacing="18" MaxWidth="840" HorizontalAlignment="Center">
    <Text Key="SetupStep" Content="1 / 4 · 欢迎" Height="24" />
    <StackPanel Key="SetupBody" Orientation="Horizontal" Weight="1" Spacing="32">
      <Image Key="SetupHero" Source="lucide/box" Label="NexaCL" Width="144" Height="144" VerticalAlignment="Center" />
      <StackPanel Key="SetupForm" Orientation="Vertical" Weight="1" Spacing="14" Scroll="true" VerticalAlignment="Center">
        <Text Key="SetupTitle" Content="欢迎使用 NexaCL" />
        <Text Key="SetupDescription" Content="先完成几项设置，然后开始你的 Minecraft。" />
        <Button Key="SetupStart" Label="开始配置" Content="开始配置" Command="ui.setup.next" Width="148" Height="42" />
        <StackPanel Key="SetupDirectory" Orientation="Vertical" Spacing="10" IsVisible="false">
          <Text Key="SetupDirectoryLabel" Content="启动器数据位置" Height="24" />
          <StackPanel Orientation="Horizontal" Spacing="10">
            <ContentHost Key="SetupPathSurface" Weight="1" Height="64">
              <Text Key="SetupPath" Content="" Height="40" Padding="12" />
            </ContentHost>
            <Button Key="SetupBrowse" Label="选择文件夹" Content="浏览" Command="ui.setup.browse" Width="80" Height="40" VerticalAlignment="Center" />
          </StackPanel>
        </StackPanel>
        <StackPanel Key="SetupConsent" Orientation="Vertical" Spacing="10" IsVisible="false">
          <Button Key="SetupPrivate" Label="仅共享必要遥测" Content="仅共享必要遥测" Command="ui.setup.private" Height="44" />
          <Button Key="SetupShare" Label="同时共享诊断信息" Content="同时共享诊断信息" Command="ui.setup.share" Height="44" />
        </StackPanel>
        <ContentHost Key="SetupSummarySurface" Height="166" IsVisible="false">
          <Text Key="SetupSummary" Content="" Height="134" Padding="16" IsVisible="false" />
        </ContentHost>
        <Text Key="SetupError" Content="" IsVisible="false" />
      </StackPanel>
    </StackPanel>
    <StackPanel Key="SetupFooter" Orientation="Horizontal" Height="42" Spacing="12">
      <Button Key="SetupBack" Label="上一步" Content="上一步" Command="ui.setup.back" Width="104" Height="42" IsVisible="false" />
      <ContentHost Weight="1" />
      <Button Key="SetupNext" Label="继续" Content="开始配置" Command="ui.setup.next" Width="148" Height="42" />
    </StackPanel>
  </StackPanel>
</Page>
