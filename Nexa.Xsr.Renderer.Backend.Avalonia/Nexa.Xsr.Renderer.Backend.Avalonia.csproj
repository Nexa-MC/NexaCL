<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Avalonia windowing, input, accessibility, and render submission backend for UI.Next.</Description>
    <!-- Source-generated native DWM interop remains confined to this platform edge. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>$(NoWarn);CA1001</NoWarn>
    <!-- Window close owns disposal of custom controls; Avalonia Window is the lifetime boundary. -->
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Nexa.Native.Window" />
    <EmbeddedResource Include="Assets/Avatars/Steve.png" />
    <EmbeddedResource Include="Assets/Avatars/Alex.png" />
    <EmbeddedResource Include="Assets/Versions/*.png" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.0" />
    <ProjectReference Include="../Nexa.Xsr.Renderer.Artwork/Nexa.Xsr.Renderer.Artwork.csproj" />
    <ProjectReference Include="../Nexa.Xsr.Renderer/Nexa.Xsr.Renderer.csproj" />
  </ItemGroup>
  <Import Project="../native/WindowProtocol/WindowContracts.props" />
</Project>
