<Project Sdk="Microsoft.NET.Sdk"
         TreatAsLocalProperty="PublishAot;PublishTrimmed;PublishSingleFile;PublishReadyToRun;SelfContained;RuntimeIdentifier">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- The weaver fingerprint enters every native module; release stamps must not invalidate it. -->
    <Version>1.0.0</Version>
    <InformationalVersion>1.0.0</InformationalVersion>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <EnableSourceLink>false</EnableSourceLink>
    <EnableSourceControlManagerQueries>false</EnableSourceControlManagerQueries>
    <EmbedUntrackedSources>false</EmbedUntrackedSources>
    <PublishRepositoryUrl>false</PublishRepositoryUrl>
    <NexaCompilerSourceRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../..'))/</NexaCompilerSourceRoot>
    <PathMap>$(NexaCompilerSourceRoot)=/_/</PathMap>
    <UseAppHost>false</UseAppHost>
    <Description>Build-time explicit Function Patch source rewriter and compiler contract tests.</Description>
    <PublishAot>false</PublishAot>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
    <SelfContained>false</SelfContained>
    <!-- Build-only reference: it is never loaded as a product executable dependency. -->
    <ShouldBeValidatedAsExecutableReference>false</ShouldBeValidatedAsExecutableReference>
    <RuntimeIdentifier></RuntimeIdentifier>
    <EnableTrimAnalyzer>false</EnableTrimAnalyzer>
  </PropertyGroup>
  <ItemGroup>
    <SourceRoot Include="$(NexaCompilerSourceRoot)" MappedPath="/_/" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0" PrivateAssets="all" />
    <PackageReference Include="Mono.Cecil" Version="0.11.6" PrivateAssets="all" />
  </ItemGroup>
</Project>
